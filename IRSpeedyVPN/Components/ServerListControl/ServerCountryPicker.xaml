<UserControl x:Class="IRSpeedyVPN.Components.ServerListControl.ServerCountryPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!--
        Face = a verbatim clone of the implicit ComboBox template visuals:
        same Height=40, same outer LightGray frame, same inner rounded panel whose
        single left edge draws the curved separator next to the arrow, same arrow
        glyph + Black fill, same font metrics. LTR on the root so columns and the
        1,0,0,0 border never mirror; the text itself is RTL inside.
    -->
    <Grid x:Name="root" Height="40" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- outer frame (ComboBoxToggleButton outer Border) -->
        <Border Grid.ColumnSpan="2" CornerRadius="10"
                Background="White" BorderBrush="LightGray" BorderThickness="1"/>

        <!-- inner panel on the text side: CornerRadius+Margin=1 makes its left edge
             render as the curved separator line you see beside the arrow -->
        <Border Grid.Column="1" CornerRadius="10" Margin="1"
                Background="White" BorderBrush="Black" BorderThickness="1,0,0,0"/>

        <!-- arrow, left column (same glyph + fill as the template) -->
        <Path Grid.Column="0" Data="{StaticResource ComboArrow}" Fill="Black"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- selected text, right aligned, identical font to the form's ComboBoxes -->
        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="10,3,12,3" FlowDirection="RightToLeft">
            <TextBlock x:Name="faceText" FontSize="14"
                       FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
            <Path x:Name="faceBolt" Data="{StaticResource IconBolt}" Fill="#F59E0B"
                  Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0"
                  VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

        <!-- transparent toggle over the whole face. ClickMode=Press fixes the
             close/reopen race (clicking the open control only closes it). -->
        <ToggleButton Grid.ColumnSpan="2"
                      x:Name="btnToggle" Focusable="False" Cursor="Hand"
                      ClickMode="Press"
                      Checked="BtnToggle_Checked" Unchecked="BtnToggle_Unchecked">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" CornerRadius="10"/>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- ═══ Dropdown (card list) ═══ -->
        <Popup Grid.ColumnSpan="2"
               x:Name="popup" PlacementTarget="{Binding ElementName=root}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Slide"
               MinWidth="{Binding ActualWidth, ElementName=root}"
               Closed="Popup_Closed">
            <Border Background="White" CornerRadius="12" BorderBrush="#888888"
                    BorderThickness="1" Margin="0,4,0,0" MaxHeight="360"
                    MouseLeftButtonUp="OnListClick">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl x:Name="icCountries" Focusable="False"
                                  ItemTemplateSelector="{StaticResource CountryPickerSelector}"/>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>