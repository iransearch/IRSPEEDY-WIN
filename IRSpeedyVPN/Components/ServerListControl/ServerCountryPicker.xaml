<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Class="IRSpeedyVPN.Components.ServerListControl.ServerCountryPicker" mc:Ignorable="d" Loaded="Picker_Loaded" Unloaded="Picker_Unloaded" IsVisibleChanged="Picker_IsVisibleChanged" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}">
  <UserControl.Resources>
  <DrawingImage x:Key="Mosaic.SmartSelection">
    <DrawingImage.Drawing>
      <DrawingGroup ClipGeometry="M0,0 H140 V58 H0 Z">
        <DrawingGroup>
          <DrawingGroup.ClipGeometry><PathGeometry Figures="M -20,0 L 40,0 26,58 -34,58 Z"/></DrawingGroup.ClipGeometry>
          <GeometryDrawing Brush="#239F40">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="-40,0,100,19.4"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFFFFF">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="-40,19.4,100,19.3"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#DA0000">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="-40,38.7,100,19.3"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
          <DrawingGroup.ClipGeometry><PathGeometry Figures="M 40,0 L 74,0 60,58 26,58 Z"/></DrawingGroup.ClipGeometry>
          <GeometryDrawing Brush="#E30A17">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="20,0,80,58"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <DrawingGroup>
            <DrawingGroup.Transform><MatrixTransform Matrix="1.25,0,0,1.25,26.25,5.25"/></DrawingGroup.Transform>
            <GeometryDrawing Brush="#FFFFFF">
              <GeometryDrawing.Geometry><EllipseGeometry Center="16.5,19" RadiusX="8" RadiusY="8"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#E30A17">
              <GeometryDrawing.Geometry><EllipseGeometry Center="19,19" RadiusX="6.6" RadiusY="6.6"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#FFFFFF">
              <GeometryDrawing.Geometry><PathGeometry Figures="M 24,13.5 L 25.3,17.2 29.2,17.3 26.1,19.6 27.2,23.3 24,21.1 20.8,23.3 21.9,19.6 18.8,17.3 22.7,17.2 Z"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingGroup>
        <DrawingGroup>
          <DrawingGroup.ClipGeometry><PathGeometry Figures="M 74,0 L 108,0 94,58 60,58 Z"/></DrawingGroup.ClipGeometry>
          <GeometryDrawing Brush="#141414">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="60,0,80,19.4"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#D0021B">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="60,19.4,80,19.3"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#F5C518">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="60,38.7,80,19.3"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
          <DrawingGroup.ClipGeometry><PathGeometry Figures="M 108,0 L 160,0 146,58 94,58 Z"/></DrawingGroup.ClipGeometry>
          <GeometryDrawing Brush="#C8102E">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="100,0,90,19.4"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFFFFF">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="100,19.4,90,19.3"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#21468B">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="100,38.7,90,19.3"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><PathGeometry Figures="M 40 0 L 26 58 M 74 0 L 60 58 M 108 0 L 94 58"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="3"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
    <!-- Scoped to the server list: a transparent rail and a rounded 6-DIP thumb. -->
    <Style x:Key="ServerScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ServerScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="grip" Width="6" CornerRadius="3" Background="#D7DBE3" Opacity="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="grip" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="grip" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ServerScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ServerScrollPage}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ServerScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ServerScrollPage}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ServerScrollViewer" TargetType="ScrollViewer">
      <Setter Property="CanContentScroll" Value="False"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <!-- Explicit physical columns keep the rail on the left in RTL. -->
            <Grid FlowDirection="LeftToRight">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="1" ClipToBounds="True" FlowDirection="RightToLeft" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="0" Margin="0" HorizontalAlignment="Left" Style="{StaticResource ServerScrollBar}" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The whole card supports mouse, keyboard and assistive technology. -->
    <Style x:Key="ServerCardButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#0D1E2D5A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="CardSurface" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Border.Effect><DropShadowEffect Color="#172340" Opacity="0.10" BlurRadius="10" ShadowDepth="3" Direction="270"/></Border.Effect>
              </Border>
              <Border BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="#F3F5F9"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="root" FlowDirection="LeftToRight">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="SmartCardHost" Margin="0,0,0,12" IsVisibleChanged="Picker_IsVisibleChanged">
      <Button x:Name="smartCard" FontFamily="{StaticResource AppFontFamily}" Height="82" FlowDirection="RightToLeft" Cursor="Hand" Click="SmartCard_Click" SizeChanged="SmartCard_SizeChanged" AutomationProperties.Name="انتخاب هوشمند">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border BorderBrush="#C9DBFB" BorderThickness="1" CornerRadius="14">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EFF5FF" Offset="0"/><GradientStop Color="#E6F0FE" Offset="1"/></LinearGradientBrush></Border.Background>
              <ContentPresenter Margin="12,0"/>
            </Border>
          </ControlTemplate>
        </Button.Template>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />  <!-- radio (physical right) -->
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />   <!-- title + subtitle -->
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="140" /> <!-- flag mosaic (physical left) -->
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
<Ellipse Stroke="#D9DEE7" StrokeThickness="1.5"/>
<Grid x:Name="smartCheck" Margin="-4" Visibility="Collapsed"><Ellipse Fill="White" Stroke="#C9DBFB" StrokeThickness="1"/><Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}"/></Grid>
</Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="انتخاب هوشمند" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontSize="14" Foreground="#142057" VerticalAlignment="Center" />
                    <Path Data="M13 2L4.5 13.5H11L9.5 22L19.5 9.5H13L13 2Z" Fill="#F5B301" Width="16" Height="16" Stretch="Uniform" FlowDirection="LeftToRight" Margin="5,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="بهترین سرور بر اساس موقعیت شما" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                             FontFamily="{StaticResource AppFontFamily}" FontSize="11" Foreground="#5B6BA8" />
                </StackPanel>

                <!-- FLAG MOSAIC 140x58: one rounded rectangle cut diagonally into Iran · Turkey · Germany · Netherlands -->
                <Grid Grid.Column="4" Width="140" Height="58" FlowDirection="LeftToRight" RenderTransformOrigin="0.5,0.5">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
                      <Style.Triggers>
                        <!-- hover on the card → mosaic grows 3% -->
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03" /></Setter.Value></Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>

                  <!-- shadow + hairline: 0 0 0 1px rgba(16,24,40,.08), 0 8px 16px -8px rgba(30,58,138,.45) -->
                  <Border CornerRadius="12" Background="White" BorderBrush="#14101828" BorderThickness="1">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="14" ShadowDepth="5" Direction="270" Opacity="0.35" Color="#1E3A8A" />
                    </Border.Effect>
                  </Border>

                  <!-- flags + sheen, clipped to the rounded rectangle -->
                  <Grid>
                    <Grid.Clip>
                      <RectangleGeometry Rect="0,0,140,58" RadiusX="12" RadiusY="12" />
                    </Grid.Clip>
                    <Image Source="{StaticResource Mosaic.SmartSelection}" Stretch="Fill" />

                    <!-- diagonal sheen: skew -14°, sweeps left → right in the first 55% of every 3.2s -->
                    <Rectangle Width="34" Margin="0,-10" HorizontalAlignment="Left" IsHitTestVisible="False">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#00FFFFFF" Offset="0" />
                          <GradientStop Color="#8CFFFFFF" Offset="0.5" />
                          <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                      <Rectangle.RenderTransform>
                        <TransformGroup>
                          <SkewTransform AngleX="-14" CenterY="39" />
                          <TranslateTransform x:Name="SmartMosaicShift" X="-60" />
                        </TransformGroup>
                      </Rectangle.RenderTransform>

                    </Rectangle>
                  </Grid>
                </Grid>
              </Grid>
      </Button>
      <Path x:Name="SmartCardShine" FlowDirection="LeftToRight" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" IsHitTestVisible="False">
        <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0060A5FA" Offset="0"/><GradientStop Color="White" Offset="0.5"/><GradientStop Color="#002563EB" Offset="1"/></LinearGradientBrush></Path.Stroke>
      </Path>
    </Grid>
    <!-- The 6-DIP rail sits outside the cards, with a fixed left gutter. -->
    <ScrollViewer x:Name="ServerScroller" Grid.Row="1" Margin="-4,0,0,0" Style="{StaticResource ServerScrollViewer}" Padding="0" Focusable="False">
      <ItemsControl x:Name="icCountries" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource ServerCardButton}" Height="52" Margin="0,0,0,8" IsEnabled="{Binding IsSelectable}" Click="Row_Click" AutomationProperties.Name="{Binding CountryName}" AutomationProperties.HelpText="{Binding SignalText}">
              <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="3" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Ellipse Stroke="#D9DEE7" StrokeThickness="1.5"/>
                  <Grid Margin="-4">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelectedCountry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Ellipse Fill="White" Stroke="#C9DBFB" StrokeThickness="1"/>
                    <Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}"/>
                  </Grid>
                </Grid>
                <Grid Grid.Column="2" Width="30" Height="30" FlowDirection="LeftToRight">
                  <Ellipse Fill="#F3F5F9" Stroke="#0D101828" StrokeThickness="1"/>
                  <Ellipse>
                    <Ellipse.Fill><ImageBrush ImageSource="{Binding FlagSource}" Stretch="UniformToFill"/></Ellipse.Fill>
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFlag}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource AppFontFamilySemiBold}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasFlag}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <!-- Same diagonal white sheen as the smart flag, only while this row is probing. -->
                  <Grid IsHitTestVisible="False">
                    <Grid.Clip><EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/></Grid.Clip>
                    <Rectangle Width="12" Margin="0,-10" HorizontalAlignment="Left" Loaded="ProbeShine_Changed" Unloaded="ProbeShine_Unloaded" IsVisibleChanged="ProbeShine_VisibilityChanged">
                      <Rectangle.Style><Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsChecking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style></Rectangle.Style>
                      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#8CFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                      </LinearGradientBrush></Rectangle.Fill>
                      <Rectangle.RenderTransform><TransformGroup><SkewTransform AngleX="-14" CenterY="25"/><TranslateTransform X="-20"/></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                  </Grid>
                </Grid>
                <TextBlock Grid.Column="1" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource AppFontFamilySemiBold}" FontSize="14" Foreground="#1B2033" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0" ToolTip="{Binding CountryName}"><Run FlowDirection="RightToLeft" Text="{Binding CountryName}"/></TextBlock>
                <StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{Binding SignalBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <StackPanel ToolTip="{Binding SignalToolTip}">
                    <TextBlock Text="{Binding SignalText}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding SignalBrush}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="EmptyResults" Grid.Row="1" Text="سروری پیدا نشد" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid>
</UserControl>
