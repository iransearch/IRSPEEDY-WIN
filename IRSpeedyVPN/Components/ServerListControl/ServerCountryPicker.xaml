<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Class="IRSpeedyVPN.Components.ServerListControl.ServerCountryPicker" mc:Ignorable="d" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}">
    <UserControl.Resources>
        <!-- Scoped to the server list: a transparent rail and a rounded 5-DIP thumb. -->
        <Style x:Key="ServerScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border Background="Transparent"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ServerScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                    <Border x:Name="grip" Width="5" CornerRadius="2.5" Background="#757D8C" Opacity="0.5"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="grip" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="grip" Property="Opacity" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ServerScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ServerScrollPage}"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ServerScrollThumb}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ServerScrollPage}"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ServerScrollViewer" TargetType="ScrollViewer">
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
                <!-- Explicit physical columns keep the rail on the left in RTL. -->
                <Grid FlowDirection="LeftToRight" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="1" FlowDirection="RightToLeft"
                        Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="0" Style="{StaticResource ServerScrollBar}"
                        Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}"
                        ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>


    <!-- Physical columns are LTR; Persian Run content is RTL. This keeps the
         right-aligned text edge stable without mirroring the text container. -->
    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Smart Location card ═══ -->
        <Border x:Name="smartCard" Grid.Row="0" Height="60" CornerRadius="14" BorderThickness="1" Margin="0,0,0,12" Background="{StaticResource SmartLocationBackgroundBrush}" BorderBrush="{StaticResource SmartLocationBorderBrush}" Cursor="Hand" MouseLeftButtonUp="SmartCard_MouseLeftButtonUp">
            <Grid Margin="12,0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="2" Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBolt}" Fill="White" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" FlowDirection="LeftToRight" Margin="10,0">
                    <TextBlock FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" FontSize="{StaticResource FontSizeCardTitle}" Foreground="{StaticResource SmartLocationTitleBrush}" TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Stretch"><Run FlowDirection="RightToLeft" Text="موقعیت هوشمند"/></TextBlock>
                    <TextBlock FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMuted}" Foreground="{StaticResource SmartLocationSubtitleBrush}" TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" Margin="0,2,0,0"><Run FlowDirection="RightToLeft" Text="سریع‌ترین سرور، انتخاب خودکار"/></TextBlock>
                </StackPanel>

                <!-- selection ring, same visual language as the row radio -->
                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                    <Ellipse Width="20" Height="20" Stroke="{StaticResource RadioBorderBrush}" StrokeThickness="2"/>
                    <Ellipse x:Name="smartCheck" Width="11" Height="11" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ Country rows (scrollable) ═══ -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ServerScrollViewer}" Padding="0,0,2,0">
            <ItemsControl x:Name="icCountries" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Tag="{Binding}" CornerRadius="{StaticResource RowCornerRadius}" Margin="0,0,0,4" Padding="8,12" Cursor="{Binding RowCursor}" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- Flag: 38x38 circle, hairline ring, falls back to an initials
                                     badge when the country has no bundled flag asset. -->
                                <Grid Grid.Column="3" Width="38" Height="38" FlowDirection="LeftToRight">
                                    <Ellipse Width="38" Height="38" Stroke="#0F101827" StrokeThickness="1" Fill="#F3F5F9"/>
                                    <Ellipse Width="36" Height="36">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding FlagSource}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFlag}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource AppFontFamilySemiBold}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFlag}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Label -->
                                <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource AppFontFamilySemiBold}" FontSize="{StaticResource FontSizeRow}" Foreground="{StaticResource RowTitleBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="14,0"><Run FlowDirection="RightToLeft" Text="{Binding CountryName}"/></TextBlock>

                                <!-- Latency -->
                                <TextBlock Grid.Column="1" Text="{Binding SignalText}" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PingGoodBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                                <!-- Selector -->
                                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse Width="20" Height="20" Stroke="{StaticResource RadioBorderBrush}" StrokeThickness="2"/>
                                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentBrush}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedCountry}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
