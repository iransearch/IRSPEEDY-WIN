<UserControl x:Class="IRSpeedyVPN.Components.ServerListControl.ServerCountryPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!--
        Inline server list per the DESIGN-SPEC handoff (§3 "Server list"):
        the Smart Location card is a fixed block on top, the country rows
        scroll underneath it. No dropdown/popup any more — both are always
        visible inside the content column. FlowDirection follows the window
        (RTL); this root stays LTR-neutral, individual text runs set their
        own alignment.
    -->
    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Smart Location card ═══ -->
        <Border x:Name="smartCard" Grid.Row="0" Height="60"
                CornerRadius="14" BorderThickness="1" Margin="0,0,0,12"
                Background="{StaticResource SmartLocationBackgroundBrush}"
                BorderBrush="{StaticResource SmartLocationBorderBrush}"
                Cursor="Hand" MouseLeftButtonUp="SmartCard_MouseLeftButtonUp">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                        Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBolt}" Fill="White" Stretch="Uniform"
                          Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" >
                    <TextBlock Text="موقعیت هوشمند" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeCardTitle}" Foreground="{StaticResource SmartLocationTitleBrush}"
                               TextAlignment="Right"/>
                    <TextBlock Text="سریع‌ترین سرور، انتخاب خودکار" FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeMuted}" Foreground="{StaticResource SmartLocationSubtitleBrush}"
                               TextAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- selection ring, same visual language as the row radio -->
                <Grid Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center">
                    <Ellipse Width="20" Height="20" Stroke="{StaticResource RadioBorderBrush}" StrokeThickness="2"/>
                    <Ellipse x:Name="smartCheck" Width="11" Height="11" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ Country rows (scrollable) ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
            <ItemsControl x:Name="icCountries" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Tag="{Binding}" CornerRadius="{StaticResource RowCornerRadius}"
                                Margin="0,0,0,4" Padding="8,12" Cursor="{Binding RowCursor}"
                                MouseLeftButtonUp="Row_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- Flag: 38x38 circle, hairline ring, falls back to an initials
                                     badge when the country has no bundled flag asset. -->
                                <Grid Grid.Column="0" Width="38" Height="38">
                                    <Ellipse Width="38" Height="38" Stroke="#0F101827" StrokeThickness="1" Fill="#F3F5F9"/>
                                    <Ellipse Width="36" Height="36">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding FlagSource}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFlag}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource AppFontFamilySemiBold}"
                                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFlag}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Label -->
                                <TextBlock Grid.Column="1" Text="{Binding CountryName}"
                                           FontFamily="{StaticResource AppFontFamilySemiBold}"
                                           FontSize="{StaticResource FontSizeRow}" Foreground="{StaticResource RowTitleBrush}"
                                           TextAlignment="Right" VerticalAlignment="Center" Margin="14,0"/>

                                <!-- Latency -->
                                <TextBlock Grid.Column="2" Text="{Binding SignalText}"
                                           FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold"
                                           FontSize="13" Foreground="{StaticResource PingGoodBrush}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Selector -->
                                <Grid Grid.Column="3" Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse Width="20" Height="20" Stroke="{StaticResource RadioBorderBrush}" StrokeThickness="2"/>
                                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentBrush}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedCountry}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
