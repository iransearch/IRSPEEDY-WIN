<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:IRSpeedyVPN" xmlns:uc="clr-namespace:IRSpeedyVPN.UserControls" xmlns:transc="clr-namespace:Transitionals.Controls;assembly=Transitionals" xmlns:trans="clr-namespace:Transitionals;assembly=Transitionals" xmlns:transt="clr-namespace:Transitionals.Transitions;assembly=Transitionals" xmlns:refl="clr-namespace:System.Reflection;assembly=mscorlib" x:Class="IRSpeedyVPN.MainWindow" FontFamily="{StaticResource AppFontFamily}" Activated="Window_Activated" TextElement.FontWeight="Normal" TextElement.FontSize="13" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStyle="None" WindowStartupLocation="CenterScreen" Width="420" Height="700" Background="{StaticResource WindowBackgroundFallbackBrush}" AllowsTransparency="False" Title="IRSPEEDY" Icon="pack://application:,,,/Resources/Irspeedy/Logo/irspeedy.ico" ResizeMode="NoResize" FlowDirection="RightToLeft" SizeToContent="Manual">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>

        </ResourceDictionary>
  </Window.Resources>
  <!--
        Opaque 420x700 window. Native chrome provides rounded corners without
        a layered transparent window or a Mica/Acrylic backdrop.
    -->
  <Border CornerRadius="{StaticResource WindowCornerRadius}" Background="{StaticResource WindowBackgroundFallbackBrush}" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <!-- GridLength can't consume the HeaderHeight double resource directly —
                     kept in sync with IrspeedyTheme.xaml's HeaderHeight (56). -->
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- ══════════════════ Header (§2) ══════════════════ -->
      <Grid Grid.Row="0" Margin="12,0,18,0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="24"/>
        </Grid.ColumnDefinitions>
        <!-- Logo + title + version. Stays LTR internally so the wordmark and
                     version digits don't reverse; the group itself still mirrors with
                     the rest of the header under the window's RTL flow direction. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Grid.Column="1" Margin="10,0,0,0">
          <StackPanel.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="accountMenu" Header="تغییر رمز عبور" Click="AccountMenu_Click"/>
            </ContextMenu>
          </StackPanel.ContextMenu>
          <TextBlock Text="IRSPEEDY" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0"/>
          <TextBlock x:Name="txtVersion" Text="1.0.0.1" FontFamily="{StaticResource AppFontFamilyMedium}" FontSize="{StaticResource FontSizeVersion}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,3,0,0" FlowDirection="LeftToRight"/>
        </StackPanel>
        <!-- Kept for code compatibility (Login sets it); no longer part of the
                     visible header per the new design. -->
        <TextBlock x:Name="txtUsername" Text="" Visibility="Collapsed"/>
        <TextBlock x:Name="lblPremium" Text="PREMIUM" Visibility="Collapsed"/>
        <TextBlock x:Name="txtGlobalMessage" Text="برای عملکرد صحیح برنامه، نسخه دات نت را به 4.8 ارتقا دهید" Foreground="Salmon" Visibility="Hidden" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <!-- Contextual service icons + settings + divider + window controls. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" FlowDirection="LeftToRight">
          <Border Width="30" Height="30" CornerRadius="8" Background="Transparent" Cursor="Hand" MouseDown="Exit_PreviewMouseDown" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="2000" ToolTipService.BetweenShowDelay="10000" ToolTip="خروج">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HeaderHoverBrush}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="12" Height="12" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.4"/>
          </Border>
          <Border Width="30" Height="30" CornerRadius="8" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Minimize_MouseLeftButtonDown" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="2000" ToolTipService.BetweenShowDelay="10000" ToolTip="کوچک کردن">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HeaderHoverBrush}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Path Data="{StaticResource IconMinimize}" Stretch="Uniform" Width="12" Height="12" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.4"/>
          </Border>
          <Border Width="1" Height="18" Background="{StaticResource DividerBrush}" Margin="8,0" VerticalAlignment="Center"/>
          <Border x:Name="btnSettings" Width="30" Height="30" CornerRadius="8" Background="Transparent" Visibility="Collapsed" Cursor="Hand" PreviewMouseDown="btnSettings_MouseDown" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="2000" ToolTipService.BetweenShowDelay="10000" ToolTip="تنظیمات">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HeaderHoverBrush}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Path Data="{StaticResource IconGear}" Stretch="Uniform" Width="16" Height="16" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3"/>
          </Border>
          <StackPanel x:Name="panelHeaderIcons" Orientation="Horizontal"/>
        </StackPanel>
        <Image Source="pack://application:,,,/Resources/Irspeedy/Logo/logo-header.png" Width="24" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Grid.Column="2"/>
      </Grid>
      <!-- ══════════════════ Content ══════════════════ -->
      <Grid Grid.Row="1">
        <TextBlock x:Name="lblCtrlTitle" Text="" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,6,18,0" VerticalAlignment="Top"/>
        <transc:TransitionElement x:Name="TransitionBox" Panel.ZIndex="0">
                </transc:TransitionElement>
      </Grid>
      <!-- Overlays: loading, error banner, hint popup. Span the whole window,
                 same as the old header-anchored hack, but expressed directly now that
                 there is a real content row to span. -->
      <uc:UCConnecting x:Name="uCConnecting" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="9"/>
      <uc:UCLoading x:Name="uCLoading" Grid.Row="0" Grid.RowSpan="2" Visibility="Hidden" Panel.ZIndex="10"/>
      <TextBlock Grid.Row="1" x:Name="lblErrorMessage" Text="" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Visibility="Hidden" Foreground="Red" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Top" Margin="0,8,0,0" Panel.ZIndex="5"/>
      <Popup Grid.Row="1" x:Name="popHint" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
        <Border Background="#1F2B57" CornerRadius="12" Padding="10,6" Opacity="1">
          <TextBlock x:Name="txtHintMessage" Text="" Foreground="White" FontSize="13" FontWeight="Bold"/>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
