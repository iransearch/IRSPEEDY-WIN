<Window x:Class="IRSpeedyVPN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:uc="clr-namespace:IRSpeedyVPN.UserControls" xmlns:transc="clr-namespace:Transitionals.Controls;assembly=Transitionals" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="IRSpeedy VPN" Icon="pack://application:,,,/Logo-v2.ico" Width="500" Height="840" MinWidth="420" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#EAF4FF" Activated="Window_Activated" FontFamily="{StaticResource Vazir}" FontSize="14" Foreground="{StaticResource InkBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="20" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border CornerRadius="20" BorderBrush="#D7E6FA" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F8FCFF" Offset="0"/><GradientStop Color="#E5F1FF" Offset="0.6"/><GradientStop Color="#CEE5FF" Offset="1"/></LinearGradientBrush></Grid.Background>
   <Viewbox Stretch="Fill" IsHitTestVisible="False" Opacity="0.6"><Canvas Width="500" Height="840" ClipToBounds="True">
    <Path Fill="#C9E1FF" Data="M0,0 L160,0 C148,128 71,188 0,217 Z"/>
    <Path Fill="#EAF5FF" Data="M0,0 L105,0 C87,77 52,109 0,123 Z"/>
    <Path Fill="#BFDFFF" Data="M500,270 C343,296 390,443 243,477 C110,513 172,674 0,705 L0,840 L500,840 Z" Opacity="0.5"><Path.Effect><BlurEffect Radius="10"/></Path.Effect></Path>
    <Path Fill="#F5FBFF" Data="M500,370 C351,399 391,557 198,633 C111,671 170,783 0,806 L0,840 L500,840 Z" Opacity="0.65"/>
   </Canvas></Viewbox>
   <Grid Margin="22,8,22,10">
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="156"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseDown="Header_MouseDown">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
      <StackPanel x:Name="panelHeaderIcons" Orientation="Horizontal"/>
      <Button x:Name="btnSettings" Style="{StaticResource FluentIconButton}" Content="&#xE713;" ToolTip="تغییر رمز" AutomationProperties.Name="تغییر رمز" Visibility="Collapsed" PreviewMouseDown="btnSettings_MouseDown"/>
      <Button Style="{StaticResource FluentIconButton}" Content="&#xE8AC;" ToolTip="خروج از حساب" AutomationProperties.Name="خروج از حساب" PreviewMouseDown="Logout_PreviewMouseDown"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock x:Name="txtVersion" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>
      <Button Style="{StaticResource FluentIconButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="کوچک کردن"/>
      <Button Style="{StaticResource FluentIconButton}" Content="&#xE8BB;" PreviewMouseDown="Exit_PreviewMouseDown" AutomationProperties.Name="خروج"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" MouseDown="Header_MouseDown">
     <Image Source="{StaticResource Logo}" Width="90" Height="94" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock Text="IRSPEEDY" FontFamily="Segoe UI" FontWeight="Bold" FontSize="27" HorizontalAlignment="Center"/>
     <TextBlock Text="اتصال سریع‌تر، دنیای گسترده‌تر" FontSize="13" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <TextBlock x:Name="lblErrorMessage" Visibility="Collapsed" Foreground="#E53935" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4"/>
     <TextBlock x:Name="txtGlobalMessage" Visibility="Collapsed" Foreground="#9B5100" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="lblCtrlTitle" Visibility="Collapsed"/><TextBlock x:Name="lblPremium" Visibility="Collapsed" Text="PREMIUM"/>
    </StackPanel>
    <Grid Grid.Row="3">
     <transc:TransitionElement x:Name="TransitionBox" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <uc:UCLoading x:Name="uCLoading" Visibility="Hidden" Panel.ZIndex="10"/>
    </Grid>
    <Grid Grid.Row="4" Margin="2,6,2,0"><TextBlock Text="Windows App 1.4.5.8" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="txtUsername" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}"/></Grid>
   </Grid>
   <Popup x:Name="popHint" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"><Border Background="#122653" CornerRadius="10" Padding="12,8"><TextBlock x:Name="txtHintMessage" Foreground="White" FontFamily="{StaticResource Vazir}"/></Border></Popup>
  </Grid>
 </Border>
</Window>