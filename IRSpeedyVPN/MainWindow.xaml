<Window xmlns:uiScale="clr-namespace:IRSpeedyVPN.Common" uiScale:WindowUiScale.Factor="{StaticResource UiScale}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:IRSpeedyVPN" xmlns:uc="clr-namespace:IRSpeedyVPN.UserControls" xmlns:transc="clr-namespace:Transitionals.Controls;assembly=Transitionals" xmlns:trans="clr-namespace:Transitionals;assembly=Transitionals" xmlns:transt="clr-namespace:Transitionals.Transitions;assembly=Transitionals" xmlns:refl="clr-namespace:System.Reflection;assembly=mscorlib" x:Class="IRSpeedyVPN.MainWindow" FontFamily="{StaticResource AppFontFamily}" Activated="Window_Activated" TextElement.FontWeight="Normal" TextElement.FontSize="13" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStyle="None" WindowStartupLocation="CenterScreen" Width="420" Height="700" Background="{DynamicResource WindowBackgroundFallbackBrush}" AllowsTransparency="False" Title="IRSPEEDY" Icon="pack://application:,,,/Resources/Irspeedy/Logo/irspeedy.ico" ResizeMode="NoResize" FlowDirection="RightToLeft" SizeToContent="Manual" Foreground="{DynamicResource TextBodyBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>

        </ResourceDictionary>
  </Window.Resources>
  <!--
        Opaque 420x700 window. Native chrome provides rounded corners without
        a layered transparent window or a Mica/Acrylic backdrop.
    -->
  <Viewbox Stretch="Uniform" StretchDirection="Both" FlowDirection="LeftToRight" x:Name="DesignViewport">
    <Border CornerRadius="{StaticResource WindowCornerRadius}" Background="{DynamicResource WindowBackgroundFallbackBrush}" ClipToBounds="True" Width="420" Height="700" FlowDirection="RightToLeft">
      <Grid>
        <Grid.RowDefinitions>
          <!-- GridLength can't consume the HeaderHeight double resource directly —
                     kept in sync with IrspeedyTheme.xaml's HeaderHeight (56). -->
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ══════════════════ Header (§2) ══════════════════ -->
        <Grid Grid.Row="0" Margin="12,0,18,0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" FlowDirection="LeftToRight">
          <Grid.ColumnDefinitions>
            <!-- Fixed window controls, divider and primary service action. -->
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="21"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <!-- Contextual actions cannot change the title's origin. -->
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="24"/>
          </Grid.ColumnDefinitions>
          <!-- Title and version have a fixed origin, independent of page actions.
               LTR keeps the wordmark and version digits in their normal order. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="LeftToRight" Grid.Column="3" Margin="0">
            <StackPanel.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="settingsMenu" Header="تنظیمات سرویس" Click="SettingsMenu_Click"/><MenuItem x:Name="accountMenu" Header="تغییر رمز عبور" Click="AccountMenu_Click"/>
              </ContextMenu>
            </StackPanel.ContextMenu>
            <TextBlock Text="IRSPEEDY" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0"/>
            <TextBlock x:Name="txtVersion" Text="1.0.0.1" FontFamily="{StaticResource AppFontFamilyMedium}" FontSize="{StaticResource FontSizeVersion}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,3,0,0" FlowDirection="LeftToRight"/>
          </StackPanel>
          <!-- Kept for code compatibility (Login sets it); no longer part of the
                     visible header per the new design. -->
          <TextBlock x:Name="txtUsername" Text="" Visibility="Collapsed"/>
          <TextBlock x:Name="lblPremium" Text="PREMIUM" Visibility="Collapsed"/>
          <TextBlock x:Name="txtGlobalMessage" Text="برای عملکرد صحیح برنامه، نسخه دات نت را به 4.8 ارتقا دهید" Foreground="Salmon" Visibility="Collapsed" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.ColumnSpan="6" TextWrapping="Wrap" MaxWidth="360"/>
          <!-- Window controls keep the same horizontal and vertical positions. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" FlowDirection="LeftToRight">
            <Border Width="30" Height="30" CornerRadius="8" Cursor="Hand" MouseDown="Exit_PreviewMouseDown" Margin="0,0,10,0" AutomationProperties.Name="بستن پنجره" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="2000" ToolTipService.BetweenShowDelay="10000" ToolTip="خروج">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.4"/>
            </Border>
            <Border Width="30" Height="30" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="Minimize_MouseLeftButtonDown" AutomationProperties.Name="کوچک کردن پنجره" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="2000" ToolTipService.BetweenShowDelay="10000" ToolTip="کوچک کردن">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Path Data="{StaticResource IconMinimize}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.4"/>
            </Border>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="HeaderDivider" Visibility="Collapsed"/>
          <!-- Legacy account settings share the primary slot only on pages where
               service actions are hidden; their visibility remains controlled in code. -->
          <Border Grid.Column="2" x:Name="btnSettings" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="8" Background="Transparent" Visibility="Collapsed" Cursor="Hand" PreviewMouseDown="btnSettings_MouseDown" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="2000" ToolTipService.BetweenShowDelay="10000" ToolTip="تنظیمات">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Path Data="{StaticResource IconGear}" Stretch="Uniform" Width="16" Height="16" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3"/>
            </Border>
          <!-- Keep one visibility owner for both service-action areas. Fixed slots
               reserve space even while login/connection animation hides the actions. -->
          <Grid x:Name="panelHeaderIcons" Grid.Column="2" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Center" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="panelHeaderPrimaryIcons" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left"/>
            <StackPanel x:Name="panelHeaderSecondaryIcons" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"/>
          </Grid>
          <!-- Login appearance is a header action, outside the page transition
               and the service-only action group. Its slot stays beside the logo. -->
          <ToggleButton x:Name="LoginThemeToggle" Grid.Column="4" Panel.ZIndex="1"
                        Style="{StaticResource AppearanceToggle}" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        IsEnabled="{Binding IsEnabled, ElementName=TransitionBox}"/>
          <Image Source="pack://application:,,,/Resources/Irspeedy/Logo/logo-server-list.png" Width="24" Height="32" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Grid.Column="5"/>
        </Grid>
        <!-- ══════════════════ Content ══════════════════ -->
        <Grid Grid.Row="1">
          <TextBlock x:Name="lblCtrlTitle" Text="" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,6,18,0" VerticalAlignment="Top"/>
          <transc:TransitionElement x:Name="TransitionBox" Panel.ZIndex="0">
                </transc:TransitionElement>
        </Grid>
        <!-- Overlays: loading, error banner, hint popup. Span the whole window,
                 same as the old header-anchored hack, but expressed directly now that
                 there is a real content row to span. -->
        <uc:UCLoginLoading x:Name="uCLoginLoading" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="11"/>
        <uc:UCConnecting x:Name="uCConnecting" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="9"/>
        <uc:UCLoading x:Name="uCLoading" Grid.Row="0" Grid.RowSpan="2" Visibility="Hidden" Panel.ZIndex="10"/>
        <TextBlock Grid.Row="1" x:Name="lblErrorMessage" Text="" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Visibility="Hidden" Foreground="{DynamicResource Theme.LegacyRedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Top" Margin="0,8,0,0" Panel.ZIndex="5"/>
        <Popup Grid.Row="1" x:Name="popHint" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
          <Border Background="{DynamicResource Theme.HintSurfaceBrush}" CornerRadius="12" Padding="10,6" Opacity="1">
            <TextBlock x:Name="txtHintMessage" Text="" Foreground="White" FontSize="13" FontWeight="Bold"/>
          </Border>
        </Popup>
      </Grid>
    </Border>
  </Viewbox>
</Window>
