<Window x:Class="IRSpeedyVPN.Windows.DeviceLimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uiScale="clr-namespace:IRSpeedyVPN.Common"
        uiScale:WindowUiScale.Factor="{StaticResource UiScale}"
        Title="مدیریت دستگاه‌ها" Width="376" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontFamily="pack://application:,,,/Resources/#B Yekan+"
        FontWeight="Bold" Foreground="{DynamicResource TextBodyBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Geometry x:Key="DeviceGlyph">M18,8 V6 A2,2 0 0 0 16,4 H4 A2,2 0 0 0 2,6 V13 A2,2 0 0 0 4,15 H12 M10,15 V19 M7,19 H12 M18,12 H20 A2,2 0 0 1 22,14 V20 A2,2 0 0 1 20,22 H18 A2,2 0 0 1 16,20 V14 A2,2 0 0 1 18,12 Z</Geometry>
        <Geometry x:Key="DeviceTrashGlyph">M3,6 H21 M8,6 V4 A1,1 0 0 1 9,3 H15 A1,1 0 0 1 16,4 V6 M5,6 V19 A2,2 0 0 0 7,21 H17 A2,2 0 0 0 19,19 V6 M10,10 V17 M14,10 V17</Geometry>
        <Style x:Key="DeviceButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="54"/>
            <Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.DangerBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.RemoveHoverBg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Theme.DangerBorderBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Width="376" Margin="0,8">
        <Border x:Name="DeviceCard" Margin="8,0" CornerRadius="20" Padding="20"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,18" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <Button x:Name="btnClose" Grid.Column="0" Style="{StaticResource DeviceButton}"
                            Width="28" MinWidth="28" Height="28" Padding="0"
                            Background="{DynamicResource Brush.SurfaceSoft}" Foreground="{DynamicResource IconStrokeBrush}"
                            AutomationProperties.Name="بستن مدیریت دستگاه‌ها" ToolTip="بستن" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.5"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="مدیریت دستگاه‌ها" FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               TextAlignment="Right" FlowDirection="RightToLeft" Margin="10,0"/>
                    <Border Grid.Column="2" Width="36" Height="36" CornerRadius="11" Background="{DynamicResource SmartLocationBackgroundBrush}">
                        <Path Data="{StaticResource DeviceGlyph}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                              Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Border x:Name="WarningNotice" CornerRadius="12" Padding="12" Margin="0,0,0,16"
                        Background="{DynamicResource Theme.WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.WarningBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="17" Height="17" VerticalAlignment="Center" FlowDirection="LeftToRight">
                            <Ellipse Stroke="{DynamicResource Theme.WarningTextBrush}" StrokeThickness="1.5"/>
                            <TextBlock Text="!" Foreground="{DynamicResource Theme.WarningTextBrush}" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Viewbox Grid.Column="1" Margin="0,0,9,0" Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="txtMessage" FontSize="13" TextWrapping="NoWrap" Foreground="{DynamicResource Theme.WarningTextBrush}"/>
                        </Viewbox>
                    </Grid>
                </Border>
                <Grid Margin="0,0,0,9" FlowDirection="LeftToRight">
                    <TextBlock x:Name="txtDeviceCount" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" FlowDirection="RightToLeft"/>
                    <TextBlock Text="دستگاه‌های ثبت‌شده" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" FlowDirection="RightToLeft"/>
                </Grid>
                <ScrollViewer MaxHeight="256" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="4"/>
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2" Background="{DynamicResource Theme.ScrollThumbBrush}"/>
                                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="listDevices">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource FieldBorderBrush}"
                                    Background="{DynamicResource Theme.SurfaceBrush}" Margin="0,0,0,10" Padding="12" MinHeight="76">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource DeviceButton}" Click="RemoveDevice_Click" AutomationProperties.Name="حذف ورود دستگاه">
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                            <Path Data="{StaticResource DeviceTrashGlyph}" Stroke="{DynamicResource Theme.DangerBrush}" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="حذف" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" FlowDirection="RightToLeft">
                                        <TextBlock Text="{Binding device_name, TargetNullValue=دستگاه بدون نام}" FontSize="13" FontFamily="{StaticResource AppFontFamilySemiBold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" FlowDirection="LeftToRight" TextAlignment="Right" TextWrapping="Wrap"/>
                                        <TextBlock Text="دستگاه ثبت‌شده" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.SurfaceSoft}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource DeviceGlyph}" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.5" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="txtEmpty" Text="دستگاهی برای حذف دریافت نشد. دوباره وارد شوید."
                           Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8"/>
                <Border x:Name="ConfirmationBox" Visibility="Collapsed" CornerRadius="10" Padding="12" Margin="0,2,0,0"
                        Background="{DynamicResource Brush.RemoveHoverBg}">
                    <StackPanel>
                        <TextBlock x:Name="txtConfirmation" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="btnConfirm" Style="{StaticResource DeviceButton}" Height="34" IsDefault="True" Click="ConfirmRemoval_Click">
                                <TextBlock x:Name="txtConfirmButton" Text="حذف و ادامهٔ ورود"/>
                            </Button>
                            <Button x:Name="btnCancel" Style="{StaticResource DeviceButton}" Height="34" Content="انصراف" Margin="0,0,8,0" Click="CancelRemoval_Click"
                                    Background="{DynamicResource Theme.SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="txtError" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Theme.DangerBrush}" Margin="0,10,0,0"/>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,15,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <TextBlock Grid.Column="1" Text="پس از حذف موفق، ورود به‌صورت خودکار ادامه می‌یابد."
                                   FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,7,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
