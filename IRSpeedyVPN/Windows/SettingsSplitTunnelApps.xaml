<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:IRSpeedyVPN.Controls" x:Class="IRSpeedyVPN.Windows.SettingsSplitTunnelApps" Title="برنامه‌های تقسیم تونل" Width="381.6" Height="632" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="Window_Loaded" SizeToContent="Manual">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Viewbox Stretch="Uniform" StretchDirection="Both" FlowDirection="LeftToRight" x:Name="DesignViewport">
    <Grid ClipToBounds="True" FlowDirection="LeftToRight" Width="420" Height="700">
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="68"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#EEF0F4" BorderThickness="0,0,0,1">
        <Grid Margin="16,0" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="16" Foreground="#141B33" TextAlignment="Right" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center">
              <Run Text="برنامه‌های تقسیم تونل" FlowDirection="RightToLeft"/>
            </TextBlock>
            <TextBlock FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <Run Text="اعمال انتخاب‌ها در اتصال بعدی، فقط در حالت TUN" FlowDirection="RightToLeft"/>
            </TextBlock>
          </StackPanel>
          <Button Style="{StaticResource HandoffClose}" Click="Close_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="16,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <ComboBox x:Name="ModeBox" Height="34" FontSize="12" FlowDirection="RightToLeft" SelectionChanged="Mode_Changed" AutomationProperties.Name="روش تقسیم تونل">
              <ComboBoxItem Content="برنامه‌های انتخاب‌شده خارج از VPN"/>
              <ComboBoxItem Content="فقط برنامه‌های انتخاب‌شده داخل VPN"/>
            </ComboBox>
            <TextBlock FontSize="10.5" Foreground="#64748B" TextAlignment="Right" FlowDirection="LeftToRight" TextWrapping="Wrap" Margin="0,6,0,0">
              <Run x:Name="ModeHintText" FlowDirection="RightToLeft"/>
            </TextBlock>
          </StackPanel>
          <Border Grid.Row="1" CornerRadius="14" BorderBrush="#DFE4EF" BorderThickness="1" Background="White">
            <TextBox x:Name="SearchBox" Margin="12,0" BorderThickness="0" Background="Transparent" TextAlignment="Right" FlowDirection="RightToLeft" VerticalContentAlignment="Center" FontSize="13" TextChanged="Search_Changed" ToolTip="جستجوی نام برنامه" AutomationProperties.Name="جستجوی برنامه‌ها"/>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
            <Button Content="افزودن برنامه" Click="AddExecutable_Click" Style="{StaticResource HandoffPlainButton}" Foreground="#2447A8" FontSize="11" Margin="0,0,12,0"/>
            <Button Content="افزودن پوشه" Click="AddFolder_Click" Style="{StaticResource HandoffPlainButton}" Foreground="#2447A8" FontSize="11" Margin="0,0,12,0"/>
            <Button x:Name="RefreshButton" Content="تازه‌سازی" Click="Refresh_Click" Style="{StaticResource HandoffPlainButton}" Foreground="#2447A8" FontSize="11"/>
          </StackPanel>
          <Grid Grid.Row="3">
            <Button Click="SelectAll_Click" Style="{StaticResource HandoffPlainButton}" Content="انتخاب همه" HorizontalAlignment="Left" Foreground="#2447A8" FontSize="11"/>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock TextAlignment="Right" FlowDirection="LeftToRight" FontSize="11" Foreground="#64748B">
                <Run x:Name="SelectedCountText" FlowDirection="RightToLeft"/>
              </TextBlock>
              <TextBlock FontSize="10" Foreground="#9CA3B4" FlowDirection="LeftToRight">
                <Run Text="انتخاب پوشه شامل فایل‌های اجرایی زیرپوشه‌هاست" FlowDirection="RightToLeft"/>
              </TextBlock>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="4" FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" x:Name="AppScroll">
          <ItemsControl x:Name="AppList" FlowDirection="LeftToRight">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="48" Margin="0,0,0,6" CornerRadius="14" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="12,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="46"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <controls:ServiceToggle IsOn="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" Grid.Column="0" FlowDirection="LeftToRight"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                      <TextBlock Text="{Binding Name}" TextAlignment="Right" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding ExecutableName}" TextAlignment="Right" FontSize="10" Foreground="#9CA3B4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                    </StackPanel>
                    <Image Grid.Column="2" Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="4" x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False" Text="در حال خواندن برنامه‌های نصب‌شده…" FontSize="12" Foreground="#9CA3B4" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </Grid>
      </Grid>
      <Button Grid.Row="2" Margin="16,0,16,18" Height="50" Style="{StaticResource DesignActionButton}" Content="تایید و ذخیره" Click="btnOK_Click"/>
    </Grid>
  </Viewbox>
</Window>
