<Window xmlns:uiScale="clr-namespace:IRSpeedyVPN.Common" uiScale:WindowUiScale.Factor="{StaticResource UiScale}" Title="تقسیم تونل" x:Class="IRSpeedyVPN.Windows.SettingsSplitTunnelApps" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctl="clr-namespace:IRSpeedyVPN.Controls"
 Width="420" Height="700" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" SizeToContent="Manual" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBackgroundBrush}" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="Window_Loaded">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary>
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/IRSpeedyVPN;component/Themes/ConnectionSplit/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
    <!-- App row: icon · name/category · [trash, custom apps only] · switch -->
    <DataTemplate x:Key="AppRow">
      <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,8" ToolTip="{Binding Path}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />   <!-- icon badge (physical right) -->
            <ColumnDefinition Width="11" />
            <ColumnDefinition Width="*" />    <!-- name + category -->
            <ColumnDefinition Width="Auto" /> <!-- trash (custom apps only) -->
            <ColumnDefinition Width="11" />
            <ColumnDefinition Width="Auto" /> <!-- switch (physical left) -->
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{Binding TintBrush}" VerticalAlignment="Center">
            <Control Style="{StaticResource DataIconStyle}" Foreground="{Binding AccentBrush}" Width="17" Height="17" />
          </Border>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.AppName}" />
            <TextBlock Text="{Binding Category}" Style="{StaticResource Text.AppCategory}" />
          </StackPanel>

          <Button Grid.Column="3" Style="{StaticResource RoundIconButtonStyle}"
                  Margin="11,0,0,0"
                  Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"

                  Click="RemoveApp_Click"
                  AutomationProperties.Name="حذف از لیست"
                  ToolTip="حذف از لیست">
            <Control Template="{StaticResource Icon.Trash}" Foreground="{StaticResource Brush.Danger}" Width="13" Height="13" />
          </Button>

          <ctl:SettingsToggleSwitch Grid.Column="5" Width="40" Height="23"
                            IsChecked="{Binding Selected, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Name}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Everything under the activation row is dimmed + disabled while split tunnel is OFF -->
    <Style x:Key="DimWhenDisabled" TargetType="Grid">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>
 </ResourceDictionary></Window.Resources>
<Viewbox x:Name="DesignViewport" Stretch="Uniform" FlowDirection="LeftToRight">  <Border Width="420" Height="700" FlowDirection="RightToLeft" CornerRadius="20" Background="{StaticResource Brush.WindowBg}"
          BorderBrush="{StaticResource Brush.WindowEdge}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="62" />   <!-- header -->
        <RowDefinition Height="*" />    <!-- content -->
        <RowDefinition Height="Auto" /> <!-- confirm -->
      </Grid.RowDefinitions>

      <!-- ============ header ============ -->
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
        <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="تقسیم تونل" Style="{StaticResource Text.WindowTitle}" />
          <TextBlock Text="انتخاب برنامه‌هایی که از تونل عبور کنند" Style="{StaticResource Text.WindowSubtitle}" />
        </StackPanel>
        <Button Style="{StaticResource CloseButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                Click="Close_Click" AutomationProperties.Name="بستن" />
      </Grid>

      <!-- ============ content ============ -->
      <Grid Grid.Row="1" Margin="18,14,18,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /> <!-- activation -->
          <RowDefinition Height="10" />
          <RowDefinition Height="*" />    <!-- dimmable area -->
        </Grid.RowDefinitions>

        <!-- activation row (moved here from the connection-methods screen) -->
        <Border Grid.Row="0" CornerRadius="14" Background="{StaticResource Brush.SurfaceSoft}" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="فعال‌سازی تقسیم تونل" Style="{StaticResource Text.CardTitle}" />
              <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Style="{StaticResource Text.CardStatus}" />
            </StackPanel>
            <ctl:SettingsToggleSwitch Grid.Column="2" Width="46" Height="26"
                              IsChecked="{Binding IsSplitTunnelEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="فعال یا غیرفعال کردن تقسیم تونل" />
          </Grid>
        </Border>

        <!-- dimmable area -->
        <Grid Grid.Row="2" IsEnabled="{Binding CanEditApps}" Style="{StaticResource DimWhenDisabled}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- search -->
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" /> <!-- add app -->
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" /> <!-- count + select all -->
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />    <!-- list -->
          </Grid.RowDefinitions>

          <TextBox x:Name="SearchBox" Grid.Row="0" Style="{StaticResource SearchBoxStyle}" Tag="جستجوی برنامه"
                   TextChanged="Search_Changed"
                   AutomationProperties.Name="جستجوی برنامه" />

          <!-- "افزودن برنامه" — opens the Windows file picker (*.exe) -->
          <Button Grid.Row="2" Style="{StaticResource AddButtonStyle}" Click="AddExecutable_Click"
                  AutomationProperties.Name="افزودن برنامه">
            <Button.ContextMenu><ContextMenu><MenuItem Header="افزودن پوشه" Click="AddFolder_Click"/><MenuItem x:Name="RefreshButton" Header="تازه‌سازی فهرست" Click="Refresh_Click"/></ContextMenu></Button.ContextMenu>
            <StackPanel Orientation="Horizontal">
              <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Brush.Accent}">
                <Control Template="{StaticResource Icon.Plus}" Foreground="White" Width="11" Height="11" />
              </Border>
              <TextBlock Text="افزودن برنامه" Margin="10,0,0,0" VerticalAlignment="Center"
                         FontFamily="{StaticResource Font.Regular}" FontWeight="Bold" FontSize="13"
                         Foreground="{StaticResource Brush.Accent}" />
            </StackPanel>
          </Button>

          <!-- count (physical right) · select all (physical left) -->
          <Grid Grid.Row="4" Margin="2,0">
            <TextBlock HorizontalAlignment="Left" Style="{StaticResource Text.Caption}">
              <Run x:Name="SelectedCountText"/>
            </TextBlock>
            <Button HorizontalAlignment="Right" Style="{StaticResource LinkButtonStyle}"
                    Content="انتخاب همه" Click="SelectAll_Click" />
          </Grid>

          <!-- app list -->
          <ItemsControl x:Name="AppList" Grid.Row="6" ItemTemplate="{StaticResource AppRow}" Focusable="False"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
            </ItemsControl.Resources>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer x:Name="AppScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True" Focusable="False" Padding="0,0,0,4">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
          </ItemsControl>

          <!-- not in the design: empty search result -->
          <TextBlock Grid.Row="6" x:Name="EmptyText" Text="برنامه‌ای پیدا نشد" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                     Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                     Visibility="Collapsed" />
        </Grid>
      </Grid>

      <!-- ============ confirm ============ -->
      <Border Grid.Row="2" Padding="18,12,18,18">
        <Button Style="{StaticResource PrimaryButtonStyle}" Height="50"
                Content="تایید و ذخیره" Click="btnOK_Click" />
      </Border>
    </Grid>
  </Border>
</Viewbox></Window>
