<Window x:Class="IRSpeedyVPN.Windows.PingResult"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uiScale="clr-namespace:IRSpeedyVPN.Common"
        uiScale:WindowUiScale.Factor="{StaticResource UiScale}"
        Title="نتیجهٔ تست اتصال" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}" Foreground="{DynamicResource TextBodyBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ConnectionTestRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}"/>
        </Style>
    </Window.Resources>
    <Border Margin="8" Padding="18" CornerRadius="20" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.16"/></Border.Effect>
        <StackPanel>
            <Grid FlowDirection="LeftToRight" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Cursor="Hand"
                        MouseDown="btnClose_MouseDown" ToolTip="بستن" AutomationProperties.Name="بستن نتیجهٔ تست اتصال">
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}"/></Trigger></Style.Triggers>
                    </Style></Border.Style>
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Column="1" Text="نتیجهٔ تست اتصال" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.SurfaceSoft}">
                    <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <Border Style="{StaticResource ConnectionTestRow}">
                <Grid FlowDirection="LeftToRight">
                    <TextBlock Text="Google" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="txtGoogle" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ConnectionTestRow}">
                <Grid FlowDirection="LeftToRight">
                    <TextBlock Text="YouTube" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="txtYoutube" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ConnectionTestRow}">
                <Grid FlowDirection="LeftToRight">
                    <TextBlock Text="Instagram" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="txtInstagram" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ConnectionTestRow}">
                <Grid FlowDirection="LeftToRight">
                    <TextBlock Text="Telegram" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="txtTelegram" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
