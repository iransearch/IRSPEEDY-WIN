<Window xmlns:uiScale="clr-namespace:IRSpeedyVPN.Common" uiScale:WindowUiScale.Factor="{StaticResource UiScale}" x:Class="IRSpeedyVPN.Windows.PingResult"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="نتیجه تست اتصال"
        Width="377"
        Height="232"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BKoodak}" Foreground="{DynamicResource TextBodyBrush}">

    <Window.Resources>

        <!-- Outer rounded card (same as default form) -->
        <Style x:Key="OuterCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.LegacyAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.LegacyOverlayBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Row container (same as default form) -->
        <Style x:Key="SettingRowBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.LegacyAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="10,6,10,0"/>
        </Style>

    </Window.Resources>

    <Border Style="{StaticResource OuterCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER (same layout as VGAURDServiceSetting) -->
            <Border Grid.Row="0"
                    CornerRadius="24,24,0,0"
                    Background="{DynamicResource Theme.LegacySurfaceBrush}"
                    BorderBrush="{DynamicResource Theme.LegacyAccentBrush}"
                    BorderThickness="0,0,0,1.5" >
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1"
                               Text="Connection Test"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.LegacyAccentBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <!-- Close -->
                    <Border Grid.Column="2"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="{DynamicResource Theme.LegacyDangerSurfaceBrush}"
                            BorderBrush="{DynamicResource Theme.DangerBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            MouseDown="btnClose_MouseDown">
                        <TextBlock Text="&#xF00D;"
                                   FontFamily="{StaticResource fa_ProLight}"
                                   Foreground="{DynamicResource Theme.DangerBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,6,0,-3" Grid.RowSpan="2">

                    <!-- Google -->
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Google"
                                       FontFamily="Arial"
                                       Foreground="{DynamicResource Theme.LegacyBlueBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="txtGoogle"
                                       Grid.Column="2"
                                       FontFamily="Arial"
                                       Foreground="{DynamicResource Theme.LegacyGreenBrush}"
                                       Text="244ms"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Youtube -->
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Youtube"
                                       FontFamily="Arial"
                                       Foreground="{DynamicResource Theme.LegacyRedBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="txtYoutube"
                                       Grid.Column="2"
                                       FontFamily="Arial"
                                       Foreground="{DynamicResource Theme.LegacyGreenBrush}"
                                       Text="244ms"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Instagram -->
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Instagram"
                                       FontFamily="Arial"
                                       Foreground="#FFFF69B4"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="txtInstagram"
                                       Grid.Column="2"
                                       FontFamily="Arial"
                                       Foreground="{DynamicResource Theme.LegacyGreenBrush}"
                                       Text="244ms"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Telegram -->
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Telegram"
                                       FontFamily="Arial"
                                       Foreground="#FF229ED9"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="txtTelegram"
                                       Grid.Column="2"
                                       FontFamily="Arial"
                                       Foreground="{DynamicResource Theme.LegacyGreenBrush}"
                                       Text="244ms"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
