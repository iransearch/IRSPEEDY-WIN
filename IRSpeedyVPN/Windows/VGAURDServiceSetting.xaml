<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:IRSpeedyVPN.Controls" x:Class="IRSpeedyVPN.Windows.VGAURDServiceSetting" Title="روش‌های اتصال" Width="420" Height="460" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SizeToContent="Manual">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="62"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="68"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="#EEF0F4" BorderThickness="0,0,0,1">
      <Grid Margin="16,0" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="روش‌های اتصال" FontSize="16" Foreground="#141B33" TextAlignment="Right" FlowDirection="RightToLeft" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
          <TextBlock Text="انتخاب مسیر اتصال به اینترنت" FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="RightToLeft" HorizontalAlignment="Center"/>
        </StackPanel>
        <Button Style="{StaticResource HandoffClose}" Click="Close_Click"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="16,16">
      <StackPanel VerticalAlignment="Center">
        <Grid Margin="0,0,0,10">
          <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0" x:Name="rowVpn">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <controls:ServiceToggle x:Name="VPNMode" AutomationProperties.Name="VPNMode" Checked="VPNMode_Checked" Unchecked="VPNMode_Unchecked" Grid.Column="2"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="وی‌پی‌ان سراسری" FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="RightToLeft" FontWeight="Bold"/>
                <TextBlock Text="اتصال کل ترافیک سیستم به VPN" FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="RightToLeft"/>
              </StackPanel>
              <Border Grid.Column="0" Width="36" Height="36" CornerRadius="13" Background="#1A1E3A8A">
                <Image Source="{StaticResource SettingsGlobeImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <controls:ServiceToggle x:Name="SystemProxy" AutomationProperties.Name="SystemProxy" Checked="SystemProxy_Checked" Unchecked="SystemProxy_Unchecked" Grid.Column="2"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="پروکسی سیستمی" FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="RightToLeft" FontWeight="Bold"/>
                <TextBlock Text="اعمال روی تنظیمات شبکه ویندوز" FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="RightToLeft"/>
              </StackPanel>
              <Border Grid.Column="0" Width="36" Height="36" CornerRadius="13" Background="#1A7C3AED">
                <Image Source="{StaticResource SettingsStackImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <controls:ServiceToggle x:Name="GlobalProxy" AutomationProperties.Name="GlobalProxy" Checked="GlobalProxy_Checked" Unchecked="GlobalProxy_Unchecked" Grid.Column="2"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="پروکسی‌فایر" FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="RightToLeft" FontWeight="Bold"/>
                <TextBlock Text="مسیریابی هوشمند برنامه‌های خاص" FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="RightToLeft"/>
              </StackPanel>
              <Border Grid.Column="0" Width="36" Height="36" CornerRadius="13" Background="#1AF59E0B">
                <Image Source="{StaticResource SettingsRouteImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Grid.Column="2">
                <controls:ServiceToggle x:Name="SplitTunnel" AutomationProperties.Name="SplitTunnel"/>
                <Button Style="{StaticResource HandoffPlainButton}" Click="SplitApps_Click">
                  <Border Width="26" Height="26" CornerRadius="13" Background="#F5F6F9">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="#B7BCC9" StrokeThickness="2" Width="7" Height="12" Stretch="Uniform" FlowDirection="LeftToRight"/>
                  </Border>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="تقسیم تونل" FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="RightToLeft" FontWeight="Bold"/>
                <TextBlock Text="پیش‌نمایش انتخاب برنامه‌ها؛ مسیریابی اعمال نمی‌شود" FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="RightToLeft"/>
              </StackPanel>
              <Border Grid.Column="0" Width="36" Height="36" CornerRadius="13" Background="#1A0D9488">
                <Image Source="{StaticResource HandoffSplitImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
      <StackPanel Visibility="Collapsed">
        <controls:ServiceToggle x:Name="TelegramRouteProxy" AutomationProperties.Name="TelegramRouteProxy" Checked="TelegramRouteProxy_Checked" Unchecked="TelegramRouteProxy_Unchecked"/>
        <controls:ServiceToggle x:Name="VodService" AutomationProperties.Name="VodService"/>
        <controls:ServiceToggle x:Name="GameMode" AutomationProperties.Name="GameMode"/>
      </StackPanel>
    </Grid>
    <Button Grid.Row="2" Margin="16,0,16,18" Height="50" Style="{StaticResource DesignActionButton}" Content="تایید و ذخیره" Click="btnOK_Click"/>
  </Grid>
</Window>
