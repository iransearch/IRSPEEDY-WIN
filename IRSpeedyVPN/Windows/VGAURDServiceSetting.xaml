<Window x:Class="IRSpeedyVPN.Windows.VGAURDServiceSetting"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:IRSpeedyVPN.Controls" Title="تنظیمات سرویس"
 Width="420" Height="700" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
 Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Grid Margin="18,0,18,18">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
  <Grid Background="Transparent" MouseLeftButtonDown="Header_DragMove">
   <TextBlock Text="تنظیمات سرویس" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontSize="16.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" ToolTip="بستن تنظیمات">
    <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="15" Background="{StaticResource SettingsCloseBrush}"><Path Data="{StaticResource IconClose}" Stroke="White" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/></Border></ControlTemplate></Button.Template>
   </Button>
  </Grid>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" x:Name="rowVpn" Height="68" CornerRadius="16" Background="White" BorderBrush="{StaticResource SettingsRowBorderBrush}" BorderThickness="1" Padding="16,0">
    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <controls:ServiceToggle x:Name="VPNMode" Checked="VPNMode_Checked" Unchecked="VPNMode_Unchecked" AutomationProperties.Name="وی پی ان سراسری"/>
     <TextBlock Grid.Column="1" TextAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" Margin="12,0,0,0"><Run FlowDirection="RightToLeft" Text="وی پی ان سراسری"/></TextBlock>
    </Grid>
   </Border>
   <Border Grid.Row="1"  Height="68" CornerRadius="16" Background="White" BorderBrush="{StaticResource SettingsRowBorderBrush}" BorderThickness="1" Padding="16,0">
    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <controls:ServiceToggle x:Name="SystemProxy" Checked="SystemProxy_Checked" Unchecked="SystemProxy_Unchecked" AutomationProperties.Name="پروکسی سیستمی"/>
     <TextBlock Grid.Column="1" TextAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" Margin="12,0,0,0"><Run FlowDirection="RightToLeft" Text="پروکسی سیستمی"/></TextBlock>
    </Grid>
   </Border>
   <Border Grid.Row="2"  Height="68" CornerRadius="16" Background="White" BorderBrush="{StaticResource SettingsRowBorderBrush}" BorderThickness="1" Padding="16,0">
    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <controls:ServiceToggle x:Name="GlobalProxy" Checked="GlobalProxy_Checked" Unchecked="GlobalProxy_Unchecked" AutomationProperties.Name="پروکسی‌فایر"/>
     <TextBlock Grid.Column="1" TextAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" Margin="12,0,0,0"><Run FlowDirection="RightToLeft" Text="پروکسی‌فایر"/></TextBlock>
    </Grid>
   </Border>
   <Border Grid.Row="3"  Height="68" CornerRadius="16" Background="White" BorderBrush="{StaticResource SettingsRowBorderBrush}" BorderThickness="1" Padding="16,0">
    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <controls:ServiceToggle x:Name="TelegramRouteProxy" Checked="TelegramRouteProxy_Checked" Unchecked="TelegramRouteProxy_Unchecked" AutomationProperties.Name="پروکسی تلگرام، واتساپ"/>
     <TextBlock Grid.Column="1" TextAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" Margin="12,0,0,0"><Run FlowDirection="RightToLeft" Text="پروکسی تلگرام، واتساپ"/></TextBlock>
    </Grid>
   </Border>
   <Border Grid.Row="4"  Height="68" CornerRadius="16" Background="White" BorderBrush="{StaticResource SettingsRowBorderBrush}" BorderThickness="1" Padding="16,0">
    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <controls:ServiceToggle x:Name="VodService" Checked="VodService_Checked" Unchecked="VodService_Unchecked" AutomationProperties.Name="VOD/AI"/>
     <TextBlock Grid.Column="1" TextAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" Margin="12,0,0,0"><Run FlowDirection="RightToLeft" Text="VOD/AI"/></TextBlock>
    </Grid>
   </Border>
   <Border Grid.Row="5"  Height="68" CornerRadius="16" Background="White" BorderBrush="{StaticResource SettingsRowBorderBrush}" BorderThickness="1" Padding="16,0">
    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <controls:ServiceToggle x:Name="GameMode" Checked="GameMode_Checked" Unchecked="GameMode_Unchecked" AutomationProperties.Name="Game Mode"/>
     <TextBlock Grid.Column="1" TextAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" Margin="12,0,0,0"><Run FlowDirection="RightToLeft" Text="Game Mode"/></TextBlock>
    </Grid>
   </Border>
  </Grid>
  <Button Grid.Row="2" x:Name="btnOK" Height="50" VerticalAlignment="Bottom" Content="تایید" Click="btnOK_Click" IsDefault="True"
    Background="{StaticResource ConfirmButtonBackgroundBrush}" Foreground="{StaticResource ConfirmButtonTextBrush}" FontSize="14.5" FontWeight="Bold">
   <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ConfirmButtonBorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
  </Button>
 </Grid>
</Window>
