<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:IRSpeedyVPN.Controls" x:Class="IRSpeedyVPN.Windows.VGAURDServiceSetting" Title="روش‌های اتصال" Width="381.6" Height="415.3142857143" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SizeToContent="Manual">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Viewbox Stretch="Uniform" StretchDirection="Both" FlowDirection="LeftToRight" x:Name="DesignViewport">
    <Grid ClipToBounds="True" FlowDirection="LeftToRight" Width="420" Height="460">
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="68"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#EEF0F4" BorderThickness="0,0,0,1">
        <Grid Margin="16,0" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="16" Foreground="#141B33" TextAlignment="Right" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center">
              <Run Text="روش‌های اتصال" FlowDirection="RightToLeft"/>
            </TextBlock>
            <TextBlock FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <Run Text="انتخاب مسیر اتصال به اینترنت" FlowDirection="RightToLeft"/>
            </TextBlock>
          </StackPanel>
          <Button Style="{StaticResource HandoffClose}" Click="Close_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="16,16">
        <StackPanel VerticalAlignment="Center">
          <Grid Margin="0,0,0,10">
            <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0" x:Name="rowVpn">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <controls:ServiceToggle x:Name="VPNMode" AutomationProperties.Name="VPNMode" Checked="VPNMode_Checked" Unchecked="VPNMode_Unchecked" Grid.Column="0" FlowDirection="LeftToRight"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                    <Run Text="وی‌پی‌ان سراسری" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                    <Run Text="اتصال کل ترافیک سیستم به VPN" FlowDirection="RightToLeft"/>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Width="36" Height="36" CornerRadius="13" Background="#1A1E3A8A">
                  <Image Source="{StaticResource SettingsGlobeImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <Grid Margin="0,0,0,10">
            <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <controls:ServiceToggle x:Name="SystemProxy" AutomationProperties.Name="SystemProxy" Checked="SystemProxy_Checked" Unchecked="SystemProxy_Unchecked" Grid.Column="0" FlowDirection="LeftToRight"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                    <Run Text="پروکسی سیستمی" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                    <Run Text="اعمال روی تنظیمات شبکه ویندوز" FlowDirection="RightToLeft"/>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Width="36" Height="36" CornerRadius="13" Background="#1A7C3AED">
                  <Image Source="{StaticResource SettingsStackImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <Grid Margin="0,0,0,10">
            <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <controls:ServiceToggle x:Name="GlobalProxy" AutomationProperties.Name="GlobalProxy" Checked="GlobalProxy_Checked" Unchecked="GlobalProxy_Unchecked" Grid.Column="0" FlowDirection="LeftToRight"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                    <Run Text="پروکسی‌فایر" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                    <Run Text="مسیریابی هوشمند برنامه‌های خاص" FlowDirection="RightToLeft"/>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Width="36" Height="36" CornerRadius="13" Background="#1AF59E0B">
                  <Image Source="{StaticResource SettingsRouteImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <Grid Margin="0,0,0,10">
            <Border Height="60" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                  <Button Style="{StaticResource HandoffPlainButton}" Click="SplitApps_Click">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#F5F6F9">
                      <Path Data="M15,6 L9,12 L15,18" Stroke="#B7BCC9" StrokeThickness="2" Width="7" Height="12" Stretch="Uniform" FlowDirection="LeftToRight"/>
                    </Border>
                  </Button>
                  <controls:ServiceToggle x:Name="SplitTunnel" AutomationProperties.Name="SplitTunnel" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                    <Run Text="تقسیم تونل" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                    <Run Text="انتخاب مسیر برنامه‌ها؛ فقط در حالت TUN" FlowDirection="RightToLeft"/>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Width="36" Height="36" CornerRadius="13" Background="#1A0D9488">
                  <Image Source="{StaticResource HandoffSplitImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
        <StackPanel Visibility="Collapsed">
          <controls:ServiceToggle x:Name="TelegramRouteProxy" AutomationProperties.Name="TelegramRouteProxy" Checked="TelegramRouteProxy_Checked" Unchecked="TelegramRouteProxy_Unchecked" FlowDirection="LeftToRight"/>
          <controls:ServiceToggle x:Name="VodService" AutomationProperties.Name="VodService" FlowDirection="LeftToRight"/>
          <controls:ServiceToggle x:Name="GameMode" AutomationProperties.Name="GameMode" FlowDirection="LeftToRight"/>
        </StackPanel>
      </Grid>
      <Button Grid.Row="2" Margin="16,0,16,18" Height="50" Style="{StaticResource DesignActionButton}" Content="تایید و ذخیره" Click="btnOK_Click"/>
    </Grid>
  </Viewbox>
</Window>
