<Window xmlns:uiScale="clr-namespace:IRSpeedyVPN.Common" uiScale:WindowUiScale.Factor="{StaticResource UiScale}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:IRSpeedyVPN.Controls" x:Class="IRSpeedyVPN.Windows.SettingsPassword" Title="تغییر رمز عبور" Width="420" Height="460" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SizeToContent="Manual" Foreground="{DynamicResource TextBodyBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Viewbox Stretch="Uniform" StretchDirection="Both" FlowDirection="LeftToRight" x:Name="DesignViewport">
    <Grid ClipToBounds="True" FlowDirection="LeftToRight" Width="420" Height="460">
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="68"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource StatCardDividerBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="16,0" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center">
              <Run Text="تغییر رمز عبور" FlowDirection="RightToLeft"/>
            </TextBlock>
            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <Run Text="به‌روزرسانی رمز عبور حساب کاربری" FlowDirection="RightToLeft"/>
            </TextBlock>
          </StackPanel>
          <Button Style="{StaticResource HandoffClose}" Click="Close_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="16,16">
        <StackPanel Margin="4,0">
          <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" FlowDirection="LeftToRight" Margin="0,12,0,20">
            <Run Text="رمز عبور خود را برای افزایش امنیت حساب به‌روزرسانی کنید" FlowDirection="RightToLeft"/>
          </TextBlock>
          <StackPanel Margin="0,0,0,8">
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold" Margin="0,0,0,3">
              <Run Text="رمز عبور فعلی" FlowDirection="RightToLeft"/>
            </TextBlock>
            <Border Height="42" CornerRadius="12" Background="{DynamicResource Theme.SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
              <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HandoffPlainButton}" Tag="Current" Click="Reveal_Click" IsTabStop="False" ToolTip="نمایش یا پنهان‌کردن رمز" AutomationProperties.Name="نمایش یا پنهان‌کردن رمز عبور فعلی" Grid.Column="0">
                  <Path Data="M1,8 Q8,0 15,8 Q8,16 1,8 M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Width="14" Height="12" Stretch="Uniform" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                </Button>
                <PasswordBox x:Name="CurrentPassword" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" AutomationProperties.Name="رمز عبور فعلی" Foreground="{DynamicResource TextBodyBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="CurrentVisible" Grid.Column="1" Visibility="Collapsed" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextAlignment="Right" FontSize="13" FlowDirection="LeftToRight" AutomationProperties.Name="رمز عبور فعلی" Foreground="{DynamicResource TextBodyBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                <Path Grid.Column="2" Data="{StaticResource IconLock}" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" FlowDirection="LeftToRight"/>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Margin="0,0,0,8">
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold" Margin="0,0,0,3">
              <Run Text="رمز عبور جدید" FlowDirection="RightToLeft"/>
            </TextBlock>
            <Border Height="42" CornerRadius="12" Background="{DynamicResource Theme.SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
              <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HandoffPlainButton}" Tag="New" Click="Reveal_Click" IsTabStop="False" ToolTip="نمایش یا پنهان‌کردن رمز" AutomationProperties.Name="نمایش یا پنهان‌کردن رمز عبور جدید" Grid.Column="0">
                  <Path Data="M1,8 Q8,0 15,8 Q8,16 1,8 M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Width="14" Height="12" Stretch="Uniform" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                </Button>
                <PasswordBox x:Name="NewPassword" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" AutomationProperties.Name="رمز عبور جدید" Foreground="{DynamicResource TextBodyBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="NewVisible" Grid.Column="1" Visibility="Collapsed" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextAlignment="Right" FontSize="13" FlowDirection="LeftToRight" AutomationProperties.Name="رمز عبور جدید" Foreground="{DynamicResource TextBodyBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                <Path Grid.Column="2" Data="{StaticResource IconLock}" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" FlowDirection="LeftToRight"/>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Margin="0,0,0,8">
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold" Margin="0,0,0,3">
              <Run Text="تکرار رمز عبور جدید" FlowDirection="RightToLeft"/>
            </TextBlock>
            <Border Height="42" CornerRadius="12" Background="{DynamicResource Theme.SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
              <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HandoffPlainButton}" Tag="Confirm" Click="Reveal_Click" IsTabStop="False" ToolTip="نمایش یا پنهان‌کردن رمز" AutomationProperties.Name="نمایش یا پنهان‌کردن تکرار رمز عبور جدید" Grid.Column="0">
                  <Path Data="M1,8 Q8,0 15,8 Q8,16 1,8 M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Width="14" Height="12" Stretch="Uniform" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                </Button>
                <PasswordBox x:Name="ConfirmPassword" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" AutomationProperties.Name="تکرار رمز عبور جدید" Foreground="{DynamicResource TextBodyBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="ConfirmVisible" Grid.Column="1" Visibility="Collapsed" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextAlignment="Right" FontSize="13" FlowDirection="LeftToRight" AutomationProperties.Name="تکرار رمز عبور جدید" Foreground="{DynamicResource TextBodyBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                <Path Grid.Column="2" Data="{StaticResource IconLock}" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" FlowDirection="LeftToRight"/>
              </Grid>
            </Border>
          </StackPanel>
          <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" FlowDirection="LeftToRight">
            <Run Text="حداقل ۵ کاراکتر عددی" FlowDirection="RightToLeft"/>
          </TextBlock>
          <TextBlock FontSize="11" Foreground="{DynamicResource Theme.DangerBrush}" TextAlignment="Right" FlowDirection="LeftToRight" x:Name="ErrorText" TextWrapping="Wrap" Margin="0,5,0,0">
            <Run Text="" FlowDirection="RightToLeft"/>
          </TextBlock>
        </StackPanel>
      </Grid>
      <Button Grid.Row="2" x:Name="SaveButton" Margin="20,6,20,12" Height="50" Style="{StaticResource DesignActionButton}" Content="تغییر رمز عبور" Click="Save_Click" IsDefault="True"/>
    </Grid>
  </Viewbox>
</Window>
