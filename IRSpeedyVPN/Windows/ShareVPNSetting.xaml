<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:IRSpeedyVPN.Controls" x:Class="IRSpeedyVPN.Windows.ShareVPNSetting" Title="اشتراک‌گذاری اتصال" Width="381.6" Height="632" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="Window_Loaded" SizeToContent="Manual">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Viewbox Stretch="Uniform" StretchDirection="Both" FlowDirection="LeftToRight" x:Name="DesignViewport">
    <Grid ClipToBounds="True" FlowDirection="LeftToRight" Width="420" Height="700">
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="0"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#EEF0F4" BorderThickness="0,0,0,1">
        <Grid Margin="16,0" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="16" Foreground="#141B33" TextAlignment="Right" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center">
              <Run Text="اشتراک‌گذاری اتصال" FlowDirection="RightToLeft"/>
            </TextBlock>
            <TextBlock FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <Run Text="اتصال VPN را با دستگاه‌های دیگر به اشتراک بگذارید" FlowDirection="RightToLeft"/>
            </TextBlock>
          </StackPanel>
          <Button Style="{StaticResource HandoffClose}" Click="Close_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="16,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="41"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border CornerRadius="12" Background="#EEF1F8" Padding="4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="DirectTab" Content="اشتراک مستقیم" Click="DirectTab_Click" Style="{StaticResource HandoffPlainButton}" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#9CA3B4" Grid.Column="0"/>
              <Button x:Name="ProxyTab" Grid.Column="1" Content="اشتراک با پراکسی" Click="ProxyTab_Click" Style="{StaticResource HandoffPlainButton}" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold" Background="White" Foreground="#141B33"/>
            </Grid>
          </Border>
          <Grid x:Name="ProxyPanel" Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <Border CornerRadius="16" BorderBrush="#E7EAF2" BorderThickness="1" Background="White" Padding="16,12">
                <StackPanel FlowDirection="RightToLeft">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Style="{StaticResource HandoffRoundBadge}" Background="#1E3A8A">
                      <TextBlock Text="۱" Foreground="White" FontSize="11" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="فعال‌سازی اشتراک" FontSize="12.5" Foreground="#1B2033" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" TextAlignment="Right"/>
                      <TextBlock Text="اشتراک‌گذاری VPN را روی این دستگاه فعال کنید." FontSize="11" Foreground="#8A93A6" TextAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="ProxyStepTwo" Margin="0,12,0,0" Opacity="0.45">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Style="{StaticResource HandoffRoundBadge}" Background="#C7CCD8">
                      <TextBlock Text="۲" Foreground="White" FontSize="11" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="تنظیم پراکسی روی دستگاه دوم" FontSize="12.5" Foreground="#1B2033" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" TextAlignment="Right"/>
                      <TextBlock Text="روی دستگاه دوم پراکسی HTTP یا SOCKS5 را با آی‌پی و پورت زیر تنظیم کنید." FontSize="11" Foreground="#8A93A6" TextAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Height="52" CornerRadius="15" Background="#F4F6FA" Margin="0,12,0,12" Padding="14,0">
                <Grid>
                  <ToggleButton x:Name="btnStartStop" Click="btnStartStop_Click" Style="{StaticResource HandoffPill}" HorizontalAlignment="Left" AutomationProperties.Name="اشتراک‌گذاری پراکسی" FlowDirection="LeftToRight"/>
                  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="#141B33" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                      <Run Text="اشتراک‌گذاری پراکسی" FlowDirection="RightToLeft"/>
                    </TextBlock>
                    <TextBlock FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight" x:Name="ProxyStatus">
                      <Run Text="" FlowDirection="RightToLeft"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
            <Grid Grid.Row="1">
              <StackPanel x:Name="pnlShowIP">
                <Border Height="50" Margin="0,0,0,10" CornerRadius="14" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="10,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                      <Button Click="CopyProxy_Click" Tag="HTTP" Style="{StaticResource HandoffPlainButton}" Width="28" Height="28" ToolTip="کپی HTTP" AutomationProperties.Name="کپی HTTP">
                        <Path Data="M5.5,5.5 L14.5,5.5 14.5,14.5 5.5,14.5 Z M3,10.2 L3,2 11,2" Stroke="#5B6478" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                      </Button>
                      <Button Click="Qr_Click" Tag="HTTP" Style="{StaticResource HandoffPlainButton}" Width="28" Height="28" ToolTip="کد QR HTTP" AutomationProperties.Name="کد QR HTTP">
                        <Path Data="M1,1 L6,1 6,6 1,6 Z M10,1 L15,1 15,6 10,6 Z M1,10 L6,10 6,15 1,15 Z M10,10 L12,10 12,12 15,12 15,15 10,15 Z" Stroke="#5B6478" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                      </Button>
                    </StackPanel>
                    <TextBlock x:Name="HTTPAddress" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#24365F" VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                    <Border Grid.Column="2" Background="#1E3A8A" CornerRadius="8" Padding="9,5" VerticalAlignment="Center">
                      <TextBlock Text="HTTP" FontSize="11" Foreground="White" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal"/>
                    </Border>
                  </Grid>
                </Border>
                <Border Height="50" Margin="0,0,0,10" CornerRadius="14" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="10,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                      <Button Click="CopyProxy_Click" Tag="SOCKS5" Style="{StaticResource HandoffPlainButton}" Width="28" Height="28" ToolTip="کپی SOCKS5" AutomationProperties.Name="کپی SOCKS5">
                        <Path Data="M5.5,5.5 L14.5,5.5 14.5,14.5 5.5,14.5 Z M3,10.2 L3,2 11,2" Stroke="#5B6478" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                      </Button>
                      <Button Click="Qr_Click" Tag="SOCKS5" Style="{StaticResource HandoffPlainButton}" Width="28" Height="28" ToolTip="کد QR SOCKS5" AutomationProperties.Name="کد QR SOCKS5">
                        <Path Data="M1,1 L6,1 6,6 1,6 Z M10,1 L15,1 15,6 10,6 Z M1,10 L6,10 6,15 1,15 Z M10,10 L12,10 12,12 15,12 15,15 10,15 Z" Stroke="#5B6478" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                      </Button>
                    </StackPanel>
                    <TextBlock x:Name="SOCKS5Address" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#24365F" VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                    <Border Grid.Column="2" Background="#0D9488" CornerRadius="8" Padding="9,5" VerticalAlignment="Center">
                      <TextBlock Text="SOCKS5" FontSize="11" Foreground="White" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal"/>
                    </Border>
                  </Grid>
                </Border>
              </StackPanel>
              <controls:ProxySharingMotion x:Name="ProxyMotion" VerticalAlignment="Bottom" FlowDirection="LeftToRight"/>
              <Grid x:Name="ProxyOffHint" Height="78" VerticalAlignment="Center">
                <Rectangle RadiusX="14" RadiusY="14" Stroke="#D7DCE6" StrokeThickness="1.5" StrokeDashArray="4,3"/>
                <TextBlock Margin="20" FontSize="11.5" Foreground="#9CA3B4" TextAlignment="Center" FlowDirection="RightToLeft" TextWrapping="Wrap" VerticalAlignment="Center" Text="برای مشاهده آدرس و پورت پراکسی، ابتدا اشتراک‌گذاری را فعال کنید."/>
              </Grid>
            </Grid>
          </Grid>
          <Grid x:Name="DirectPanel" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <Border CornerRadius="16" BorderBrush="#E7EAF2" BorderThickness="1" Background="White" Padding="16,14">
                <Grid FlowDirection="RightToLeft">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Style="{StaticResource HandoffRoundBadge}" Background="#1E3A8A">
                    <TextBlock Text="۱" Foreground="White" FontSize="11" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="اتصال دستگاه‌های دیگر" FontSize="12.5" Foreground="#1B2033" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Text="این دستگاه به یک Wi-Fi مستقیم تبدیل می‌شود؛ به آن متصل شوید تا از VPN استفاده کنید." FontSize="11" Foreground="#8A93A6" TextAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Height="52" CornerRadius="15" Background="#F4F6FA" Margin="0,12,0,12" Padding="14,0">
                <Grid>
                  <ToggleButton x:Name="hotspotToggle" Click="HotspotToggle_Click" Style="{StaticResource HandoffPill}" HorizontalAlignment="Left" AutomationProperties.Name="هات‌اسپات مستقیم" FlowDirection="LeftToRight"/>
                  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="#141B33" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                      <Run Text="هات‌اسپات مستقیم" FlowDirection="RightToLeft"/>
                    </TextBlock>
                    <TextBlock FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight" x:Name="hotspotStateLabel">
                      <Run Text="" FlowDirection="RightToLeft"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="hotspotCredentials" CornerRadius="14" BorderBrush="#ECEEF3" BorderThickness="1" Background="White" ClipToBounds="True">
                <StackPanel FlowDirection="LeftToRight">
                  <Border BorderBrush="#EEF0F4" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0" Padding="14,7">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F7FAFF" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                      <TextBlock Text="برای اتصال دستگاه‌ها" FontSize="9" Foreground="#B9C0CE" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                      <TextBlock Text="اطلاعات هات‌اسپات" FontSize="11" Foreground="#3C4457" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                    </Grid>
                  </Border>
                  <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="HotspotCopyName_Click" Tag="hotspotName" Style="{StaticResource HandoffCircleIconButton}" ToolTip="کپی نام وای‌فای" AutomationProperties.Name="کپی نام وای‌فای">
                      <Path Data="M5.5,5.5 L14.5,5.5 14.5,14.5 5.5,14.5 Z M3,10.2 L3,2 11,2" Stroke="#5B6478" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" FlowDirection="LeftToRight"/>
                    </Button>
                    <TextBlock x:Name="hotspotName" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13.5" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" Foreground="#1F2433" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" Width="30" Height="30" Style="{StaticResource HandoffRoundBadge}" Background="#1A1E3A8A">
                      <Viewbox Width="15" Height="15" FlowDirection="LeftToRight">
                        <Canvas Width="24" Height="24">
                          <Path Data="M4,9.5 C8.4,5.5 15.6,5.5 20,9.5 M7,13.2 C9.8,10.8 14.2,10.8 17,13.2 M10,16.8 C11.2,15.8 12.8,15.8 14,16.8" Stroke="#1E3A8A" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                          <Ellipse Canvas.Left="10.6" Canvas.Top="18" Width="2.8" Height="2.8" Fill="#1E3A8A"/>
                        </Canvas>
                      </Viewbox>
                    </Border>
                  </Grid>
                  <Border BorderBrush="#EEF0F4" BorderThickness="0,1,0,0" Margin="14,0"/>
                  <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Click="HotspotEditPassword_Click" Style="{StaticResource HandoffCircleIconButton}" Margin="0,0,10,0" ToolTip="تغییر رمز وای‌فای" AutomationProperties.Name="تغییر رمز وای‌فای">
                        <Path Data="M11.3,2.3 C11.9,1.7 12.9,1.7 13.5,2.3 C14.1,2.9 14.1,3.9 13.5,4.5 L5.9,12.3 3,13 3.7,10 11.3,2.3 Z" Stroke="#5B6478" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" FlowDirection="LeftToRight"/>
                      </Button>
                      <Button Click="HotspotCopyPassword_Click" Tag="hotspotPassword" Style="{StaticResource HandoffCircleIconButton}" ToolTip="کپی رمز وای‌فای" AutomationProperties.Name="کپی رمز وای‌فای">
                        <Path Data="M5.5,5.5 L14.5,5.5 14.5,14.5 5.5,14.5 Z M3,10.2 L3,2 11,2" Stroke="#5B6478" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" FlowDirection="LeftToRight"/>
                      </Button>
                    </StackPanel>
                    <TextBlock x:Name="hotspotPassword" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13.5" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" Foreground="#1F2433" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" Width="30" Height="30" Style="{StaticResource HandoffRoundBadge}" Background="#FDF3E2">
                      <Viewbox Width="15" Height="15" FlowDirection="LeftToRight">
                        <Canvas Width="24" Height="24">
                          <Rectangle Canvas.Left="4.5" Canvas.Top="10.5" Width="15" Height="10.5" RadiusX="2.6" RadiusY="2.6" Stroke="#B7791F" StrokeThickness="1.9"/>
                          <Path Data="M8,10.5 L8,7.8 C8,2.5 16,2.5 16,7.8 L16,10.5" Stroke="#B7791F" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                          <Ellipse Canvas.Left="10.5" Canvas.Top="14.1" Width="3" Height="3" Fill="#B7791F"/>
                        </Canvas>
                      </Viewbox>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Grid x:Name="hotspotClientsRow" Height="22" Margin="3,8,3,0" FlowDirection="LeftToRight" Visibility="Collapsed">
                <Border MinWidth="22" Height="22" Padding="7,0" Background="#1E3A8A" Style="{StaticResource HandoffRoundBadge}" HorizontalAlignment="Left">
                  <TextBlock x:Name="hotspotClientCount" Foreground="White" FontSize="11" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="RightToLeft"/>
                </Border>
                <TextBlock Text="دستگاه‌های متصل" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
              </Grid>
              <TextBlock FontSize="11" Foreground="#64748B" TextAlignment="Right" FlowDirection="LeftToRight" x:Name="hotspotStatus" TextWrapping="Wrap" Margin="0,5,0,0">
                <Run Text="" FlowDirection="RightToLeft"/>
              </TextBlock>
              <Button x:Name="hotspotRetryStop" Content="تلاش دوباره برای توقف" Click="HotspotStop_Click" Style="{StaticResource HandoffPlainButton}" Foreground="#DC2626" FontSize="11" Height="28" Visibility="Collapsed"/>
              <Grid x:Name="PasswordEditorPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="hotspotSavePassword" Content="ذخیره رمز" Click="HotspotSavePassword_Click" Style="{StaticResource HandoffPlainButton}" Foreground="#2447A8" FontSize="11" Grid.Column="0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                    <Run Text="رمز جدید وای‌فای (۱۰ رقم انگلیسی)" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <PasswordBox x:Name="hotspotPasswordEditor" Height="30" MaxLength="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" AutomationProperties.Name="رمز جدید وای‌فای" FlowDirection="LeftToRight"/>
                </StackPanel>
              </Grid>
            </StackPanel>
            <Grid x:Name="DirectOffHint" Grid.Row="1" Height="78" VerticalAlignment="Center">
              <Rectangle RadiusX="14" RadiusY="14" Stroke="#D7DCE6" StrokeThickness="1.5" StrokeDashArray="4,3"/>
              <TextBlock Margin="20" FontSize="11.5" Foreground="#9CA3B4" TextAlignment="Center" FlowDirection="RightToLeft" TextWrapping="Wrap" VerticalAlignment="Center" Text="برای مشاهده نام و رمز Wi-Fi، ابتدا اشتراک‌گذاری مستقیم را فعال کنید"/>
            </Grid>
            <controls:HotspotBroadcastMotion x:Name="DirectMotion" Grid.Row="1" VerticalAlignment="Bottom" FlowDirection="LeftToRight"/>
          </Grid>
          <Popup x:Name="QrPopup" Placement="Center" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#DDE2EF" BorderThickness="1" CornerRadius="16" Padding="16">
              <StackPanel>
                <Image x:Name="QrImage" Width="220" Height="220" FlowDirection="LeftToRight"/>
                <TextBlock x:Name="QrLabel" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
      </Grid>
    </Grid>
  </Viewbox>
</Window>
