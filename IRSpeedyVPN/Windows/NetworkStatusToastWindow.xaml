<Window x:Class="IRSpeedyVPN.Windows.NetworkStatusToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="116"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="8">
        <Border x:Name="ToastCard"
                CornerRadius="16"
                Background="{DynamicResource Theme.SurfaceBrush}"
                BorderBrush="{DynamicResource Theme.CardSoftBorderBrush}"
                BorderThickness="1"
                Padding="12,10"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270"
                                  Opacity="0.32" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" X="42"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="58" Height="76" VerticalAlignment="Center"
                      HorizontalAlignment="Center" FlowDirection="LeftToRight">
                    <Ellipse Width="54" Height="54"
                             Fill="{DynamicResource Brush.RemoveHoverBg}"
                             Stroke="{DynamicResource Theme.DangerBorderBrush}"
                             StrokeThickness="1"
                             VerticalAlignment="Center"/>
                    <Image Source="pack://application:,,,/Resources/Irspeedy/Logo/logo-server-list.png"
                           Width="38" Height="52" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image.RenderTransform>
                            <RotateTransform Angle="-8" CenterX="19" CenterY="26"/>
                        </Image.RenderTransform>
                    </Image>
                    <Border Width="25" Height="25" CornerRadius="12.5"
                            Background="{DynamicResource Theme.DangerBrush}"
                            BorderBrush="{DynamicResource Theme.SurfaceBrush}"
                            BorderThickness="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M1.5,6.5 C4.8,3.5 10.2,3.5 13.5,6.5 M4.2,9.3 C6.2,7.5 8.8,7.5 10.8,9.3 M7.5,12.1 L7.6,12.1"
                                  Stroke="White" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform"/>
                            <Path Data="M2,2 L13,13" Stroke="White" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Opacity="0.55">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TextMutedBrush}" Margin="1,0"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" Margin="1,0,1,3"/>
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource TextMutedBrush}" Margin="1,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                    <TextBlock Text="اوه! اینترنت یک دنیا قطع شد :)"
                               FontFamily="{StaticResource AppFontFamilySemiBold}"
                               FontSize="15.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextAlignment="Right"/>
                    <TextBlock Text="منتظر برگشت شبکه هستیم…"
                               Margin="0,4,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,7,0,0" FlowDirection="RightToLeft">
                        <Ellipse Width="6" Height="6"
                                 Fill="{DynamicResource Theme.DangerBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="در حال بررسی شبکه"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="8"
                        Background="Transparent" Cursor="Hand"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        MouseLeftButtonUp="Close_MouseLeftButtonUp"
                        ToolTip="بستن">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10"
                          Stretch="Uniform"
                          Stroke="{DynamicResource IconMutedBrush}"
                          StrokeThickness="1.4"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>