                  <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                    <Run Text="تبلیغات گوگل" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <TextBlock FontSize="10.5" TextAlignment="Right" FlowDirection="LeftToRight">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="این محتوا آزاد است"/>
                        <Setter Property="Foreground" Value="#EF333B"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOn, ElementName=GoogleAdsToggle}" Value="True">
                            <Setter Property="Text" Value="این محتوا مسدود می‌شود"/>
                            <Setter Property="Foreground" Value="#17AB77"/>
                          </DataTrigger>
