                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <controls:ServiceToggle x:Name="GoogleAdsToggle" AutomationProperties.Name="GoogleAdsToggle" Grid.Column="0" FlowDirection="LeftToRight"/>
