<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:IRSpeedyVPN.Controls" x:Class="IRSpeedyVPN.Windows.SettingsHub" Title="تنظیمات سرویس" Width="381.6" Height="632" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SizeToContent="Manual">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Viewbox Stretch="Uniform" StretchDirection="Both" FlowDirection="LeftToRight" x:Name="DesignViewport">
    <Grid ClipToBounds="True" FlowDirection="LeftToRight" Width="420" Height="700">
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="68"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#EEF0F4" BorderThickness="0,0,0,1">
        <Grid Margin="16,0" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="16" Foreground="#141B33" TextAlignment="Right" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontWeight="Normal" HorizontalAlignment="Center">
              <Run Text="تنظیمات سرویس" FlowDirection="RightToLeft"/>
            </TextBlock>
            <TextBlock FontSize="10.5" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <Run Text="شخصی‌سازی رفتار اتصال" FlowDirection="RightToLeft"/>
            </TextBlock>
          </StackPanel>
          <Button Style="{StaticResource HandoffClose}" Click="Close_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="16,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Button Style="{StaticResource HandoffPlainButton}" x:Name="MethodsButton" Click="Methods_Click">
              <Border Height="72" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="13" Background="#F5F6F9" Grid.Column="0">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="#B7BCC9" StrokeThickness="2" Width="7" Height="12" Stretch="Uniform" FlowDirection="LeftToRight"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                      <Run Text="روش‌های اتصال" FlowDirection="RightToLeft"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                      <Run Text="وی‌پی‌ان سراسری، پروکسی سیستمی، پروکسی‌فایر" FlowDirection="RightToLeft"/>
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" Width="42" Height="42" CornerRadius="13" Background="#1A2563EB">
                    <Image Source="{StaticResource HandoffMethodsImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                  </Border>
                </Grid>
              </Border>
            </Button>
          </Grid>
          <Grid Grid.Row="1">
            <Button Style="{StaticResource HandoffPlainButton}" x:Name="ShieldButton" Click="Shield_Click">
              <Border Height="72" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="13" Background="#F5F6F9" Grid.Column="0">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="#B7BCC9" StrokeThickness="2" Width="7" Height="12" Stretch="Uniform" FlowDirection="LeftToRight"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                      <Run Text="شیلد" FlowDirection="RightToLeft"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                      <Run Text="محافظت در برابر تبلیغات و تهدیدهای آنلاین" FlowDirection="RightToLeft"/>
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" Width="42" Height="42" CornerRadius="13" Background="#1A16A34A">
                    <Image Source="{StaticResource HandoffShieldImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                  </Border>
                </Grid>
              </Border>
            </Button>
          </Grid>
          <Grid Grid.Row="2">
            <Button Style="{StaticResource HandoffPlainButton}" x:Name="ShareButton" Click="Share_Click">
              <Border Height="72" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="13" Background="#F5F6F9" Grid.Column="0">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="#B7BCC9" StrokeThickness="2" Width="7" Height="12" Stretch="Uniform" FlowDirection="LeftToRight"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                      <Run Text="اشتراک‌گذاری اتصال" FlowDirection="RightToLeft"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                      <Run Text="تبدیل این دستگاه به نقطه اتصال VPN" FlowDirection="RightToLeft"/>
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" Width="42" Height="42" CornerRadius="13" Background="#1A0891B2">
                    <Image Source="{StaticResource HandoffShareImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                  </Border>
                </Grid>
              </Border>
            </Button>
          </Grid>
          <Grid Grid.Row="3" x:Name="GameRow">
            <Border Height="72" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <controls:ServiceToggle x:Name="GameMode" AutomationProperties.Name="GameMode" Grid.Column="0" FlowDirection="LeftToRight"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                    <Run Text="حالت بازی" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                    <Run Text="کاهش تاخیر برای بازی‌های آنلاین" FlowDirection="RightToLeft"/>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Width="42" Height="42" CornerRadius="13" Background="#1A6366F1">
                  <Image Source="{StaticResource HandoffPadImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <Grid Grid.Row="4" x:Name="AiRow">
            <Border Height="72" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <controls:ServiceToggle x:Name="VodService" AutomationProperties.Name="VodService" Grid.Column="0" FlowDirection="LeftToRight"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                    <Run Text="هوش مصنوعی" FlowDirection="RightToLeft"/>
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                    <Run Text="IP ثابت جهت دسترسی به سرویس هوش مصنوعی" FlowDirection="RightToLeft"/>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Width="42" Height="42" CornerRadius="13" Background="#1AEC4899">
                  <Image Source="{StaticResource HandoffSparkImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <Grid Grid.Row="5">
            <Button Style="{StaticResource HandoffPlainButton}" x:Name="PasswordButton" Click="Password_Click">
              <Border Height="72" CornerRadius="18" Background="White" BorderBrush="#ECEEF3" BorderThickness="1" Padding="14,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="13" Background="#F5F6F9" Grid.Column="0">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="#B7BCC9" StrokeThickness="2" Width="7" Height="12" Stretch="Uniform" FlowDirection="LeftToRight"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock FontSize="14.5" Foreground="#1B2033" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="Bold">
                      <Run Text="تغییر رمز عبور" FlowDirection="RightToLeft"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#9CA3B4" TextAlignment="Right" FlowDirection="LeftToRight">
                      <Run Text="به‌روزرسانی رمز عبور حساب کاربری" FlowDirection="RightToLeft"/>
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" Width="42" Height="42" CornerRadius="13" Background="#1A64748B">
                    <Image Source="{StaticResource HandoffPasswordImage}" Width="21" Height="21" FlowDirection="LeftToRight"/>
                  </Border>
                </Grid>
              </Border>
            </Button>
          </Grid>
        </Grid>
      </Grid>
      <Button Grid.Row="2" Margin="16,0,16,18" Height="50" Style="{StaticResource DesignActionButton}" x:Name="SaveButton" Content="تایید و ذخیره" Click="btnOK_Click"/>
    </Grid>
  </Viewbox>
</Window>
