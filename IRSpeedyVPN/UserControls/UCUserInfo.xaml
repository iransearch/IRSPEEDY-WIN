<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="IRSpeedyVPN.UserControls.UCUserInfo" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged" Unloaded="Connected_Unloaded">
  <UserControl.Resources>
    <Storyboard x:Key="ConnectedGlowMotion" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ConnectedGlow" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.3" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ConnectedGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.94" To="1.08" Duration="0:0:1.3" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ConnectedGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.94" To="1.08" Duration="0:0:1.3" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="ConnectedRingMotion" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ConnectedRing" Storyboard.TargetProperty="Opacity" From="0.55" To="0.95" Duration="0:0:1.3" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ConnectedRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.035" Duration="0:0:1.3" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ConnectedRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.035" Duration="0:0:1.3" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="ConnectedExhaustMotion" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ExhaustLight" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="854" To="488" Duration="0:0:0.42"/>
    </Storyboard>
  </UserControl.Resources>
  <Grid Margin="22,4,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <Grid Width="336" Height="336" HorizontalAlignment="Center" Margin="0,2,0,8" ToolTip="برای ابزارهای اتصال راست‌کلیک کنید" FlowDirection="LeftToRight">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="اشتراک‌گذاری اتصال" Click="ShareMenu_Click"/>
            <MenuItem Header="تست اتصال" Click="TestMenu_Click"/>
            <MenuItem x:Name="baseServiceMenu" Header="تنظیم بصورت سرویس پایه" Click="BaseMenu_Click"/>
          </ContextMenu>
        </Grid.ContextMenu>
        <Ellipse x:Name="ConnectedGlow" RenderTransformOrigin="0.5,0.5">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#2917A366" Offset="0"/>
              <GradientStop Color="#0017A366" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <ScaleTransform/>
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="284" Height="284" Stroke="#4017A366" StrokeThickness="2" x:Name="ConnectedRing" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform/>
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="248" Height="248" Stroke="#2E17A366" StrokeThickness="1">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FFFFFF" Offset="0"/>
              <GradientStop Color="#F3FBF7" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect>
            <DropShadowEffect Color="#17A366" BlurRadius="32" ShadowDepth="15" Direction="270" Opacity="0.35"/>
          </Ellipse.Effect>
        </Ellipse>
        <Viewbox Width="136" Height="183" Stretch="Uniform" IsHitTestVisible="False">
          <Canvas Width="720" Height="968">
            <Image Source="/Resources/Irspeedy/Logo/logo-header.png" Width="720" Height="968" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Canvas Width="720" Height="968">
              <Canvas.Clip>
                <PathGeometry Figures="M335,584 L385,584 C385,650 413,746 360,854 C307,746 335,650 335,584 Z"/>
              </Canvas.Clip>
              <Rectangle x:Name="ExhaustLight" Width="90" Height="96" Canvas.Left="315" Opacity="0.65">
                <Rectangle.RenderTransform>
                  <TranslateTransform Y="854"/>
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFDF0" Offset="0"/>
                    <GradientStop Color="#CCFDE68A" Offset=".35"/>
                    <GradientStop Color="#FFFFFDF0" Offset=".5"/>
                    <GradientStop Color="#CCFB923C" Offset=".7"/>
                    <GradientStop Color="#00FB923C" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
            </Canvas>
          </Canvas>
        </Viewbox>
        <Border Width="72" Height="72" Background="{StaticResource ConnectedGreenBrush}" BorderBrush="White" BorderThickness="6" CornerRadius="36" VerticalAlignment="Bottom" Margin="0,0,0,4" x:Name="ConnectedCheckBadge">
          <Viewbox Width="26" Height="26" FlowDirection="LeftToRight"><Canvas Width="12" Height="12"><Path Data="M2.2,6.3 L4.8,8.9 L9.8,3.5" Stroke="White" StrokeThickness="1.8" FlowDirection="LeftToRight" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Canvas></Viewbox></Border>
      </Grid>
      <Grid>
        <Border Height="52" CornerRadius="14" BorderBrush="{StaticResource SmartLocationBorderBrush}" BorderThickness="1" Background="{StaticResource SmartLocationBackgroundBrush}" x:Name="ConnectedServerCard">
          <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgCountry" Width="30" Height="30" Stretch="UniformToFill">
              <Image.Clip>
                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
              </Image.Clip>
            </Image>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
              <TextBlock x:Name="txtCountry" FontSize="14" FontWeight="Bold" Foreground="#142057" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="txtServerDetail" FontSize="12" Foreground="#5B6BA8" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="btn_ChangeServer" Grid.Column="2" Width="32" Height="32" ToolTip="تغییر سرور" Click="btn_ChangeServer_Click" Background="#141E3A8A" Cursor="Hand">
              <Viewbox Width="17" Height="17" FlowDirection="LeftToRight"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconSwapServer}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" FlowDirection="LeftToRight" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas></Viewbox><Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="9">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>
        <Path x:Name="ServerCardShine" StrokeThickness="2" StrokeDashCap="Round" IsHitTestVisible="False" FlowDirection="LeftToRight" SizeChanged="ServerCard_SizeChanged" Stretch="None">
          <Path.Stroke>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Offset="0" Color="#0060A5FA"/>
              <GradientStop Offset=".5" Color="#FFFFFFFF"/>
              <GradientStop Offset="1" Color="#002563EB"/>
            </LinearGradientBrush>
          </Path.Stroke>
        </Path>
      </Grid>
      <Border Style="{StaticResource DesignInfoCard}" Margin="0,16,0,0" x:Name="ConnectedAccountCard" Height="106">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="14,0" Grid.Row="0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Viewbox Width="14" Height="14" FlowDirection="LeftToRight"><Canvas Width="16" Height="16"><Path Data="M8,4.6 L8,8 L10.4,9.4" Stroke="#9CA3B4" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <Ellipse Width="12" Height="12" Stroke="#9CA3B4" StrokeThickness="1.3" Canvas.Left="2" Canvas.Top="2"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="مدت زمان اتصال" FontSize="12" Foreground="#5B6478" VerticalAlignment="Center" FontFamily="{StaticResource AppFontFamilySemiBold}"/>
            <TextBlock Grid.Column="2" x:Name="txtConnectionTime" Text="00:00:00" FlowDirection="LeftToRight" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" VerticalAlignment="Center"/>
          </Grid>
          <Grid Margin="14,0" Grid.Row="2" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Viewbox Width="14" Height="14" FlowDirection="LeftToRight"><Canvas Width="16" Height="16"><Path Data="M4,3.2 L12,3.2 Q13.8,3.2 13.8,5 L13.8,11.8 Q13.8,13.6 12,13.6 L4,13.6 Q2.2,13.6 2.2,11.8 L2.2,5 Q2.2,3.2 4,3.2 M2.2,6.4 L13.8,6.4 M5.2,1.8 L5.2,4.2 M10.8,1.8 L10.8,4.2" Stroke="#9CA3B4" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas></Viewbox><TextBlock Grid.Column="1" Text="تاریخ انقضا" FontSize="12" Foreground="#5B6478" VerticalAlignment="Center" FontFamily="{StaticResource AppFontFamilySemiBold}"/>
            <TextBlock Grid.Column="2" x:Name="txtExpireDate" FlowDirection="LeftToRight" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" VerticalAlignment="Center"/>
          </Grid>
          <Grid Margin="14,0" Grid.Row="4" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Viewbox Width="14" Height="14" FlowDirection="LeftToRight"><Canvas Width="16" Height="16"><Path Data="M8,1.5 L13,3.5 L13,7.5 C13,11 10.8,13.4 8,14.5 C5.2,13.4 3,11 3,7.5 L3,3.5 Z" Stroke="#17A366" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas></Viewbox><TextBlock Grid.Column="1" Text="اعتبار باقی‌مانده" FontSize="12" Foreground="#5B6478" VerticalAlignment="Center" FontFamily="{StaticResource AppFontFamilySemiBold}"/>
            <TextBlock Grid.Column="2" x:Name="txtRemainedTime" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource ConnectedGreenBrush}" VerticalAlignment="Center"/>
          </Grid>
          <Border Height="1" Background="#EEF0F4" Grid.Row="1" Margin="14,0"/>
          <Border Height="1" Background="#EEF0F4" Grid.Row="3" Margin="14,0"/>
        </Grid>
      </Border>
      <TextBlock x:Name="txtServiceName" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
        <TextBlock Text="آی‌پی جدید شما: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBlock Text="—" FlowDirection="LeftToRight" FontSize="11.5" Foreground="#5B6478" ToolTip="آی‌پی عمومی در دسترس نیست" FontFamily="{StaticResource AppFontFamilySemiBold}"/>
      </StackPanel>
    </StackPanel>
    <Button x:Name="btnDisConnect" Grid.Row="1" Height="46" Margin="0,8,0,0" Background="{StaticResource DisconnectGradientBrush}" Style="{StaticResource DesignActionButton}" IsCancel="True" Click="btnDisConnect_Click" FontSize="15" FontWeight="Bold">
      <Button.Effect>
        <DropShadowEffect Color="#B91C1C" BlurRadius="14" ShadowDepth="5" Direction="270" Opacity="0.32"/>
      </Button.Effect>
      <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
        <Viewbox Width="16" Height="16" FlowDirection="LeftToRight" Margin="0,0,10,0"><Canvas Width="16" Height="16"><Path Data="M8,2 L8,7.2 M4.6,4.2 A5.2,5.2 0 1 0 11.4,4.2" Stroke="White" StrokeThickness="1.8"/>
        </Canvas></Viewbox><TextBlock Text="قطع اتصال" FlowDirection="RightToLeft"/>
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
