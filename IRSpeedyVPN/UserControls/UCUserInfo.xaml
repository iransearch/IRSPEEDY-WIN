<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="IRSpeedyVPN.UserControls.UCUserInfo" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged" Unloaded="Connected_Unloaded">
 <UserControl.Resources><Storyboard x:Key="ConnectedGlowMotion" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="ConnectedGlow" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.3" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="ConnectedGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.94" To="1.08" Duration="0:0:1.3" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="ConnectedGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.94" To="1.08" Duration="0:0:1.3" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard><Storyboard x:Key="ConnectedRingMotion" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="ConnectedRing" Storyboard.TargetProperty="Opacity" From="0.55" To="0.95" Duration="0:0:1.3" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="ConnectedRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.035" Duration="0:0:1.3" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="ConnectedRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.035" Duration="0:0:1.3" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard><Storyboard x:Key="ConnectedExhaustMotion" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="ExhaustLight" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="854" To="488" Duration="0:0:0.42"/></Storyboard></UserControl.Resources><Grid Margin="22,4,22,18">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
    <Grid Width="336" Height="336" HorizontalAlignment="Center" Margin="0,0,0,8" ToolTip="برای ابزارهای اتصال راست‌کلیک کنید" FlowDirection="LeftToRight">
     <Grid.ContextMenu><ContextMenu><MenuItem Header="اشتراک‌گذاری اتصال" Click="ShareMenu_Click"/><MenuItem Header="تست اتصال" Click="TestMenu_Click"/><MenuItem x:Name="baseServiceMenu" Header="تنظیم بصورت سرویس پایه" Click="BaseMenu_Click"/></ContextMenu></Grid.ContextMenu>
     <Ellipse x:Name="ConnectedGlow" RenderTransformOrigin="0.5,0.5"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#2917A366" Offset="0"/><GradientStop Color="#0017A366" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
     <Ellipse Width="284" Height="284" Stroke="#4017A366" StrokeThickness="2" x:Name="ConnectedRing" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
     <Ellipse Width="248" Height="248" Fill="{StaticResource ConnectedHeroBackgroundBrush}"/>
     <Viewbox Width="136" Height="183" Stretch="Uniform" IsHitTestVisible="False"><Canvas Width="720" Height="968"><Image Source="/Resources/Irspeedy/Logo/logo-header.png" Width="720" Height="968" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Canvas Width="720" Height="968"><Canvas.Clip><PathGeometry Figures="M335,584 L385,584 C385,650 413,746 360,854 C307,746 335,650 335,584 Z"/></Canvas.Clip><Rectangle x:Name="ExhaustLight" Width="90" Height="96" Canvas.Left="315" Opacity="0.65"><Rectangle.RenderTransform><TranslateTransform Y="854"/></Rectangle.RenderTransform><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFDF0" Offset="0"/><GradientStop Color="#CCFDE68A" Offset=".35"/><GradientStop Color="#FFFFFDF0" Offset=".5"/><GradientStop Color="#CCFB923C" Offset=".7"/><GradientStop Color="#00FB923C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Canvas></Canvas></Viewbox><Border Width="60" Height="60" Background="{StaticResource ConnectedGreenBrush}" BorderBrush="White" BorderThickness="6" CornerRadius="30" VerticalAlignment="Bottom" Margin="0,0,0,14">
      <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.5" Stretch="Uniform" Width="24" Height="24" FlowDirection="LeftToRight"/>
     </Border>
    </Grid>
    <Grid><Border Height="50" CornerRadius="14" BorderBrush="{StaticResource SmartLocationBorderBrush}" BorderThickness="1" Background="{StaticResource SmartLocationBackgroundBrush}" x:Name="ConnectedServerCard">
     <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image x:Name="imgCountry" Width="30" Height="30" Stretch="Uniform"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
       <TextBlock x:Name="txtCountry" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SmartLocationTitleBrush}" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="txtServerDetail" FontSize="12" Foreground="{StaticResource SmartLocationSubtitleBrush}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Button x:Name="btn_ChangeServer" Grid.Column="2" Width="32" Height="32" ToolTip="تغییر سرور" Style="{StaticResource DesignLinkButton}" Click="btn_ChangeServer_Click"><Path Data="{StaticResource IconSwapServer}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" FlowDirection="LeftToRight"/></Button>
     </Grid>
    </Border>
    <Path x:Name="ServerCardShine" Stroke="#F5FBFF" StrokeThickness="1.6" StrokeDashCap="Round" IsHitTestVisible="False" FlowDirection="LeftToRight" SizeChanged="ServerCard_SizeChanged" Stretch="None"/></Grid><Border Style="{StaticResource DesignInfoCard}" Margin="0,8,0,0">
     <StackPanel>
      <Grid Margin="14,7"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconClock}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3"/><TextBlock Grid.Column="1" Text="مدت زمان اتصال" FontSize="12" Foreground="{StaticResource IconStrokeBrush}"/><TextBlock Grid.Column="2" x:Name="txtConnectionTime" Text="00:00:00" FlowDirection="LeftToRight" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}"/></Grid>
      <Border Height="1" Background="{StaticResource StatCardDividerBrush}"/>
      <Grid Margin="14,7"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconCalendar}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3"/><TextBlock Grid.Column="1" Text="تاریخ انقضا" FontSize="12" Foreground="{StaticResource IconStrokeBrush}"/><TextBlock Grid.Column="2" x:Name="txtExpireDate" FlowDirection="LeftToRight" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}"/></Grid>
      <Border Height="1" Background="{StaticResource StatCardDividerBrush}"/>
      <Grid Margin="14,7"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconShield}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource ConnectedGreenBrush}" StrokeThickness="1.3"/><TextBlock Grid.Column="1" Text="اعتبار باقی‌مانده" FontSize="12" Foreground="{StaticResource IconStrokeBrush}"/><TextBlock Grid.Column="2" x:Name="txtRemainedTime" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource ConnectedGreenBrush}"/></Grid>
     </StackPanel>
    </Border>
    <TextBlock x:Name="txtServiceName" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><TextBlock Text="آی‌پی جدید شما: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="—" FlowDirection="LeftToRight" FontSize="11.5" Foreground="{StaticResource IconStrokeBrush}" ToolTip="آی‌پی عمومی در دسترس نیست"/></StackPanel>
   </StackPanel>
  <Button x:Name="btnDisConnect" Grid.Row="1" Height="46" Margin="0,8,0,0" Background="{StaticResource DisconnectGradientBrush}" Style="{StaticResource DesignActionButton}" IsCancel="True" Click="btnDisConnect_Click">
   <Button.Effect><DropShadowEffect Color="#B91C1C" BlurRadius="22" ShadowDepth="10" Direction="270" Opacity="0.45"/></Button.Effect>
   <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPower}" Stroke="White" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="قطع اتصال"/></StackPanel>
  </Button>
 </Grid>
</UserControl>
