<UserControl x:Class="IRSpeedyVPN.UserControls.UCUserInfo"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft"
 Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged">
 <Grid Margin="22,6,22,14">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Grid Width="100" Height="100" HorizontalAlignment="Center">
     <Ellipse Fill="#DAF0E7" Stroke="#C5E8D9" StrokeThickness="1.5"/>
     <Ellipse Width="74" Height="74" Fill="#F5FFFA"/>
     <Image Source="/Resources/Irspeedy/Logo/logo-header.png" Width="50" Height="50" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Border Width="28" Height="28" Background="{StaticResource ConnectedGreenBrush}" BorderBrush="White" BorderThickness="3" CornerRadius="14" VerticalAlignment="Bottom">
      <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="1.8" Stretch="Uniform" Width="12" Height="12"/>
     </Border>
    </Grid>
    <TextBlock Text="متصل" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontSize="18" Foreground="{StaticResource ConnectedGreenDarkBrush}" TextAlignment="Center" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding Text, ElementName=txtConnectionTime}" FontSize="14" Foreground="{StaticResource IconStrokeBrush}" FlowDirection="LeftToRight" TextAlignment="Center" Margin="0,2,0,10"/>
    <Border Height="54" CornerRadius="14" BorderBrush="{StaticResource SmartLocationBorderBrush}" BorderThickness="1" Background="{StaticResource SmartLocationBackgroundBrush}">
     <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image x:Name="imgCountry" Width="30" Height="30" Stretch="Uniform"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
       <TextBlock x:Name="txtCountry" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SmartLocationTitleBrush}" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="txtServerDetail" FontSize="12" Foreground="{StaticResource SmartLocationSubtitleBrush}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Button x:Name="btn_ChangeServer" Grid.Column="2" Content="تغییر" Style="{StaticResource DesignLinkButton}" Click="btn_ChangeServer_Click" FontSize="12.5"/>
     </Grid>
    </Border>
    <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource DesignInfoCard}" Padding="14,10"><StackPanel>
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDownload}" Stroke="{StaticResource ConnectedGreenBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"/><TextBlock Text="دانلود" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="8,0"/></StackPanel>
      <TextBlock Text="—" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" FlowDirection="LeftToRight" TextAlignment="Center" ToolTip="آمار مصرف در دسترس نیست"/>
     </StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource DesignInfoCard}" Padding="14,10"><StackPanel>
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconUpload}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"/><TextBlock Text="آپلود" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="8,0"/></StackPanel>
      <TextBlock Text="—" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}" FlowDirection="LeftToRight" TextAlignment="Center" ToolTip="آمار مصرف در دسترس نیست"/>
     </StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource DesignInfoCard}">
     <StackPanel>
      <Grid Margin="14,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconClock}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3"/><TextBlock Grid.Column="1" Text="مدت زمان اتصال" FontSize="12" Foreground="{StaticResource IconStrokeBrush}"/><TextBlock Grid.Column="2" x:Name="txtConnectionTime" Text="00:00:00" FlowDirection="LeftToRight" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}"/></Grid>
      <Border Height="1" Background="{StaticResource StatCardDividerBrush}"/>
      <Grid Margin="14,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconCalendar}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3"/><TextBlock Grid.Column="1" Text="تاریخ انقضا" FontSize="12" Foreground="{StaticResource IconStrokeBrush}"/><TextBlock Grid.Column="2" x:Name="txtExpireDate" FlowDirection="LeftToRight" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource RowTitleBrush}"/></Grid>
      <Border Height="1" Background="{StaticResource StatCardDividerBrush}"/>
      <Grid Margin="14,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconShield}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource ConnectedGreenBrush}" StrokeThickness="1.3"/><TextBlock Grid.Column="1" Text="اعتبار باقی‌مانده" FontSize="12" Foreground="{StaticResource IconStrokeBrush}"/><TextBlock Grid.Column="2" x:Name="txtRemainedTime" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource ConnectedGreenBrush}"/></Grid>
     </StackPanel>
    </Border>
    <TextBlock x:Name="txtServiceName" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><TextBlock Text="آی‌پی جدید شما: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="—" FlowDirection="LeftToRight" FontSize="11.5" Foreground="{StaticResource IconStrokeBrush}" ToolTip="آی‌پی عمومی در دسترس نیست"/></StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Button x:Name="btnDisConnect" Grid.Row="1" Height="50" Margin="0,10,0,0" Background="{StaticResource DisconnectGradientBrush}" Style="{StaticResource DesignActionButton}" IsCancel="True" Click="btnDisConnect_Click">
   <Button.Effect><DropShadowEffect Color="#B91C1C" BlurRadius="22" ShadowDepth="10" Direction="270" Opacity="0.45"/></Button.Effect>
   <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPower}" Stroke="White" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="قطع اتصال"/></StackPanel>
  </Button>
 </Grid>
</UserControl>
