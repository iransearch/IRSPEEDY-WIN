<UserControl x:Class="IRSpeedyVPN.UserControls.UCUserInfo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IRSpeedyVPN.Components.ServerListControl" Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,10,0,6">
  <Border Style="{StaticResource FluentCard}" Background="#DEFAEC" BorderBrush="White" BorderThickness="2" Padding="16,14"><StackPanel>
   <Border Background="#00C853" Width="42" Height="42" CornerRadius="21" HorizontalAlignment="Center"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource FluentIcons}" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="اتصال برقرار است" Foreground="#087936" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
   <TextBlock Text="شما با موفقیت به سرور متصل شدید" Style="{StaticResource FluentCaption}" TextAlignment="Center"/>
  </StackPanel></Border>
  <Border Style="{StaticResource FluentCard}" Margin="0,12,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
   <Button x:Name="btn_ChangeServer" Style="{StaticResource FluentButton}" Background="#E9F2FF" Foreground="{StaticResource AccentBrush}" FontSize="12" MinHeight="42" Padding="12,6" Content="تغییر سرور" Click="btn_ChangeServer_Click"/>
   <StackPanel Grid.Column="1" Margin="8,0" HorizontalAlignment="Right"><TextBlock Text="سرور فعال" Style="{StaticResource FluentCaption}" TextAlignment="Right"/><TextBlock x:Name="txtCountry" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right"/></StackPanel>
   <Image Grid.Column="2" x:Name="activeFlag" Height="28" Stretch="Uniform"/>
  </Grid></Border>
  <UniformGrid Columns="2" Margin="-4,6,-4,0">
   <Border Style="{StaticResource FluentCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="پینگ آخرین تست" Style="{StaticResource FluentCaption}" TextAlignment="Right"/><TextBlock x:Name="txtLatency" Text="—" FontSize="20" FontWeight="Bold" Foreground="#078438" TextAlignment="Right" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource FluentCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="مدت زمان اتصال" Style="{StaticResource FluentCaption}" TextAlignment="Right"/><TextBlock x:Name="txtConnectionTime" Text="00:00:00" FontSize="20" FontWeight="Bold" TextAlignment="Right" Margin="0,4,0,0"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource FluentCard}" Margin="0,6,0,0" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="IP فعال" Style="{StaticResource FluentCaption}" TextAlignment="Right"/><TextBlock x:Name="txtActiveIp" Text="اندازه‌گیری نشده" TextAlignment="Right" FontWeight="Medium"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="IP واقعی" Style="{StaticResource FluentCaption}" TextAlignment="Right"/><TextBlock x:Name="txtRealIp" ToolTip="IP ثبت‌شده پیش از اتصال این برنامه؛ VPN دیگری ممکن است روی آن اثر بگذارد" Text="اندازه‌گیری نشده" TextAlignment="Right" FontWeight="Medium"/></StackPanel>
  </Grid></Border>
  <Border Style="{StaticResource FluentCard}" Margin="0,8,0,0" Padding="12"><StackPanel>
   <TextBlock Text="اتصال فعال است" Foreground="#078438" FontWeight="Bold" TextAlignment="Right"/>
   <TextBlock x:Name="txtServiceName" Style="{StaticResource FluentCaption}" TextAlignment="Right"/>
   <TextBlock Text="وضعیت رمزنگاری به پروتکل سرور بستگی دارد" Style="{StaticResource FluentCaption}" TextAlignment="Right" FontSize="11"/>
  </StackPanel></Border>
  <Expander Header="اعتبار حساب" FlowDirection="RightToLeft" Margin="0,8"><StackPanel><TextBlock x:Name="txtExpireDate"/><TextBlock x:Name="txtRemainedTime"/></StackPanel></Expander>
  <Button x:Name="btnDisConnect" Style="{StaticResource FluentButton}" Background="#E53935" Click="btnDisConnect_Click"><Grid Width="280"><TextBlock Text="&#xE71A;" FontFamily="{StaticResource FluentIcons}" VerticalAlignment="Center"/><TextBlock Text="قطع اتصال" HorizontalAlignment="Center"/></Grid></Button>
 </StackPanel></ScrollViewer>
</UserControl>