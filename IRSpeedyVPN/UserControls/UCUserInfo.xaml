<UserControl x:Class="IRSpeedyVPN.UserControls.UCUserInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IRSpeedyVPN.UserControls"
             mc:Ignorable="d"
             Background="Transparent"
             Loaded="UserControl_Loaded"
             IsVisibleChanged="UserControl_IsVisibleChanged">

    <Grid>
        <StackPanel Margin="40 0">

            <Border BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="5"
                    Background="White"
                    Height="179">

                <!-- BAML shows width ~305 and a 2-row grid (icons row + content row) -->
                <Grid Width="305" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top icon buttons moved to main window header -->

                    <!-- Content area (RTL) -->
                    <StackPanel Grid.Row="1"
                                Margin="15,0,15,6"
                                Orientation="Vertical"
                                FlowDirection="RightToLeft">

                        <!-- سرویس -->
                        <StackPanel Orientation="Vertical" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="سرویس"
                                           Grid.Column="0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>

                                <TextBlock x:Name="txtServiceName"
                                           Grid.Column="1"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FlowDirection="RightToLeft"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Margin="0,2,0,0" Height="1" Background="#FFE5E5E5"/>
                        </StackPanel>

                        <!-- سرور -->
                        <StackPanel Orientation="Vertical" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="سرور"
                                           Grid.Column="0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtCountry"
                                           Grid.Column="1"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"
                                           FlowDirection="LeftToRight"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Margin="0,2,0,0" Height="1" Background="#FFE5E5E5"/>
                        </StackPanel>

                        <!-- مدت زمان اتصال -->
                        <StackPanel Orientation="Vertical" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="مدت زمان اتصال"
                                           Grid.Column="0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtConnectionTime"
                                           Grid.Column="1"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"
                                           FlowDirection="LeftToRight"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Margin="0,2,0,0" Height="1" Background="#FFE5E5E5"/>
                        </StackPanel>

                        <!-- تاریخ انقضاء -->
                        <StackPanel Orientation="Vertical" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="تاریخ انقضاء"
                                           Grid.Column="0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtExpireDate"
                                           Grid.Column="1"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"
                                           FlowDirection="LeftToRight"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Margin="0,2,0,0" Height="1" Background="#FFE5E5E5"/>
                        </StackPanel>

                        <!-- اعتبار باقیمانده (no separator in BAML at end) -->
                        <StackPanel Orientation="Vertical" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="اعتبار باقیمانده"
                                           Grid.Column="0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtRemainedTime"
                                           Grid.Column="1"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FlowDirection="RightToLeft"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <Button x:Name="btn_ChangeServer"
                    Style="{StaticResource RoundCornerGrey}"
                    Height="36"
                    Foreground="#000000"
                    Content="تغییــر ســرور"
                    Background="#FFD6D6D6"
                    Margin="0,8,0,0"
                    BorderBrush="{x:Null}"
                    Visibility="Collapsed"
                    Click="btn_ChangeServer_Click"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="btnDisConnect"
                        Style="{StaticResource RoundCorner}"
                        Content="قطع اتصال"
                        FontSize="18"
                        Margin="8"
                        IsCancel="True"
                        Click="btnDisConnect_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
