<UserControl x:Class="IRSpeedyVPN.UserControls.UCLogin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IRSpeedyVPN.UserControls"
             mc:Ignorable="d" Loaded="UserControl_Loaded"           >
    <UserControl.Resources>
        <ResourceDictionary>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Background="Transparent"
         
            CornerRadius="5">
            <Grid Margin="0 30 0 0">
                <StackPanel Margin="0">

                    <StackPanel Margin="40 0">
                        <Grid  Margin="4">
                            <TextBlock   FontSize="17" FontWeight="Bold" Text="نام کاربری" HorizontalAlignment="Right"  VerticalAlignment="Center" />

                            <TextBox x:Name="txtUsername" Style="{StaticResource RoundTextBox}" Margin="0"  HorizontalAlignment="Left" Width="230"  />
                        </Grid>
                        <Grid  Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248*"/>
                                <ColumnDefinition Width="51*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="Bold" Text="رمز عبور" HorizontalAlignment="Right"  Margin="0,10"  VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                            <TextBox Visibility="Hidden" IsReadOnly="True" x:Name="txtPasswordShow" Style="{StaticResource RoundTextBox}" Margin="0"  HorizontalAlignment="Left" Width="230"  />
                            <PasswordBox x:Name="txtPassword"  Style="{StaticResource RoundPasswordBox}" Margin="0"  HorizontalAlignment="Left" Width="230" />
                            <Image x:Name="imgEye"  HorizontalAlignment="right" Margin="0,11,23.721,9" Width="25" Source="{StaticResource eye}"  MouseDown="eye_MouseDown" MouseUp="eye_MouseUp"/>


                        </Grid>
                        <Grid Margin="0 0 0 0">
                            <CheckBox x:Name="chkRemember"  IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0"/>
                            <TextBlock FontSize="17" FontWeight="Bold" Text="مـــرا به خاطــر بسپـــار" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,0"/>
                        </Grid>
                        <Border x:Name="boxRenew" Visibility="Hidden" BorderBrush="Black"
             BorderThickness="1"
             CornerRadius="5"
              Background="White" >
                            <StackPanel Margin="0 0" Orientation="Horizontal">
                                <Button x:Name="btnRenew" Margin="5 0" Click="btnRenew_Click"
                                     Style="{StaticResource RoundCornerSmall}"  HorizontalContentAlignment="Center" >
                                    <TextBlock FontSize="18" FontWeight="Bold" Text="تمدید" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>

                                </Button>
                                <TextBlock  FontSize="15" FontWeight="Bold" Text="لطفا برای تمدید روی دکمه روبرو کلیک کنید" HorizontalAlignment="Center" Foreground="Green" VerticalAlignment="Bottom" Margin="0,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Button x:Name="btnLogin" Margin="10"
                            Style="{StaticResource RoundCorner}"
                                        Click="btnLogin_Click"  
                            Content="ورود" IsDefault="True" FontSize="20"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
