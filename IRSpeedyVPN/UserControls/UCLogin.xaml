<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="IRSpeedyVPN.UserControls.UCLogin" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
 <UserControl.Resources>
  <Style x:Key="Field" TargetType="Border">
   <Setter Property="Height" Value="48"/><Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,0"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource FieldFocusBorderBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="FieldText" TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/></Style>
 </UserControl.Resources>
 <StackPanel Margin="32,26,32,16">
   <Border Width="220" Height="220" CornerRadius="58" HorizontalAlignment="Center" Background="{StaticResource SmartLocationBackgroundBrush}" BorderBrush="#C9DBFB" BorderThickness="1"><Image Source="/Resources/Irspeedy/Logo/logo-header.png" Width="154" Height="208" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><Border.Effect><DropShadowEffect Color="#1E3A8A" Opacity="0.25" BlurRadius="32" ShadowDepth="15"/></Border.Effect></Border>
   <TextBlock Text="IRSPEEDY" FlowDirection="LeftToRight" TextAlignment="Center" FontFamily="{StaticResource AppFontFamilyExtraBold}" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,28,0,0"/>
   <TextBlock Text="دسترسی امن و پرسرعت به اینترنت" TextAlignment="Center" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,14"/>
   <TextBlock Text="نام کاربری" FontSize="12.5" Foreground="{StaticResource FieldLabelBrush}" Margin="0,0,0,6"/>
   <Border Style="{StaticResource Field}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Path Data="{StaticResource IconUser}" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform"/>
    <TextBox x:Name="txtUsername" TabIndex="0" Grid.Column="1" Style="{StaticResource FieldText}"/>
    <TextBlock Grid.Column="1" Text="نام کاربری خود را وارد کنید" FontSize="14" Foreground="{StaticResource FieldPlaceholderIconBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtUsername}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid></Border>
   <TextBlock Text="رمز عبور" FontSize="12.5" Foreground="{StaticResource FieldLabelBrush}" Margin="0,14,0,6"/>
   <Border Style="{StaticResource Field}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
    <Path Data="{StaticResource IconLock}" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform"/>
    <Grid Grid.Column="1">
     <TextBox x:Name="txtPasswordShow" TabIndex="1" Visibility="Hidden" IsReadOnly="True" Style="{StaticResource FieldText}"/>
     <PasswordBox x:Name="txtPassword" TabIndex="1" Background="White" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" PasswordChanged="txtPassword_PasswordChanged"/>
     <TextBlock x:Name="lblPasswordPlaceholder" Text="••••••••" Foreground="{StaticResource FieldPlaceholderIconBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <Button Grid.Column="2" Style="{StaticResource DesignLinkButton}" Click="TogglePassword_Click" ToolTip="نمایش یا پنهان کردن رمز عبور">
     <Path Data="{StaticResource IconEye}" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" Width="17" Height="17" Stretch="Uniform"/>
    </Button>
   </Grid></Border>
   <CheckBox x:Name="chkRemember" FontSize="11" IsChecked="True" Content="مرا به خاطر بسپار" Foreground="{StaticResource FieldLabelBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
   <Border x:Name="boxRenew" Visibility="Collapsed" Background="{StaticResource SmartLocationBackgroundBrush}" CornerRadius="12" Padding="8" Margin="0,12,0,0">
    <StackPanel Orientation="Horizontal"><TextBlock Text="اعتبار حساب پایان یافته است" VerticalAlignment="Center"/><Button x:Name="btnRenew" Content="تمدید" Click="btnRenew_Click" Style="{StaticResource DesignLinkButton}" Margin="12,0,0,0"/></StackPanel>
   </Border>
   <Button x:Name="btnLogin" Height="52" Margin="0,14,0,0" Style="{StaticResource DesignActionButton}" Click="btnLogin_Click" IsDefault="True">
    <StackPanel Orientation="Horizontal"><TextBlock Text="ورود"/><Path Data="{StaticResource IconArrowLeft}" FlowDirection="LeftToRight" Stroke="White" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" Margin="12,0,0,0"/></StackPanel>
   </Button>
   <Grid Margin="0,14,0,8" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Height="1" Background="#E5E8EF"/><TextBlock Grid.Column="1" Text="یا" TextAlignment="Center" Foreground="{StaticResource DividerTextBrush}"/><Border Grid.Column="2" Height="1" Background="#E5E8EF"/></Grid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed"><TextBlock Text="حساب کاربری ندارید؟" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><Button x:Name="btnSignup" Content="ثبت‌نام" Style="{StaticResource DesignLinkButton}" Click="Signup_Click"/></StackPanel>
  </StackPanel>
 </UserControl>
