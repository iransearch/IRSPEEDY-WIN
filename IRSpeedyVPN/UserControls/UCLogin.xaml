<UserControl x:Class="IRSpeedyVPN.UserControls.UCLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="UserControl_Loaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource FluentCard}" Padding="22" Margin="0,14,0,6">
 <StackPanel>
  <TextBlock Text="ورود به حساب" Style="{StaticResource FluentHeading}" HorizontalAlignment="Center"/>
  <TextBlock Text="به دنیای بدون محدودیت متصل شوید" Style="{StaticResource FluentCaption}" TextAlignment="Center" Margin="0,6,0,24"/>
  <TextBlock Text="نام کاربری" TextAlignment="Right" FontWeight="Medium" Margin="0,0,2,5"/>
  <Border Style="{StaticResource FluentField}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE77B;" FontFamily="{StaticResource FluentIcons}" FontSize="19" VerticalAlignment="Center" Margin="8,0,2,0"/><TextBox x:Name="txtUsername" Style="{StaticResource FluentInput}" TextAlignment="Right" AutomationProperties.Name="نام کاربری"/></DockPanel></Border>
  <TextBlock Text="رمز عبور" TextAlignment="Right" FontWeight="Medium" Margin="0,16,2,5"/>
  <Border Style="{StaticResource FluentField}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
   <Button Style="{StaticResource FluentIconButton}" Click="TogglePassword_Click" ToolTip="نمایش / مخفی کردن رمز عبور" AutomationProperties.Name="نمایش یا مخفی کردن رمز عبور"><Image x:Name="imgEye" Source="{StaticResource eye}" Width="20" Height="20"/></Button>
   <PasswordBox Grid.Column="1" x:Name="txtPassword" Style="{StaticResource FluentPassword}" AutomationProperties.Name="رمز عبور"/>
   <TextBox Grid.Column="1" x:Name="txtPasswordShow" Visibility="Collapsed" Style="{StaticResource FluentInput}" AutomationProperties.Name="رمز عبور نمایان"/>
   <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="{StaticResource FluentIcons}" FontSize="19" VerticalAlignment="Center" HorizontalAlignment="Right"/>
  </Grid></Border>
  <Grid Margin="0,20,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource AccentBrush}" Style="{StaticResource FluentButton}" FontSize="13" MinHeight="36" Padding="0" Content="بازیابی رمز عبور" Click="RecoverPassword_Click"/>
   <CheckBox Grid.Column="1" x:Name="chkRemember" IsChecked="True" FlowDirection="RightToLeft" Content="مرا به خاطر بسپار" VerticalAlignment="Center" FontSize="13"/>
  </Grid>
  <Border x:Name="boxRenew" Visibility="Collapsed" Background="#E6F7ED" CornerRadius="10" Padding="8" Margin="0,0,0,12"><DockPanel><Button x:Name="btnRenew" DockPanel.Dock="Left" Content="تمدید" Click="btnRenew_Click" Style="{StaticResource FluentButton}" MinHeight="36" FontSize="13"/><TextBlock Text="اعتبار حساب پایان یافته است" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"/></DockPanel></Border>
  <Button x:Name="btnLogin" Style="{StaticResource FluentButton}" Click="btnLogin_Click" IsDefault="True"><Grid Width="280"><TextBlock Text="&#xE72A;" FontFamily="{StaticResource FluentIcons}" VerticalAlignment="Center"/><TextBlock Text="ورود" HorizontalAlignment="Center"/></Grid></Button>
 </StackPanel></Border></ScrollViewer>
</UserControl>