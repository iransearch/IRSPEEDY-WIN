<UserControl x:Class="IRSpeedyVPN.UserControls.ConnectionTrafficPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}"
             FlowDirection="RightToLeft" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             Unloaded="Panel_Unloaded" AutomationProperties.Name="آمار مصرف برنامه‌ها" Foreground="{DynamicResource TextBodyBrush}">
  <UserControl.Resources>
    <Style x:Key="TrafficSmallButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SmartLocationBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SmartLocationBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrafficSummaryLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource IconStrokeBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TrafficSummaryValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="TrafficNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RowTitleBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="TrafficUnit" TargetType="TextBlock" BasedOn="{StaticResource TrafficSummaryLabel}">
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <!-- Match the server list's transparent rail and rounded 6-DIP thumb.
         Fade only the drawing, so hiding the rail never resizes the columns. -->
    <Style x:Key="TrafficScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrafficScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="Grip" Width="6" CornerRadius="3" Background="{DynamicResource Theme.ScrollThumbBrush}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrafficScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Rail" Background="Transparent" Opacity="1">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrafficScrollPage}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource TrafficScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrafficScrollPage}"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"/>
                  <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"/>
                  <Condition Binding="{Binding IsMouseCaptureWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.65" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrafficColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource IconStrokeBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StatCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="Center" FlowDirection="RightToLeft">
                <ContentPresenter/>
                <TextBlock x:Name="SortMark" Text="↓" Margin="4,0,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="SortMark" Property="Text" Value="↑"/>
                <Setter TargetName="SortMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="SortMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrafficRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource RowTitleBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SmartLocationBackgroundBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TrafficCell" TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="Foreground" Value="{DynamicResource RowTitleBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border Style="{StaticResource DesignInfoCard}" CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>
      <Grid Margin="16,14,16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="مصرف برنامه‌ها" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock x:Name="TrafficSubtitle" Text="مصرف ثبت‌شده از آخرین ریست" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource IconStrokeBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ResetTrafficButton" Width="30" Height="30" Style="{StaticResource TrafficSmallButton}"
                  Click="Reset_Click" ToolTip="ریست آمار مصرف" AutomationProperties.Name="ریست آمار مصرف">
            <Viewbox Width="15" Height="15"><Canvas Width="16" Height="16">
              <Path Data="M12.6,5.4 A5,5 0 1 0 13,9 M12.6,1.8 L12.6,5.5 L8.9,5.5"
                    Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas></Viewbox>
          </Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="16,0,16,10" Padding="2,8" CornerRadius="12" Background="{DynamicResource WindowBackgroundFallbackBrush}"
              ToolTip="مجموع مصرف ثبت‌شدهٔ برنامه‌هایی که از کور عبور کرده‌اند">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="دانلود" Style="{StaticResource TrafficSummaryLabel}"/>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <TextBlock x:Name="DownloadSummary" Style="{StaticResource TrafficSummaryValue}"/>
              <TextBlock x:Name="DownloadSummaryUnit" Text="B" Style="{StaticResource TrafficUnit}" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="{DynamicResource StatCardBorderBrush}" BorderThickness="1,0">
            <StackPanel>
              <TextBlock Text="آپلود" Style="{StaticResource TrafficSummaryLabel}"/>
              <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                <TextBlock x:Name="UploadSummary" Style="{StaticResource TrafficSummaryValue}"/>
                <TextBlock x:Name="UploadSummaryUnit" Text="B" Style="{StaticResource TrafficUnit}" VerticalAlignment="Center" Margin="3,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2">
            <TextBlock Text="مجموع" Style="{StaticResource TrafficSummaryLabel}"/>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <TextBlock x:Name="TotalSummary" Style="{StaticResource TrafficSummaryValue}"/>
              <TextBlock x:Name="TotalSummaryUnit" Text="B" Style="{StaticResource TrafficUnit}" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <DataGrid x:Name="TrafficTable" Grid.Row="2" Margin="12,0" FlowDirection="LeftToRight"
                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0"
                RowHeight="36" ColumnHeaderHeight="34" BorderThickness="0" Background="Transparent"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource StatCardDividerBrush}"
                RowStyle="{StaticResource TrafficRow}" CellStyle="{StaticResource TrafficCell}"
                ColumnHeaderStyle="{StaticResource TrafficColumnHeader}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True"
                AutomationProperties.Name="دانلود، آپلود و مجموع مصرف هر برنامه">
        <DataGrid.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource TrafficScrollBar}"/>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTextColumn Header="برنامه" Binding="{Binding Name}" SortMemberPath="Name" Width="1.3*" MinWidth="72">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="ToolTip" Value="{Binding Name}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="دانلود" SortMemberPath="DownloadBytes" Width="*" MinWidth="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource TrafficNumber}">
                  <TextBlock.Text><MultiBinding StringFormat="{}{0} {1}"><Binding Path="Download.ValueText"/><Binding Path="Download.Unit"/></MultiBinding></TextBlock.Text>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="آپلود" SortMemberPath="UploadBytes" Width="*" MinWidth="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource TrafficNumber}">
                  <TextBlock.Text><MultiBinding StringFormat="{}{0} {1}"><Binding Path="Upload.ValueText"/><Binding Path="Upload.Unit"/></MultiBinding></TextBlock.Text>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="مجموع" SortMemberPath="TotalBytes" Width="*" MinWidth="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource TrafficNumber}">
                  <TextBlock.Text><MultiBinding StringFormat="{}{0} {1}"><Binding Path="Total.ValueText"/><Binding Path="Total.Unit"/></MultiBinding></TextBlock.Text>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyTrafficText" Grid.Row="2" Text="هنوز مصرفی ثبت نشده است" Margin="20,45,20,0"
                 VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource IconStrokeBrush}"
                 IsHitTestVisible="False"/>
      <Border Grid.Row="3" BorderBrush="{DynamicResource StatCardDividerBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource WindowBackgroundFallbackBrush}" CornerRadius="0,0,18,18" Padding="16,0">
        <Grid>
          <TextBlock x:Name="TrafficCount" Text="۰ برنامه" FontSize="11" Foreground="{DynamicResource IconStrokeBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Ellipse x:Name="TrafficStatusDot" Width="5" Height="5" Fill="{DynamicResource ConnectedGreenBrush}" Margin="0,0,5,0"/>
            <TextBlock x:Name="TrafficStatus" Text="در انتظار آمار" FontSize="10" MaxWidth="235" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IconStrokeBrush}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="ResetConfirmation" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource Theme.OverlayBrush}" CornerRadius="18" Padding="22">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="آمار مصرف صفر شود؟" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="مصرف ذخیره‌شدهٔ همهٔ برنامه‌ها پاک می‌شود و شمارش از همین لحظه ادامه پیدا می‌کند."
                     TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,12,0,18" Foreground="{DynamicResource IconStrokeBrush}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ConfirmResetButton" Content="ریست آمار" Padding="14,9" Style="{StaticResource TrafficSmallButton}" Click="ConfirmReset_Click"/>
            <Button x:Name="CancelResetButton" Content="انصراف" Padding="14,9" Margin="10,0,0,0" Style="{StaticResource TrafficSmallButton}" Click="CancelReset_Click"/>
          </StackPanel>
          <TextBlock x:Name="ResetError" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Margin="0,12,0,0" Foreground="{DynamicResource Theme.DangerBrush}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
