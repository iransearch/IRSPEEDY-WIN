<UserControl x:Class="IRSpeedyVPN.UserControls.ConnectionTrafficPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}"
             FlowDirection="RightToLeft" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             AutomationProperties.Name="آمار مصرف برنامه‌ها، دادهٔ نمایشی">
  <UserControl.Resources>
    <Style x:Key="TrafficSummaryLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource IconStrokeBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TrafficSummaryValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style x:Key="TrafficNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource RowTitleBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style x:Key="TrafficUnit" TargetType="TextBlock" BasedOn="{StaticResource TrafficSummaryLabel}">
      <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style x:Key="TrafficColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{StaticResource IconStrokeBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource StatCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="Center" FlowDirection="RightToLeft">
                <ContentPresenter/>
                <TextBlock x:Name="SortMark" Text="↓" Margin="4,0,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="SortMark" Property="Text" Value="↑"/>
                <Setter TargetName="SortMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="SortMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrafficRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource RowTitleBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SmartLocationBackgroundBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TrafficCell" TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="Foreground" Value="{StaticResource RowTitleBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border Style="{StaticResource DesignInfoCard}" CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>
      <Grid Margin="16,14,16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="مصرف برنامه‌ها" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="دانلود و آپلود این اتصال" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource IconStrokeBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" Padding="8,4" CornerRadius="7" VerticalAlignment="Center" Background="{StaticResource SmartLocationBackgroundBrush}">
          <TextBlock Text="دادهٔ نمایشی" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
        </Border>
      </Grid>
      <Border Grid.Row="1" Margin="16,0,16,10" Padding="2,8" CornerRadius="12" Background="{StaticResource WindowBackgroundFallbackBrush}"
              ToolTip="جمع مقادیر نمایشی جدول؛ اعداد تصویر گرد شده‌اند">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="دانلود" Style="{StaticResource TrafficSummaryLabel}"/>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <TextBlock x:Name="DownloadSummary" Style="{StaticResource TrafficSummaryValue}"/>
              <TextBlock Text="MiB" Style="{StaticResource TrafficUnit}" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="{StaticResource StatCardBorderBrush}" BorderThickness="1,0">
            <StackPanel>
              <TextBlock Text="آپلود" Style="{StaticResource TrafficSummaryLabel}"/>
              <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                <TextBlock x:Name="UploadSummary" Style="{StaticResource TrafficSummaryValue}"/>
                <TextBlock Text="MiB" Style="{StaticResource TrafficUnit}" VerticalAlignment="Center" Margin="3,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2">
            <TextBlock Text="مجموع" Style="{StaticResource TrafficSummaryLabel}"/>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center">
              <TextBlock x:Name="TotalSummary" Style="{StaticResource TrafficSummaryValue}"/>
              <TextBlock Text="MiB" Style="{StaticResource TrafficUnit}" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <DataGrid x:Name="TrafficTable" Grid.Row="2" Margin="12,0" FlowDirection="LeftToRight"
                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0"
                RowHeight="43" ColumnHeaderHeight="34" BorderThickness="0" Background="Transparent"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource StatCardDividerBrush}"
                RowStyle="{StaticResource TrafficRow}" CellStyle="{StaticResource TrafficCell}"
                ColumnHeaderStyle="{StaticResource TrafficColumnHeader}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True"
                AutomationProperties.Name="دانلود، آپلود و مجموع مصرف نمایشی هر برنامه">
        <DataGrid.Columns>
          <DataGridTextColumn Header="برنامه" Binding="{Binding Name}" SortMemberPath="Name" Width="1.65*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Name}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="دانلود" SortMemberPath="DownloadBytes" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><StackPanel><TextBlock Text="{Binding Download.ValueText}" Style="{StaticResource TrafficNumber}"/><TextBlock Text="{Binding Download.Unit}" Style="{StaticResource TrafficUnit}"/></StackPanel></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="آپلود" SortMemberPath="UploadBytes" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><StackPanel><TextBlock Text="{Binding Upload.ValueText}" Style="{StaticResource TrafficNumber}"/><TextBlock Text="{Binding Upload.Unit}" Style="{StaticResource TrafficUnit}"/></StackPanel></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="مجموع" SortMemberPath="TotalBytes" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><StackPanel><TextBlock Text="{Binding Total.ValueText}" Style="{StaticResource TrafficNumber}"/><TextBlock Text="{Binding Total.Unit}" Style="{StaticResource TrafficUnit}"/></StackPanel></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Row="3" BorderBrush="{StaticResource StatCardDividerBrush}" BorderThickness="0,1,0,0"
              Background="{StaticResource WindowBackgroundFallbackBrush}" CornerRadius="0,0,18,18" Padding="16,0">
        <Grid>
          <TextBlock Text="۷ برنامه · دادهٔ نمایشی" FontSize="11" Foreground="{StaticResource IconStrokeBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Ellipse Width="5" Height="5" Fill="{StaticResource ConnectedGreenBrush}" Margin="0,0,5,0"/>
            <TextBlock Text="اتصال برقرار است" FontSize="11" Foreground="{StaticResource IconStrokeBrush}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
