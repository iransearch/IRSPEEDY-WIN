<UserControl x:Class="IRSpeedyVPN.UserControls.UCUpdate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IRSpeedyVPN.UserControls"
             mc:Ignorable="d" Background="Transparent" Loaded="UserControl_Loaded" >

    <Grid>

        <StackPanel Margin="40 0">
            <Border BorderBrush="Black"
             BorderThickness="1"
             CornerRadius="5"
              Background="White" Height="179">
                <Grid  HorizontalAlignment="Center" Width="330"  >
                    <StackPanel Margin="0" >

                        <StackPanel Margin="30 0" >

                            <Grid Margin="3 3 3 0">
                                <TextBlock x:Name="txbTitle" Text="بروزرسانی جدیدی یافت شد لطفا برای استفاده از سرویس بروزرسانی نمایید" HorizontalAlignment="Center" TextAlignment="Center" FontSize="15" TextWrapping="Wrap" />

                            </Grid>
                            <Grid Margin="3 -2 3 0">

                                <TextBlock Text="نسخه" HorizontalAlignment="Right" Grid.Column="1" Height="22" FontSize="15"/>
                                <TextBlock x:Name="txtVersion" Text="عادی" HorizontalAlignment="Left" TextAlignment="Left" Height="22" FlowDirection="LeftToRight"  TextWrapping="Wrap" Width="137"  Background="{x:Null}" Grid.ColumnSpan="2" FontSize="15"/>
                            </Grid>






                        </StackPanel>
                        <Grid Margin="20,40" x:Name="gridUpdate" Visibility="Collapsed">
                            <ProgressBar x:Name="progress" Minimum="0" Maximum="100" BorderBrush="Gray"></ProgressBar>
                            <TextBlock x:Name="txbProgress" HorizontalAlignment="Center" Foreground="White" FontFamily="Arial"></TextBlock>
                        </Grid>
                        <Grid Margin="0,0,10,0" x:Name="gridExplain" HorizontalAlignment="Right" Width="310">
                            <Border BorderBrush="Gray"
             BorderThickness="1"
             
              Background="White" >
                                <ScrollViewer Height="100" Padding="5" >
                                    <TextBlock x:Name="txtComment" Text="توضیحات" HorizontalAlignment="Stretch" TextAlignment="Right" TextWrapping="Wrap"  FontSize="12"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="66,0">
                
                <Button x:Name="btnDownload" Margin="10,3,10,10"
                            Style="{StaticResource RoundCorner}" 
                                        Click="btnDownload_Click"
                            Content="دریافت بروزرسانی" IsCancel="True" FontSize="20"/>
            </StackPanel>
        </StackPanel>
        

    </Grid>

</UserControl>
