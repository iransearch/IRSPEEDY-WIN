<UserControl x:Class="IRSpeedyVPN.UserControls.UCChangePassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IRSpeedyVPN.UserControls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Background="Transparent"
         
            CornerRadius="5">
            <Grid Margin="0 30 0 0">
                <Label x:Name="btnBack" Style="{StaticResource LabelButton}" Content="&#xf060;" Background="{x:Null}"  Foreground="#172458" FontFamily="{StaticResource fa_ProLight}" FontSize="20"
                                 ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="2000" ToolTipService.BetweenShowDelay="10000" ToolTip="بازگشت" PreviewMouseDown="btnBack_PreviewMouseDown" HorizontalAlignment="Right" Margin="0,-30,10,0"/>
                <StackPanel Margin="0">

                    <StackPanel Margin="40 0">
                        <Grid  Margin="4">
                            <TextBlock   FontSize="17" FontWeight="Bold" Text="رمز عبور فعلی" HorizontalAlignment="Right"  VerticalAlignment="Center" />

                            <TextBox x:Name="txtPassword" Style="{StaticResource RoundTextBox}" Margin="0"  HorizontalAlignment="Left" Width="210"  />
                        </Grid>
                        <Grid  Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248*"/>
                                <ColumnDefinition Width="51*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="Bold" Text="رمز عبور جدید" HorizontalAlignment="Right"  Margin="0,10"  VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                            <TextBox x:Name="txtNewPassword" Style="{StaticResource RoundTextBox}" Margin="0"  HorizontalAlignment="Left" Width="210"  />


                        </Grid>

                        <Border x:Name="boxRenew" Visibility="Hidden" BorderBrush="Black"
             BorderThickness="1"
             CornerRadius="5"
              Background="White" >

                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Button x:Name="btnChangePassword" Margin="10 50 10 0"
                            Style="{StaticResource RoundCorner}"
                                        Click="btnChangePassword_Click"  
                            Content="تغییر رمز عبور" IsDefault="True" FontSize="20" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
