<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:IRSpeedyVPN.Components.ServerListControl" x:Class="IRSpeedyVPN.UserControls.UCServerList" mc:Ignorable="d" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged">
  <!--
        DESIGN-SPEC §3 "Content area": the service/protocol pickers (removed —
        the app now connects through a single default service, "xfast") are
        gone; only the server-selection UI ships here: search, Smart Location
        card + country rows (ServerCountryPicker), Connect button.
    -->
  <Grid Margin="18,4,18,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- Search field -->
    <Border Grid.Row="0" Height="46" CornerRadius="12" Background="White" BorderBrush="{StaticResource SearchBorderBrush}" BorderThickness="1">

      <Grid Margin="14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="txtSearch" Grid.Column="1" Background="White" BorderThickness="0" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextBodyBrush}" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" TextAlignment="Right" TextChanged="txtSearch_TextChanged" Language="fa-IR" AutomationProperties.Name="جستجوی سرورها"/>
        <TextBlock Grid.Column="1" FontFamily="{StaticResource AppFontFamily}" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run FlowDirection="RightToLeft" Text="جستجوی سرورها"/>
        </TextBlock>
        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stretch="Uniform" Width="16" Height="16" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0" FlowDirection="LeftToRight"/>
      </Grid>
    </Border>
    <!-- Smart Location + server rows -->
    <local:ServerCountryPicker x:Name="countryPicker" Grid.Row="1" Margin="0,12,0,0"/>
    <!-- Connect button -->
    <Button x:Name="btnConnect" Grid.Row="2" Height="56" Margin="0,12,0,0" Click="btnConnect_Click" Cursor="Hand" AutomationProperties.Name="اتصال">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="bd">
          <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
          <Border CornerRadius="{StaticResource ConnectButtonCornerRadius}" Background="{StaticResource AccentGradientBrush}">
            <Border.Effect>
              <DropShadowEffect x:Name="ConnectShadow" Color="#1E3A8A" Opacity="0.5" BlurRadius="22" ShadowDepth="10" Direction="270"/>
            </Border.Effect>
          </Border>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource IconArrowLeft}" Stretch="Uniform" Width="16" Height="16" Stroke="White" StrokeThickness="1.8" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="اتصال" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-1" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="BlurRadius" To="28" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</UserControl>
