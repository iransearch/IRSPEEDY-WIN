<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:IRSpeedyVPN.Components.ServerListControl" xmlns:res="clr-namespace:IRSpeedyVPN.Residential" x:Class="IRSpeedyVPN.UserControls.UCServerList" mc:Ignorable="d" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged" Foreground="{DynamicResource TextBodyBrush}">
  <!--
        DESIGN-SPEC §3 "Content area": the service/protocol pickers (removed —
        the app now connects through a single default service, "xfast") are
        gone; only the server-selection UI ships here: search, Smart Location
        card + country rows (ServerCountryPicker), Connect button.
    -->
  <UserControl.Resources>
    <Style x:Key="TabKeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="-2" BorderBrush="#AAB4FF" BorderThickness="1.5" CornerRadius="11"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ServiceTab" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource TabKeyboardFocus}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#A3ADC7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid><Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="9"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabSurface" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A5BC0" Offset="0"/><GradientStop Color="#2F4A9C" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="18,4,18,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- Search field -->
    <Border Grid.Row="0" Height="46" CornerRadius="12" Background="{DynamicResource Theme.SurfaceBrush}" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1">

      <Grid Margin="14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="txtSearch" Grid.Column="1" Background="{DynamicResource Theme.SurfaceBrush}" BorderThickness="0" FlowDirection="LeftToRight" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextBodyBrush}" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" TextAlignment="Right" TextChanged="txtSearch_TextChanged" Language="fa-IR" AutomationProperties.Name="جستجوی سرورها" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Grid.Column="1" FontFamily="{StaticResource AppFontFamily}" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run FlowDirection="RightToLeft" Text="جستجوی سرورها"/>
        </TextBlock>
        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stretch="Uniform" Width="16" Height="16" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0" FlowDirection="LeftToRight"/>
      </Grid>
    </Border>
    <!-- Smart Location + server rows -->
    <Grid Grid.Row="1" Height="46" Margin="0,10,0,0" FlowDirection="LeftToRight">
      <Border Background="#1C2331" BorderBrush="#2D3850" BorderThickness="1" CornerRadius="12"/>
      <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <RadioButton x:Name="vpnTab" GroupName="ServiceKind" IsChecked="True" Style="{StaticResource ServiceTab}" Checked="ServiceTab_Checked" PreviewKeyDown="ServiceTab_KeyDown" AutomationProperties.Name="VPN">
          <StackPanel Orientation="Horizontal"><Path Width="17" Height="18" Margin="0,0,7,0" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Data="M9,1 L16,4 V10 C16,14 12,17 9,19 C6,17 2,14 2,10 V4 Z"/><TextBlock Text="VPN"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="residentialTab" Grid.Column="1" GroupName="ServiceKind" Style="{StaticResource ServiceTab}" Checked="ServiceTab_Checked" PreviewKeyDown="ServiceTab_KeyDown" AutomationProperties.Name="Residential">
          <StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,7,0" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Data="M1,9 L10,1 19,9 M4,7 V19 H8 V12 H12 V19 H16 V7"/><TextBlock Text="Residential"/></StackPanel>
        </RadioButton>
      </Grid>
    </Grid>
    <res:ResidentialTrafficBar x:Name="trafficBar" Grid.Row="2"/>
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <local:ServerCountryPicker x:Name="vpnCountryPicker"/>
      <local:ServerCountryPicker x:Name="residentialCountryPicker" ShowSmartCard="False" Visibility="Collapsed"/>
    </Grid>
    <!-- Connect button -->
    <Button x:Name="btnConnect" ToolTipService.ShowOnDisabled="True" Grid.Row="4" Content="اتصال" Background="{DynamicResource AccentGradientBrush}" Height="56" Margin="0,12,0,0" Click="btnConnect_Click" Cursor="Hand" AutomationProperties.Name="اتصال">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="bd">
          <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
          <Border x:Name="ConnectSurface" CornerRadius="{StaticResource ConnectButtonCornerRadius}" Background="{TemplateBinding Background}">
            <Border.Effect>
              <DropShadowEffect x:Name="ConnectShadow" Color="{DynamicResource AccentColor}" Opacity="0.5" BlurRadius="22" ShadowDepth="10" Direction="270"/>
            </Border.Effect>
          </Border>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource IconArrowLeft}" Stretch="Uniform" Width="16" Height="16" Stroke="White" StrokeThickness="1.8" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="{TemplateBinding Content}" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/><Setter TargetName="ConnectSurface" Property="Effect" Value="{x:Null}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-1" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="BlurRadius" To="28" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="ConnectShadow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</UserControl>


