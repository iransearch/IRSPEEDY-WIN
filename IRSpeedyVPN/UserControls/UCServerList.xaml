<UserControl x:Class="IRSpeedyVPN.UserControls.UCServerList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IRSpeedyVPN.Components.ServerListControl"
             mc:Ignorable="d" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded"
             IsVisibleChanged="UserControl_IsVisibleChanged">

    <!--
        DESIGN-SPEC §3 "Content area": the service/protocol pickers (removed —
        the app now connects through a single default service, "xfast") are
        gone; only the server-selection UI ships here: search, Smart Location
        card + country rows (ServerCountryPicker), Connect button.
    -->
    <Grid Margin="18,4,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search field -->
        <Border Grid.Row="0" Height="44" CornerRadius="12" Background="White"
                BorderBrush="{StaticResource SearchBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#101828" Opacity="0.03" BlurRadius="2" ShadowDepth="1" Direction="270"/>
            </Border.Effect>
            <Grid Margin="14,0" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Grid.Column="1" Background="White" BorderThickness="0" FlowDirection="RightToLeft"
                         FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
                         Foreground="{StaticResource TextBodyBrush}" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Stretch" TextAlignment="Right" TextChanged="txtSearch_TextChanged"/>
                <TextBlock Grid.Column="1" Text="جستجوی سرورها" FontFamily="{StaticResource AppFontFamily}" FlowDirection="RightToLeft" HorizontalAlignment="Stretch"
                           FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stretch="Uniform"
                      Width="16" Height="16" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                      VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Grid>
        </Border>

        <!-- Smart Location + server rows -->
        <local:ServerCountryPicker x:Name="countryPicker" Grid.Row="1" Margin="0,12,0,0"/>

        <!-- Connect button -->
        <Button x:Name="btnConnect" Grid.Row="2" Height="56" Margin="0,12,0,0"
                Click="btnConnect_Click" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource ConnectButtonCornerRadius}"
                            Background="{StaticResource AccentGradientBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#1E3A8A" Opacity="0.5" BlurRadius="22" ShadowDepth="10" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اتصال" FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold"
                                       FontSize="{StaticResource FontSizeTitle}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <Path Grid.Column="1" Data="{StaticResource IconArrowLeft}" Stretch="Uniform" FlowDirection="LeftToRight"
                                  Width="16" Height="16" Stroke="White" StrokeThickness="1.8"
                                  VerticalAlignment="Center" Margin="0,0,22,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
