<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Theme-dependent brushes are defined in both complete application palettes. -->
  <!-- Color roles shared by every page; values come from the selected palette. -->
  <SolidColorBrush x:Key="Theme.TransparentBrush" Color="Transparent"/>
</ResourceDictionary>
