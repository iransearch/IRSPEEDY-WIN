<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:uc="clr-namespace:IRSpeedyVPN.Components.ServerListControl">
 <Geometry x:Key="IconBolt">M13,2 L3,14 L11,14 L9,22 L19,10 L11,10 Z</Geometry>
 <Geometry x:Key="IconStar">M12,2 L14.9,8.6 L22,9.3 L16.6,14 L18.2,21 L12,17.3 L5.8,21 L7.4,14 L2,9.3 L9.1,8.6 Z</Geometry>
 <Geometry x:Key="ComboArrow">M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z</Geometry>
 <Geometry x:Key="SignalBase">M0,12 H3 V17 H0 Z M5,9 H8 V17 H5 Z M10,6 H13 V17 H10 Z M15,3 H18 V17 H15 Z M20,0 H23 V17 H20 Z</Geometry>
 <uc:CountryFlagConverter x:Key="CountryFlag"/>
 <Style x:Key="ServerCardButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
  <Setter Property="Background" Value="#EBFFFFFF"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="BorderBrush" Value="#D9E7F9"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="12,10"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsSelectedCountry}" Value="True"><Setter Property="Background" Value="#E2EEFF"/><Setter Property="BorderBrush" Value="#0066FF"/></DataTrigger></Style.Triggers>
 </Style>
 <DataTemplate x:Key="SmartCardTemplate">
  <Button AutomationProperties.Name="اتصال هوشمند">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ServerCardButton}"><Setter Property="Background" Value="#E7F2FF"/><Setter Property="BorderBrush" Value="#C3DCFF"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#0066FF"/></DataTrigger></Style.Triggers></Style></Button.Style>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
    <Path Data="{StaticResource IconBolt}" Fill="#0066FF" Width="23" Height="30" Stretch="Uniform" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="اتصال هوشمند" FontWeight="Bold" TextAlignment="Right"/><TextBlock Text="بهترین سرور بر اساس نتیجه تست" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0"><Image Source="{Binding Source=de, Converter={StaticResource CountryFlag}}" Width="19" Height="13" Margin="3,0"/><Image Source="{Binding Source=nl, Converter={StaticResource CountryFlag}}" Width="19" Height="13" Margin="3,0"/><Image Source="{Binding Source=tr, Converter={StaticResource CountryFlag}}" Width="19" Height="13" Margin="3,0"/><Image Source="{Binding Source=fr, Converter={StaticResource CountryFlag}}" Width="19" Height="13" Margin="3,0"/></StackPanel>
    </StackPanel>
    <Grid Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center"><Ellipse Stroke="#8D9DB5" StrokeThickness="1.5"/><Ellipse Margin="4" Fill="#0066FF"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></Grid>
   </Grid>
  </Button>
 </DataTemplate>
 <DataTemplate x:Key="GroupCardTemplate">
  <Button Style="{StaticResource ServerCardButton}" IsEnabled="{Binding IsSelectable}" AutomationProperties.Name="{Binding CountryName}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding SignalText}" Foreground="{Binding SignalColor}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding CountryName}" TextAlignment="Right" TextWrapping="Wrap" FlowDirection="RightToLeft" FontWeight="Medium" VerticalAlignment="Center" Margin="4,0,10,0"/>
    <Grid Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="{Binding CountryCode}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding CountryCode, Converter={StaticResource CountryFlag}}" Height="22" Stretch="Uniform"/></Grid>
    <Grid Grid.Column="3" Width="20" Height="20" VerticalAlignment="Center"><Ellipse Stroke="#8D9DB5" StrokeThickness="1.5"/><Ellipse Margin="4" Fill="#0066FF"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsSelectedCountry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></Grid>
   </Grid>
  </Button>
 </DataTemplate>
 <uc:CountryPickerSelector x:Key="CountryPickerSelector" SmartTemplate="{StaticResource SmartCardTemplate}" GroupTemplate="{StaticResource GroupCardTemplate}"/>
</ResourceDictionary>