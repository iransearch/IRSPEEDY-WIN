<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uc="clr-namespace:IRSpeedyVPN.Components.ServerListControl">

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <uc:BorderClipConverter x:Key="BorderClipConverter"/>

    <!-- ═══ Geometries ═══ -->
    <Geometry x:Key="IconBolt">M13,2 L3,14 L11,14 L9,22 L19,10 L11,10 Z</Geometry>
    <Geometry x:Key="IconStar">M12,2 L14.9,8.6 L22,9.3 L16.6,14 L18.2,21 L12,17.3 L5.8,21 L7.4,14 L2,9.3 L9.1,8.6 Z</Geometry>
    <Geometry x:Key="IconChevronLeft">M8,2 L3,7 L8,12</Geometry>
    <Geometry x:Key="IconChevronDown">M2,4 L7,9 L12,4</Geometry>
    <Geometry x:Key="ComboArrow">M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z</Geometry>
    <Geometry x:Key="SignalBase">M0,12 H3 V17 H0 Z M5,9 H8 V17 H5 Z M10,6 H13 V17 H10 Z M15,3 H18 V17 H15 Z M20,0 H23 V17 H20 Z</Geometry>

    <!-- ═══ Smart card ═══ -->
    <DataTemplate x:Key="SmartCardTemplate">
        <Border Tag="Smart" CornerRadius="12" BorderThickness="1" Margin="0,0,0,6"
                Padding="0,8" Cursor="Hand">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFBEB"/>
                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FEF3C7"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#10B981"/>
                            <Setter Property="Background" Value="#ECFDF5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                        Background="White" VerticalAlignment="Center" Margin="0,0,9,0">
                    <Path Data="{StaticResource IconBolt}" Fill="#F59E0B"
                          Stretch="Uniform" Width="12" Height="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding Display}"
                           FlowDirection="RightToLeft" TextAlignment="Right"
                           FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#92400E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Foreground" Value="#059669"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Url row (MUST stay before GroupCardTemplate) — has its own signal ═══ -->
    <DataTemplate x:Key="ServerRowTemplate">
        <Border Tag="Server" BorderThickness="0,1,0,0" BorderBrush="#F1F5F9"
                Cursor="Hand" Padding="0,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="#ECFDF5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- signal: per-Url colored bars + ms -->
                <StackPanel Grid.Column="0" Orientation="Vertical"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="12,0,8,0">
                    <Grid Width="23" Height="17" HorizontalAlignment="Center">
                        <Path Data="{StaticResource SignalBase}" Fill="#E5E7EB"/>
                        <Path Data="{Binding SignalBars}" Fill="{Binding SignalColor}"/>
                    </Grid>
                    <TextBlock Text="{Binding SignalText}" FontSize="9"
                               Foreground="#6B7280" HorizontalAlignment="Center"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <!-- selected dot (fades in) -->
                <Ellipse Grid.Column="2" Width="7" Height="7" Fill="#10B981"
                         VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="3" Text="{Binding DisplayText}"
                           FlowDirection="RightToLeft" TextAlignment="Right"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#374151"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Foreground" Value="#059669"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Country card — two layers: content (clipped) below, stroke above ═══ -->
    <DataTemplate x:Key="GroupCardTemplate">
        <Grid Margin="0,0,0,6">

            <!-- LAYER 1: background + curved clip + content -->
            <Border CornerRadius="12">
                <Border.Clip>
                    <MultiBinding Converter="{StaticResource BorderClipConverter}">
                        <Binding Path="ActualWidth"  RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
                    </MultiBinding>
                </Border.Clip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedCountry}" Value="True">
                                <Setter Property="Background" Value="#F0FDF4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- header -->
                    <Grid Tag="HeaderBody">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT edge: chevron (the ONLY toggle target) -->
                        <Border Grid.Column="0" Tag="Expander" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#F3F4F6"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#E5E7EB" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#F3F4F6" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconChevronLeft}" Stroke="#6B7280"
                                      StrokeThickness="2" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="{StaticResource IconChevronDown}" Stroke="#6B7280"
                                      StrokeThickness="2" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Border>

                        <!-- header signal: min valid latency of its Urls -->
                        <StackPanel Grid.Column="1" Orientation="Vertical"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="6,9,8,9">
                            <Grid Width="23" Height="17" HorizontalAlignment="Center">
                                <Path Data="{StaticResource SignalBase}" Fill="#E5E7EB"/>
                                <Path Data="{Binding SignalBars}" Fill="{Binding SignalColor}"/>
                            </Grid>
                            <TextBlock Text="{Binding SignalText}" FontSize="9"
                                       Foreground="#6B7280" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- RIGHT edge: name + star -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <Path Data="{StaticResource IconStar}" Fill="#F59E0B"
                                  Stretch="Uniform" Width="13" Height="13"
                                  Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedCountry}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding CountryName}"
                                       FlowDirection="RightToLeft" TextAlignment="Right"
                                       FontWeight="Bold" FontSize="14" Foreground="#111827"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- sub-rows: bound to UrlItems (one per Url) -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="#F1F5F9"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding UrlItems}"
                                      ItemTemplate="{StaticResource ServerRowTemplate}"
                                      Focusable="False"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- LAYER 2: stroke on top so it is never hidden on the left edge / corners -->
            <Border CornerRadius="12" BorderThickness="1"
                    Background="{x:Null}" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedCountry}" Value="True">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ═══ Selector ═══ -->
    <uc:CountryPickerSelector x:Key="CountryPickerSelector"
        SmartTemplate="{StaticResource SmartCardTemplate}"
        GroupTemplate="{StaticResource GroupCardTemplate}"/>

</ResourceDictionary>