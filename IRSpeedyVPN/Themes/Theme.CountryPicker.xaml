<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uc="clr-namespace:IRSpeedyVPN.Components.ServerListControl">

    <Geometry x:Key="IconBolt">M13,2 L3,14 L11,14 L9,22 L19,10 L11,10 Z</Geometry>
    <Geometry x:Key="IconStar">M12,2 L14.9,8.6 L22,9.3 L16.6,14 L18.2,21 L12,17.3 L5.8,21 L7.4,14 L2,9.3 L9.1,8.6 Z</Geometry>
    <Geometry x:Key="ComboArrow">M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z</Geometry>
    <Geometry x:Key="SignalBase">M0,12 H3 V17 H0 Z M5,9 H8 V17 H5 Z M10,6 H13 V17 H10 Z M15,3 H18 V17 H15 Z M20,0 H23 V17 H20 Z</Geometry>

    <!-- Global Smart/Fast selection: all URLs from all eligible countries. -->
    <DataTemplate x:Key="SmartCardTemplate">
        <Border Tag="Smart" CornerRadius="12" BorderThickness="1" Margin="0,0,0,6"
                Padding="0,8" Cursor="Hand">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFBEB"/>
                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FEF3C7"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#10B981"/>
                            <Setter Property="Background" Value="#ECFDF5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                        Background="White" VerticalAlignment="Center" Margin="0,0,9,0">
                    <Path Data="{StaticResource IconBolt}" Fill="#F59E0B"
                          Stretch="Uniform" Width="12" Height="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding Display}"
                           FlowDirection="RightToLeft" TextAlignment="Right"
                           FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#92400E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Foreground" Value="#059669"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        One row per country. There is deliberately no expander and no per-server
        child list. SignalText/SignalBars represent the minimum positive latency
        across every URL in the country. Red/no-positive rows are not selectable.
    -->
    <DataTemplate x:Key="GroupCardTemplate">
        <Border Tag="Country" CornerRadius="12" BorderThickness="1"
                Margin="0,0,0,6" Padding="0,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelectedCountry}" Value="True">
                            <Setter Property="BorderBrush" Value="#10B981"/>
                            <Setter Property="Background" Value="#F0FDF4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter Property="Opacity" Value="0.68"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Minimum positive result across every server in this country. -->
                <StackPanel Grid.Column="0" Orientation="Vertical"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="12,1,8,1">
                    <Grid Width="23" Height="17" HorizontalAlignment="Center">
                        <Path Data="{StaticResource SignalBase}" Fill="#E5E7EB"/>
                        <Path Data="{Binding SignalBars}" Fill="{Binding SignalColor}"/>
                    </Grid>
                    <TextBlock Text="{Binding SignalText}" FontSize="9"
                               Foreground="#6B7280" HorizontalAlignment="Center"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Path Data="{StaticResource IconStar}" Fill="#F59E0B"
                          Stretch="Uniform" Width="13" Height="13"
                          Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedCountry}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding CountryName}"
                               FlowDirection="RightToLeft" TextAlignment="Right"
                               FontWeight="Bold" FontSize="14"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#111827"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <uc:CountryPickerSelector x:Key="CountryPickerSelector"
        SmartTemplate="{StaticResource SmartCardTemplate}"
        GroupTemplate="{StaticResource GroupCardTemplate}"/>

</ResourceDictionary>
