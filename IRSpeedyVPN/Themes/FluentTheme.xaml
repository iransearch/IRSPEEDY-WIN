<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <FontFamily x:Key="Vazir">pack://application:,,,/IRSpeedyVPN;component/Resources/Fonts/#Vazir</FontFamily>
 <FontFamily x:Key="VazirMedium">pack://application:,,,/IRSpeedyVPN;component/Resources/Fonts/#Vazir Medium</FontFamily>
 <FontFamily x:Key="FluentIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
 <SolidColorBrush x:Key="AccentBrush" Color="#0066FF"/>
 <SolidColorBrush x:Key="InkBrush" Color="#122653"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#607599"/>
 <Style x:Key="FluentCard" TargetType="Border">
  <Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="#EFFFFFFF"/>
  <Setter Property="BorderBrush" Value="#D8E7FA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/>
  <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.06" Color="#285AA0"/></Setter.Value></Setter>
 </Style>
 <Style x:Key="FluentButton" TargetType="Button">
  <Setter Property="FontFamily" Value="{StaticResource VazirMedium}"/><Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="FontSize" Value="17"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/>
  <Setter Property="MinHeight" Value="52"/><Setter Property="Padding" Value="18,8"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.88"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.72"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#112A68"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FluentIconButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
  <Setter Property="Width" Value="36"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="6"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/><Setter Property="FontSize" Value="17"/>
 </Style>
 <Style x:Key="FluentInput" TargetType="TextBox">
  <Setter Property="FontFamily" Value="{StaticResource Vazir}"/><Setter Property="FontSize" Value="15"/>
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FluentPassword" TargetType="PasswordBox">
  <Setter Property="FontFamily" Value="{StaticResource Vazir}"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="4,10"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FluentField" TargetType="Border" BasedOn="{StaticResource FluentCard}">
  <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10,2"/><Setter Property="MinHeight" Value="48"/>
  <Setter Property="Effect" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="FluentHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
 <Style x:Key="FluentCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>