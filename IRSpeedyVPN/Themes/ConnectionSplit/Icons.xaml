<!--
  IRSPEEDY — icon set used by ConnectionMethods and SplitTunnel.
  Converted 1:1 from the design SVGs (same coordinates, stroke widths, caps, joins).
  Usage:  <Control Template="{StaticResource Icon.Globe}" Foreground="#1E3A8A" Width="18" Height="18"/>
  Color comes from Foreground, so the same icon can be tinted per item.
  FlowDirection="LeftToRight" on every Viewbox is REQUIRED: the windows are RightToLeft, and WPF
  mirrors Paths inside an RTL tree. Without it, arrows/chevrons/icons would be drawn flipped.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Globe (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Globe" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 4 12 A 8 8 0 1 1 20 12 A 8 8 0 1 1 4 12 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"/>
          <Path Data="M 4 12 h 16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"/>
          <Path Data="M 12 4 c -3 2.6 -3 13.4 0 16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 12 4 c 3 2.6 3 13.4 0 16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Stack (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Stack" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 5.6 4 H 18.4 A 1.6 1.6 0 0 1 20 5.6 V 7.4 A 1.6 1.6 0 0 1 18.4 9 H 5.6 A 1.6 1.6 0 0 1 4 7.4 V 5.6 A 1.6 1.6 0 0 1 5.6 4 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
          <Path Data="M 5.6 10.5 H 18.4 A 1.6 1.6 0 0 1 20 12.1 V 13.9 A 1.6 1.6 0 0 1 18.4 15.5 H 5.6 A 1.6 1.6 0 0 1 4 13.9 V 12.1 A 1.6 1.6 0 0 1 5.6 10.5 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
          <Path Data="M 5.4 17 H 12.6 A 1.4 1.4 0 0 1 14 18.4 V 18.6 A 1.4 1.4 0 0 1 12.6 20 H 5.4 A 1.4 1.4 0 0 1 4 18.6 V 18.4 A 1.4 1.4 0 0 1 5.4 17 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Route (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Route" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 3 7.5 h 5 l 3 4 3 -4 h 5.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          <Path Data="M 17 5.2 l 2.5 2.3 -2.5 2.3" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          <Path Data="M 3 16.5 h 5 l 3 -4 3 4 h 5.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          <Path Data="M 17 18.8 l 2.5 -2.3 -2.5 -2.3" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Split (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Split" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 12 4.5 v 5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 12 9.5 c -4.2 0 -6.3 2.1 -6.3 6.1 v 2.9 M 12 9.5 c 4.2 0 6.3 2.1 6.3 6.1 v 2.9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          <Path Data="M 10.3 3.3 A 1.7 1.7 0 1 1 13.7 3.3 A 1.7 1.7 0 1 1 10.3 3.3 Z" Fill="{TemplateBinding Foreground}"/>
          <Path Data="M 4 19.8 A 1.7 1.7 0 1 1 7.4 19.8 A 1.7 1.7 0 1 1 4 19.8 Z" Fill="{TemplateBinding Foreground}"/>
          <Path Data="M 16.6 19.8 A 1.7 1.7 0 1 1 20 19.8 A 1.7 1.7 0 1 1 16.6 19.8 Z" Fill="{TemplateBinding Foreground}"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Chat (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Chat" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 4 6.5 h 16 a 1.5 1.5 0 0 1 1.5 1.5 v 8 a 1.5 1.5 0 0 1 -1.5 1.5 H 9 l -4 3 v -3 H 4 A 1.5 1.5 0 0 1 2.5 16 V 8 A 1.5 1.5 0 0 1 4 6.5 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Game (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Game" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 7 8 H 17 A 4.5 4.5 0 0 1 21.5 12.5 V 12.5 A 4.5 4.5 0 0 1 17 17 H 7 A 4.5 4.5 0 0 1 2.5 12.5 V 12.5 A 4.5 4.5 0 0 1 7 8 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
          <Path Data="M 7 10.3 v 4.4 M 5 12.5 h 4" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 15 11 A 1 1 0 1 1 17 11 A 1 1 0 1 1 15 11 Z" Fill="{TemplateBinding Foreground}"/>
          <Path Data="M 17.2 13.2 A 1 1 0 1 1 19.2 13.2 A 1 1 0 1 1 17.2 13.2 Z" Fill="{TemplateBinding Foreground}"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Music (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Music" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 9 17.5 a 2.2 2.2 0 1 1 0 -4.4 2.2 2.2 0 0 1 0 4.4 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
          <Path Data="M 11.2 15.3 V 5.8 L 18 4.3 v 9.2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          <Path Data="M 15.8 16.1 a 2.2 2.2 0 1 1 0 -4.4 2.2 2.2 0 0 1 0 4.4 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Mail (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Mail" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 5.2 5.5 H 18.8 A 2.2 2.2 0 0 1 21 7.7 V 16.3 A 2.2 2.2 0 0 1 18.8 18.5 H 5.2 A 2.2 2.2 0 0 1 3 16.3 V 7.7 A 2.2 2.2 0 0 1 5.2 5.5 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
          <Path Data="M 3.5 6.5 l 8.5 6.5 8.5 -6.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Video (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.Video" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 4.7 6.5 H 13.3 A 2.2 2.2 0 0 1 15.5 8.7 V 15.3 A 2.2 2.2 0 0 1 13.3 17.5 H 4.7 A 2.2 2.2 0 0 1 2.5 15.3 V 8.7 A 2.2 2.2 0 0 1 4.7 6.5 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
          <Path Data="M 15.5 10.2 l 6 -3.3 v 10.2 l -6 -3.3" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- File (viewBox 0 0 24 24) -->
  <ControlTemplate x:Key="Icon.File" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="24" Height="24">
          <Path Data="M 6.5 2.8 h 7.2 l 4.8 4.8 v 12 a 1.6 1.6 0 0 1 -1.6 1.6 H 6.5 a 1.6 1.6 0 0 1 -1.6 -1.6 V 4.4 a 1.6 1.6 0 0 1 1.6 -1.6 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
          <Path Data="M 13.5 3 v 4.8 h 4.8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
          <Path Data="M 8.5 13 h 7 M 8.5 16.5 h 4.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Trash (viewBox 0 0 16 16) -->
  <ControlTemplate x:Key="Icon.Trash" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="16" Height="16">
          <Path Data="M 2.5 4.2 h 11 M 6.3 4.2 V 2.8 h 3.4 v 1.4 M 4 4.2 l .7 9 a 1.2 1.2 0 0 0 1.2 1.1 h 4.2 a 1.2 1.2 0 0 0 1.2 -1.1 l .7 -9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Plus (viewBox 0 0 12 12) -->
  <ControlTemplate x:Key="Icon.Plus" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="12" Height="12">
          <Path Data="M 6 1.5 v 9 M 1.5 6 h 9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Search (viewBox 0 0 16 16) -->
  <ControlTemplate x:Key="Icon.Search" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="16" Height="16">
          <Path Data="M 1.75 7 A 5.25 5.25 0 1 1 12.25 7 A 5.25 5.25 0 1 1 1.75 7 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"/>
          <Path Data="M 11 11 L 14.5 14.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- Close (viewBox 0 0 13 13) -->
  <ControlTemplate x:Key="Icon.Close" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="13" Height="13">
          <Path Data="M 1.5 1.5 L 11.5 11.5 M 11.5 1.5 L 1.5 11.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>

  <!-- ChevronBack (viewBox 0 0 14 14) -->
  <ControlTemplate x:Key="Icon.ChevronBack" TargetType="Control">
    <Viewbox Stretch="Uniform" FlowDirection="LeftToRight">
      <Canvas Width="14" Height="14">
          <Path Data="M 9 3.5 L 4.5 7 9 10.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>
</ResourceDictionary>
