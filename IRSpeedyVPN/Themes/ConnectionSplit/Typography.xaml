<!--
  IRSPEEDY — fonts and text styles.

  Vazirmatn static files are embedded from /Fonts (Build Action = Resource).
  Each weight file registers its OWN internal family name, so Medium / SemiBold / ExtraBold
  must be referenced by that name. Only Regular + Bold share the family "Vazirmatn"
  (Bold is reached with FontWeight="Bold").

    400  Regular   -> #Vazirmatn
    500  Medium    -> #Vazirmatn Medium
    600  SemiBold  -> #Vazirmatn SemiBold
    700  Bold      -> #Vazirmatn  + FontWeight="Bold"
    800  ExtraBold -> #Vazirmatn ExtraBold
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="Font.Regular">pack://application:,,,/Fonts/Vazirmatn/#Vazirmatn</FontFamily>
  <FontFamily x:Key="Font.Medium">pack://application:,,,/Fonts/Vazirmatn/#Vazirmatn Medium</FontFamily>
  <FontFamily x:Key="Font.SemiBold">pack://application:,,,/Fonts/Vazirmatn/#Vazirmatn SemiBold</FontFamily>
  <FontFamily x:Key="Font.ExtraBold">pack://application:,,,/Fonts/Vazirmatn/#Vazirmatn ExtraBold</FontFamily>

  <!-- Header: "روش‌های اتصال" / "تقسیم تونل" — 16px, 800 -->
  <Style x:Key="Text.WindowTitle" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.ExtraBold}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="#141B33" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Header subtitle — 10.5px, 500 -->
  <Style x:Key="Text.WindowSubtitle" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="14"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="#9CA3B4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <!-- Connection-method row title — 13.5px, 700 -->
  <Style x:Key="Text.MethodTitle" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="17"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="#1B2033" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Connection-method row subtitle — 10.5px, 400 -->
  <Style x:Key="Text.MethodSubtitle" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="14"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="#9CA3B4" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <!-- "فعال" / "غیرفعال" next to the split-tunnel chevron — 11px, 600 -->
  <Style x:Key="Text.RowStatus" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="14"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Activation row title "فعال‌سازی تقسیم تونل" — 13px, 700 -->
  <Style x:Key="Text.CardTitle" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#1B2033" />
  </Style>

  <!-- Activation row status line — 10.5px, 400, color set by binding -->
  <Style x:Key="Text.CardStatus" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="13"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <!-- App row: name 13px/700, category 10px/400 -->
  <Style x:Key="Text.AppName" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#1B2033" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.AppCategory" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="13"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="#9CA3B4" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- "3 برنامه انتخاب شده" — 11.5px -->
  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="LineHeight" Value="15"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="#6B7280" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
