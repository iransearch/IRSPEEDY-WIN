  <!-- ===================== Typography ===================== -->
  <!-- Load Vazirmatn as a bundled font resource; family name below assumes
       the .ttf/.otf internal font-family name is "Vazirmatn". -->
  <FontFamily x:Key="AppFontFamily">pack://application:,,,/Fonts/Vazirmatn/#Vazirmatn</FontFamily>

