  <!-- ===================== Brushes ===================== -->
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource AccentGradientTopColor}" Offset="0"/>
    <GradientStop Color="{StaticResource AccentGradientBottomColor}" Offset="1"/>
  </LinearGradientBrush>

  <!-- App window background: opaque solid gradient (no Mica/Acrylic — the
       approved design uses a plain, fully opaque card, not a glass/blur
       material). Set Window.Background to this brush directly. -->
  <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource WindowBgTopColor}" Offset="0"/>
    <GradientStop Color="{StaticResource WindowBgBottomColor}" Offset="1"/>
  </LinearGradientBrush>

  <!-- Desktop backdrop behind the floating window, for the mockup/preview
       frame only — not part of the app window itself. -->
  <LinearGradientBrush x:Key="DesktopBackdropBrush" StartPoint="0.2,0" EndPoint="0.8,1">
    <GradientStop Color="{StaticResource DesktopBackdropTopColor}" Offset="0"/>
    <GradientStop Color="{StaticResource DesktopBackdropBottomColor}" Offset="1"/>
  </LinearGradientBrush>

