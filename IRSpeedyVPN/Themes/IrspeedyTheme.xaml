  <sys:Double x:Key="ConnectButtonHeight">56</sys:Double>
  <CornerRadius x:Key="ConnectButtonCornerRadius">14</CornerRadius>
  <!-- Main/server-list screen content bottom padding (Connect button gap
       from window edge) — Connected screen's Disconnect button uses the
       same value so both primary actions sit the same distance from the
       bottom edge. -->
