  <Style x:Key="DesignActionButton" TargetType="Button">
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#1E3A8A" BlurRadius="22" ShadowDepth="10" Direction="270" Opacity="0.5"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="14" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="-1"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Background" Value="#7B849C"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DesignLinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" CornerRadius="9" Padding="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
