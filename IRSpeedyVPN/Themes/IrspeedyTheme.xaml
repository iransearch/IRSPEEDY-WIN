  <sys:Double x:Key="FontSizeCardTitle">14</sys:Double>
  <sys:Double x:Key="FontSizeSettingsTitle">16.5</sys:Double>
  <sys:Double x:Key="FontSizeSettingsRow">15</sys:Double>
  <sys:Double x:Key="FontSizeToggleLabel">11</sys:Double>

