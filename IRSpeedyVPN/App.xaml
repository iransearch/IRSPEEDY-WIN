<Application x:Class="IRSpeedyVPN.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:IRSpeedyVPN">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRSpeedyVPN;component/Themes/DefaultThemeColor.xaml"/>
                <ResourceDictionary Source="/IRSpeedyVPN;component/Themes/DefaultTheme.xaml"/>
                <ResourceDictionary Source="Themes/Theme.Button.xaml"/>
                <ResourceDictionary Source="Themes/Theme.TextBox.xaml"/>
                <ResourceDictionary Source="Themes/Theme.TextBoxButton.xaml"/>
                <ResourceDictionary Source="Themes/Theme.ComboBox.xaml"/>
                <ResourceDictionary Source="Themes/Theme.CountryPicker.xaml"/>
                <ResourceDictionary Source="Themes/Theme.TextBlock.xaml"/>
                <ResourceDictionary Source="Themes/Theme.LabelButton.xaml"/>
                <ResourceDictionary Source="Themes/IrspeedyTheme.xaml"/>
                <ResourceDictionary Source="Themes/ServerListFlags.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="UiScale">0.905</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
