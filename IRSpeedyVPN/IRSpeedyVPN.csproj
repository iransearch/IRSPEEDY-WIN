<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>IRSpeedyVPN</RootNamespace>
    <AssemblyName>IRSpeedyVPN</AssemblyName>
    <ApplicationIcon>Logo-v2.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>IRSpeedyVPN.Program</StartupObject>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppConfig>app.config</AppConfig>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;WPF;_RESELLER1</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE;_RESELLER</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sentry" Version="6.11.0" />
    <PackageReference Include="DotNetZip" Version="1.13.8" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.2" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />

    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />

    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="Transitionals" Version="2023.11.15.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\KerioService.cs;Services\sslProxyService.cs" />
    <Compile Remove="Services\OpenConnectService.cs" />
    <None Remove="Resources\Files.zip" />
    <None Remove="Resources\Font Awesome 5 Brands-Regular-400.otf" />
    <None Include="Services\KerioService.cs;Services\sslProxyService.cs" />
    <None Include="Services\OpenConnectService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\Font Awesome 5 Brands-Regular-400.otf" />
		<Resource Include="Resources\Font Awesome 5 Pro-Light-300.otf" />
		<Resource Include="Resources\BKoodak.ttf" />
		<Resource Include="Resources\BYekanPlus-Bold.ttf" />
		<Resource Include="Resources\Logo-v2.png" />
		<Resource Include="Resources\IRCurve.png" />
		<Resource Include="Resources\Files.zip" />
		<Resource Include="Resources\eye.png" />
		<Resource Include="Resources\eyeSlash.png" />
		<Resource Include="Logo-v2.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- New window design (DESIGN-SPEC handoff): brand assets -->
		<Resource Include="Resources\Irspeedy\Logo\icon-16.png" />
		<Resource Include="Resources\Irspeedy\Icons\*.svg" />
        <Resource Include="Resources\Irspeedy\Reference\proxy-reference.png" />
		<Resource Include="Resources\Irspeedy\Logo\icon-24.png" />
		<Resource Include="Resources\Irspeedy\Logo\icon-32.png" />
		<Resource Include="Resources\Irspeedy\Logo\icon-48.png" />
		<Resource Include="Resources\Irspeedy\Logo\icon-64.png" />
		<Resource Include="Resources\Irspeedy\Logo\icon-128.png" />
		<Resource Include="Resources\Irspeedy\Logo\icon-256.png" />
		<Resource Include="Resources\Irspeedy\Logo\logo-header.png" />
        <Resource Include="Resources\Irspeedy\Logo\RocketLayers\*.png" />
		<Resource Include="Resources\Irspeedy\Logo\irspeedy.ico" />
		<Resource Include="Resources\Irspeedy\Flags\germany.png" />
		<Resource Include="Resources\Irspeedy\Flags\netherlands.png" />
		<Resource Include="Resources\Irspeedy\Flags\turkey.png" />
		<Resource Include="Resources\Irspeedy\Flags\france.png" />
		<Resource Include="Resources\Irspeedy\Flags\uk.png" />
		<Resource Include="Resources\Irspeedy\Flags\usa.png" />
		<Resource Include="Resources\Irspeedy\Flags\canada.png" />
		<Resource Include="Resources\Irspeedy\Flags\uae.png" />
		<Resource Include="Resources\Irspeedy\Flags\singapore.png" />
		<Resource Include="Resources\Irspeedy\Flags\japan.png" />
		<Resource Include="Resources\Irspeedy\Flags\Iso\*.png" />
		<Resource Include="Resources\Irspeedy\Flags\Iso\LICENSE.txt" />
		<!-- Vazirmatn (OFL), bundled locally per DESIGN-SPEC §5 — no network font loading -->
		<Resource Include="Fonts\Vazirmatn\Vazirmatn-Regular.ttf" />
		<Resource Include="Fonts\Vazirmatn\Vazirmatn-Medium.ttf" />
		<Resource Include="Fonts\Vazirmatn\Vazirmatn-SemiBold.ttf" />
		<Resource Include="Fonts\Vazirmatn\Vazirmatn-Bold.ttf" />
		<Resource Include="Fonts\Vazirmatn\Vazirmatn-ExtraBold.ttf" />
	</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Components\ToggleSwitch\Icons\ToggleSwitch.HorizontalToggleSwitch.Expression.Large.png" />
    <EmbeddedResource Include="Components\ToggleSwitch\Icons\ToggleSwitch.HorizontalToggleSwitch.Expression.Small.png" />
    <EmbeddedResource Include="Components\ToggleSwitch\Icons\ToggleSwitch.HorizontalToggleSwitch.VisualStudio.bmp" />
    <EmbeddedResource Include="$(NuGetPackageRoot)transitionals\2023.11.15.1\lib\net48\Transitionals.dll">
      <LogicalName>Transitionals.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Loading.svg" />
  </ItemGroup>

  <PropertyGroup>
    <DotfuscatorExe Condition="'$(DotfuscatorExe)' == '' And Exists('$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\PreEmptive Protection Dotfuscator Professional 6.5.4\dotfuscator.exe')">$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\PreEmptive Protection Dotfuscator Professional 6.5.4\dotfuscator.exe</DotfuscatorExe>
    <DotfuscatorExe Condition="'$(DotfuscatorExe)' == '' And '$(VSInstallDir)' != ''">$(VSInstallDir)Common7\IDE\Extensions\PreEmptiveSolutions\DotfuscatorCE\dotfuscator.exe</DotfuscatorExe>
    <DotfuscatorExe Condition="'$(DotfuscatorExe)' == '' And Exists('$(UserProfile)\AppData\Local\PreEmptiveSolutions\DotfuscatorCE\dotfuscator.exe')">$(UserProfile)\AppData\Local\PreEmptiveSolutions\DotfuscatorCE\dotfuscator.exe</DotfuscatorExe>
    <DotfuscatorExe Condition="'$(DotfuscatorExe)' == ''">C:\Program Files\Microsoft Visual Studio\2022\Professional\Common7\IDE\Extensions\PreEmptiveSolutions\DotfuscatorCE\dotfuscator.exe</DotfuscatorExe>
    <DotfuscatorProject Condition="'$(DotfuscatorProject)' == ''">$(MSBuildThisFileDirectory)..\IRSpeedyVPN.Dotfuscator.xml</DotfuscatorProject>
  </PropertyGroup>

  <!-- Embed opaque helper payloads before compilation and the existing single-file packer. -->
  <Import Project="..\tools\HotspotPayload.targets" />

  <Target Name="RunDotfuscator" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('$(DotfuscatorExe)')">
    <MakeDir Directories="$(TargetDir)Obfuscated" />
    <Delete Files="$(TargetDir)Obfuscated\$(TargetFileName)" ContinueOnError="true" />
    <Exec Command="&quot;$(DotfuscatorExe)&quot; /q &quot;$(DotfuscatorProject)&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="DotfuscatorExitCode" />
    </Exec>
    <Exec Condition="'$(DotfuscatorExitCode)' != '0'" Command="ping -n 4 127.0.0.1 &gt;nul" />
    <Exec Condition="'$(DotfuscatorExitCode)' != '0'" Command="&quot;$(DotfuscatorExe)&quot; /q &quot;$(DotfuscatorProject)&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="DotfuscatorExitCode" />
    </Exec>
    <Warning Condition="'$(DotfuscatorExitCode)' != '0'" Text="Dotfuscator exited with code $(DotfuscatorExitCode); obfuscated output may be missing. Check the Dotfuscator installation, license, and config (IRSpeedyVPN.Dotfuscator.xml)." />
    <Copy SourceFiles="$(TargetDir)$(TargetName).exe.config" DestinationFolder="$(TargetDir)Obfuscated" Condition="'$(DotfuscatorExitCode)' == '0' And Exists('$(TargetDir)$(TargetName).exe.config')" />
  </Target>
</Project>
