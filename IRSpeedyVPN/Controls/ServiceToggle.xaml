<UserControl x:Class="IRSpeedyVPN.Controls.ServiceToggle" x:Name="root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="86" Height="32" FlowDirection="LeftToRight" Focusable="False">
 <Button Click="Toggle_Click" Cursor="Hand" AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=root}">
  <Button.Template><ControlTemplate TargetType="Button">
   <Border x:Name="track" Background="{StaticResource ToggleTrackBrush}" CornerRadius="16" Padding="3">
    <Grid>
     <Border x:Name="segment" Background="{StaticResource ToggleOffBrush}" CornerRadius="13"/>
     <TextBlock x:Name="label" Text="OFF" Foreground="White" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Margin="26,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Border x:Name="thumb" Width="26" Height="26" CornerRadius="13" Background="White" HorizontalAlignment="Left">
      <Path x:Name="glyph" Data="M3.8,1.8 L8,5.5 L3.8,9.2" Stroke="#5B6478" StrokeThickness="1.6" Width="7" Height="11" Stretch="Uniform"/>
     </Border>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <DataTrigger Binding="{Binding IsOn, ElementName=root}" Value="True">
     <Setter TargetName="segment" Property="Background" Value="{StaticResource ToggleOnBrush}"/>
     <Setter TargetName="label" Property="Text" Value="ON"/><Setter TargetName="label" Property="Margin" Value="0,0,26,0"/>
     <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
     <Setter TargetName="glyph" Property="Data" Value="M7.2,1.8 L3,5.5 L7.2,9.2"/>
    </DataTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="track" Property="Opacity" Value="0.5"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="track" Property="BorderThickness" Value="1"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Button.Template>
 </Button>
</UserControl>
