+	if len(options.CertificateSHA256) > 0 {
+		if len(options.CertificatePublicKeySHA256) > 0 || len(options.Certificate) > 0 || options.CertificatePath != "" {
+			return nil, E.New("certificate_sha256 conflicts with other certificate verification options")
