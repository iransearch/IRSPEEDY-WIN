@@ -293,3 +302,17 @@ func VerifyPublicKeySHA256(knownHashValues [][]byte, rawCerts [][]byte) error {
 	}
 	return E.New("unrecognized remote public key: ", base64.StdEncoding.EncodeToString(hashValue[:]))
 }
+
+// VerifyCertificateSHA256 preserves Xray's full DER certificate pins. A public
+// key pin is intentionally a different setting and must not be substituted.
+func VerifyCertificateSHA256(pins [][]byte, rawCerts [][]byte) error {
+	for _, cert := range rawCerts {
+		sum := sha256.Sum256(cert)
+		for _, pin := range pins {
+			if bytes.Equal(sum[:], pin) {
+				return nil
+			}
+		}
+	}
+	return E.New("certificate SHA256 pin mismatch")
+}
