<Project>
  <!-- Native libraries are resources, not distribution sidecars. PkgGrpc_Core
       is emitted by NuGet's GeneratePathProperty for the pinned package. -->
  <PropertyGroup>
    <Grpc_SkipNativeLibsCopy>true</Grpc_SkipNativeLibsCopy>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgGrpc_Core)/runtimes/win-x86/native/grpc_csharp_ext.x86.dll">
      <LogicalName>IRSpeedy.NativeGrpc.x86</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgGrpc_Core)/runtimes/win-x64/native/grpc_csharp_ext.x64.dll">
      <LogicalName>IRSpeedy.NativeGrpc.x64</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="ValidateEmbeddedRoutingGrpc" BeforeTargets="PrepareResources">
    <Error Condition="!Exists('$(PkgGrpc_Core)/runtimes/win-x86/native/grpc_csharp_ext.x86.dll') Or !Exists('$(PkgGrpc_Core)/runtimes/win-x64/native/grpc_csharp_ext.x64.dll')"
           Text="Embedded gRPC resources are missing. Restore Grpc.Core with GeneratePathProperty enabled before building." />
  </Target>
</Project>
