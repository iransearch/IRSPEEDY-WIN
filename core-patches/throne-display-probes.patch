diff --git a/core/server/test_utils/display_probe.go b/core/server/test_utils/display_probe.go
new file mode 100644
index 00000000..c318b700
--- /dev/null
+++ b/core/server/test_utils/display_probe.go
@@ -0,0 +1,83 @@
+package test_utils
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"strings"
+	"time"
+
+	"ThroneCore/internal/boxbox"
+)
+
+// Only the display RPC uses this rule. XHTTP can close its stream after
+// the first response; that response is a real measurement, not a failure.
+func IsDisplayXHTTP(config string) bool {
+	var profile struct {
+		Outbounds []struct {
+			StreamSettings struct{ Network string }
+			Transport      struct{ Type string }
+		}
+	}
+	if json.Unmarshal([]byte(config), &profile) != nil {
+		return false
+	}
+	for _, outbound := range profile.Outbounds {
+		for _, transport := range []string{outbound.StreamSettings.Network, outbound.Transport.Type} {
+			if strings.EqualFold(transport, "xhttp") || strings.EqualFold(transport, "splithttp") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func DisplayURLTest(ctx context.Context, box *boxbox.Box, tag, url string, single bool) (time.Duration, error) {
+	if err := awaitTunnels(ctx, box, tag); err != nil {
+		return 0, err
+	}
+	outbound, found := box.Outbound().Outbound(tag)
+	if !found {
+		return 0, errors.New("display probe outbound is missing")
+	}
+	client, closeClient := outboundHTTPClient(ctx, outbound)
+	defer closeClient()
+	return displayRTT(ctx, client, url, single)
+}
+
+func displayRTT(ctx context.Context, client *http.Client, url string, single bool) (time.Duration, error) {
+	request := func(warmup bool) (time.Duration, net.Conn, error) {
+		var conn net.Conn
+		trace := &httptrace.ClientTrace{GotConn: func(info httptrace.GotConnInfo) { conn = info.Conn }}
+		req, err := http.NewRequestWithContext(httptrace.WithClientTrace(ctx, trace), http.MethodGet, url, nil)
+		if err != nil {
+			return 0, nil, err
+		}
+		begin := time.Now()
+		resp, err := client.Do(req)
+		if err != nil {
+			return 0, nil, err
+		}
+		latency := time.Since(begin)
+		defer resp.Body.Close()
+		if warmup {
+			// Read the first body before reusing the connection. The context
+			// also bounds servers that send a large or nonterminating body.
+			_, err = io.Copy(io.Discard, resp.Body)
+		}
+		return latency, conn, err
+	}
+	first, connection, err := request(!single)
+	if err != nil || single {
+		return first, err
+	}
+	second, nextConnection, err := request(false)
+	if err == nil && (connection == nil || connection != nextConnection) {
+		return 0, errors.New("display probe did not reuse its connection")
+	}
+	return second, err
+}
diff --git a/core/server/test_utils/display_probe_test.go b/core/server/test_utils/display_probe_test.go
new file mode 100644
index 00000000..f82becab
--- /dev/null
+++ b/core/server/test_utils/display_probe_test.go
@@ -0,0 +1,73 @@
+package test_utils
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"strings"
+	"testing"
+	"time"
+)
+
+type probeTransport func(*http.Request) (*http.Response, error)
+
+func (t probeTransport) RoundTrip(req *http.Request) (*http.Response, error) { return t(req) }
+
+func TestDisplayProbesOnlyOneHandshakeForXHTTP(t *testing.T) {
+	for _, tc := range []struct {
+		name, config string
+		wantCalls    int
+		wantErr      bool
+	}{
+		{"xhttp", `{"outbounds":[{"streamSettings":{"network":"xhttp"}}]}`, 1, false},
+		{"split", `{"outbounds":[{"streamSettings":{"network":"SplitHTTP"}}]}`, 1, false},
+		{"sing-box", `{"outbounds":[{"transport":{"type":"xhttp"}}]}`, 1, false},
+		{"ordinary", `{"outbounds":[{"streamSettings":{"network":"ws"}}]}`, 2, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			// This XHTTP-like stream succeeds once and closes on the second read.
+			client := &http.Client{Transport: probeTransport(func(req *http.Request) (*http.Response, error) {
+				calls++
+				if calls > 1 {
+					return nil, io.ErrUnexpectedEOF
+				}
+				return &http.Response{StatusCode: 204, Body: http.NoBody}, nil
+			})}
+			rtt, err := displayRTT(context.Background(), client, "http://fixture.invalid/", IsDisplayXHTTP(tc.config))
+			if calls != tc.wantCalls || (err != nil) != tc.wantErr || (err == nil && rtt <= 0) {
+				t.Fatalf("calls=%d latency=%v err=%v", calls, rtt, err)
+			}
+		})
+	}
+}
+
+func TestDisplayProbeUsesSecondRequestOfSameConnection(t *testing.T) {
+	for _, different := range []bool{false, true} {
+		first, peer := net.Pipe()
+		second, otherPeer := net.Pipe()
+		calls := 0
+		client := &http.Client{Transport: probeTransport(func(req *http.Request) (*http.Response, error) {
+			calls++
+			conn := first
+			if calls == 2 && different {
+				conn = second
+			}
+			httptrace.ContextClientTrace(req.Context()).GotConn(httptrace.GotConnInfo{Conn: conn, Reused: calls == 2 && !different})
+			if calls == 1 {
+				time.Sleep(25 * time.Millisecond)
+			}
+			return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("warm up"))}, nil
+		})}
+		delay, err := displayRTT(context.Background(), client, "http://fixture.invalid/", false)
+		first.Close()
+		peer.Close()
+		second.Close()
+		otherPeer.Close()
+		if calls != 2 || (err != nil) != different || (!different && delay >= 25*time.Millisecond) {
+			t.Fatalf("different=%v calls=%d latency=%v err=%v", different, calls, delay, err)
+		}
+	}
+}
