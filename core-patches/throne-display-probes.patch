diff --git a/core/server/display_probe.go b/core/server/display_probe.go
new file mode 100644
index 00000000..30e77141
--- /dev/null
+++ b/core/server/display_probe.go
@@ -0,0 +1,74 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"ThroneCore/gen"
+	"ThroneCore/internal/boxdns"
+	"ThroneCore/test_utils"
+)
+
+var displaySlots = make(chan struct{}, 8)
+
+// The desktop list runs this on a separate probe Core. Neither currentBox,
+// the legacy TestContext, nor its global progress reporter is involved.
+func (s *protoRPCServer) DisplayTest(in *gen.TestReq, out *gen.TestResp) error {
+	if len(in.OutboundTags) != 1 || in.GetTestCurrent() || in.GetUseDefaultOutbound() ||
+		in.GetTestTimeoutMs() <= 0 || in.GetTestTimeoutMs() > 8000 {
+		return errors.New("invalid display probe request")
+	}
+	tag := in.OutboundTags[0]
+	reply := func(latency int32, failure string) {
+		out.Results = []*gen.URLTestResp{{OutboundTag: To(tag), LatencyMs: To(latency), Error: To(failure)}}
+	}
+	select {
+	case displaySlots <- struct{}{}:
+	default:
+		reply(0, "display-probe-deferred")
+		return nil
+	}
+	var closeEnvironment func()
+	defer func() {
+		if closeEnvironment == nil {
+			<-displaySlots
+			return
+		}
+		// Return the measurement before cleanup, but don't free native
+		// capacity while the Core or sidecar still owns resources.
+		go func() {
+			defer func() { <-displaySlots }()
+			closeEnvironment()
+		}()
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(in.GetTestTimeoutMs())*time.Millisecond)
+	defer cancel()
+	_ = boxdns.Start()
+	if ctx.Err() != nil {
+		reply(-1, "display-probe-timeout")
+		return nil
+	}
+	env, err := prepareTestEnv(false, in.GetNeedXray(), in.GetXrayConfig(), in.XrayFullConfigs,
+		in.GetConfig(), in.OutboundTags, false, in.GetXrayOutboundDnsStrategy(), true)
+	if err != nil {
+		reply(-1, "display-probe-config")
+		return nil
+	}
+	closeEnvironment = env.close
+	if ctx.Err() != nil {
+		reply(-1, "display-probe-timeout")
+		return nil
+	}
+	single := test_utils.IsDisplayXHTTP(in.GetConfig()) || test_utils.IsDisplayXHTTP(in.GetXrayConfig())
+	for _, config := range in.XrayFullConfigs {
+		single = single || test_utils.IsDisplayXHTTP(config)
+	}
+	latency, err := test_utils.DisplayURLTest(ctx, env.box, env.tags[0], in.GetUrl(), single)
+	if err != nil || ctx.Err() != nil {
+		reply(-1, "display-probe-failed")
+	} else {
+		reply(int32(max(1, latency.Milliseconds())), "")
+	}
+	return nil
+}
